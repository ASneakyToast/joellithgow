# MCP bearer-token gate — EXAMPLE.
#
# Copy to /etc/nginx/conf.d/mcp-token.conf on the box, replace the token with a
# long random secret, then `sudo nginx -t && sudo systemctl reload nginx`.
# The real file holds a secret — NEVER commit it. Give the same token to the
# hermes bot and any Claude Code MCP client as: Authorization: Bearer <token>
#
# Generate a token with: openssl rand -hex 32
#
# This defines $mcp_authorized (1 = allowed), consumed by the /mcp locations in
# cms.conf. It lives at http context (conf.d/*.conf loads there).

map $http_authorization $mcp_authorized {
    default                                       0;
    "Bearer REPLACE_WITH_A_LONG_RANDOM_TOKEN"     1;
}
