# Astro frontend — points at whichever CMS you're working against
# Local dev:  http://localhost:8001  +  local-secret
# Staging:    https://cms-staging.joellithgow.com  +  your-staging-api-key
# Prod:       https://cms.joellithgow.com  +  your-prod-api-key
ASTRAEUS_URL=http://localhost:8001
ASTRAEUS_API_KEY=local-secret

# Public CMS base URL — used by the inline editor embed script.
# Must be PUBLIC_ prefix so Astro exposes it to the browser.
# Set to the CMS origin the site is built against.
# Omit (or leave empty) in Netlify preview builds that shouldn't include the editor.
# Netlify prod:    PUBLIC_CMS_BASE=https://cms.joellithgow.com
# Netlify staging: PUBLIC_CMS_BASE=https://cms-staging.joellithgow.com
# Local dev:       PUBLIC_CMS_BASE=http://localhost:8001
PUBLIC_CMS_BASE=http://localhost:8001

# Production CMS API key (used by cms-prod service on EC2)
CMS_API_KEY=your-prod-api-key

# Staging CMS API key (used by cms-staging service on EC2)
CMS_STAGING_API_KEY=your-staging-api-key

# Local CMS API key (used by cms-local in docker-compose.local.yml)
# Default matches the docker-compose.local.yml default — change if you want
CMS_LOCAL_API_KEY=local-secret

# Spotify gateway (used by cms-staging service to sync liked tracks)
# Get credentials at https://developer.spotify.com/dashboard
# Run cms/gateways/get_spotify_token.py once to obtain the refresh token
SPOTIPY_CLIENT_ID=your-spotify-client-id
SPOTIPY_CLIENT_SECRET=your-spotify-client-secret
SPOTIPY_REFRESH_TOKEN=your-spotify-refresh-token

# iNaturalist gateway (used by cms-staging service to sync field trip observations)
# Defaults to joel583 if unset — override to sync a different account
INATURALIST_USERNAME=joel583

# Netlify build hook — powers the manual "Rebuild site" button in the editor toolbar.
# Set this ONLY in prod's env (docker-compose.yml wires it into cms-prod); leave it
# commented for staging/local so those environments can never trigger a prod deploy.
# When set, /api/rebuild POSTs it; when unset, the button is hidden and the route 503s.
# Hook ID: 6a4b394e7cdf3ad99c62063a  (branch: main, site: joellithgow.com)
# NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/6a4b394e7cdf3ad99c62063a
#
# Auto-rebuild-on-publish (a CMS webhook DB record firing on document.published /
# changeset.published) was removed in favour of the manual button. To restore it:
#   curl -X POST https://cms.joellithgow.com/api/webhooks \
#     -H "Authorization: Bearer <CMS_API_KEY>" \
#     -H "Content-Type: application/json" \
#     -d '{"url": "https://api.netlify.com/build_hooks/6a4b394e7cdf3ad99c62063a", \
#          "events": ["document.published", "changeset.published"]}'
# List currently-registered webhooks:  make webhooks

# ── AI Chat (starlette-chat) ─────────────────────────────────────────────────
# The CMS needs to know its own base URL so the chat backend can call back in.
# Local dev matches wherever uvicorn is bound.
CMS_BASE_URL=http://localhost:8000

# Separate SQLite DB for chat sessions + messages (keeps them out of the CMS
# document table and the changeset panel). Defaults to cms/data/chat.db on the
# same Docker volume as content.db. Override if you want a different path.
# Note: chat.db is NOT backed up by make backup / make db-sync — chat history
# is treated as ephemeral. Extend scripts/backup-prod-db.sh if that changes.
# CHAT_DB_URL=sqlite:////app/joellithgow/cms/data/chat.db

# LM Studio (local) — start LM Studio, load a model, enable the local server.
# The model name must match exactly what LM Studio shows in its Model tab.
# Check available models at http://localhost:1234/v1/models while LM Studio is running.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
CHAT_MODEL=local-model

# OpenAI (cloud) — uncomment and set your key to use GPT-4o instead of LM Studio.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4o

# ── Observability (astraeus-otel) ────────────────────────────────────────────
# Console span output — useful for local dev, noisy in prod.
# ASTRAEUS_ENABLE_CONSOLE=true

# OTLP exporter — set to ship traces/logs to Grafana Cloud, Jaeger, Tempo, etc.
# Leave unset for console-only or no-op mode.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
