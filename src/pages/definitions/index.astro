---
import { fetchDefinitions } from '@lib/astraeus';
import type { AstraeusDocument, Definition } from '@lib/astraeus-types';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';

const definitions = await fetchDefinitions();

// Group definitions by first letter
const grouped = definitions.reduce((acc, def) => {
  const letter = def.term.charAt(0).toUpperCase();
  if (!acc.has(letter)) acc.set(letter, []);
  acc.get(letter)!.push(def);
  return acc;
}, new Map<string, AstraeusDocument<Definition>[]>());

// Sort letters
const sortedLetters = Array.from(grouped.keys()).sort();

const totalDefinitions = definitions.length;
const totalLinkSources = definitions.reduce(
  (sum, d) => sum + (d.sources ?? []).filter((s) => s.type === 'link').length,
  0
);
const totalTags = new Set(definitions.flatMap((d) => d.tags ?? [])).size;

const pageTitle = "Glossary";
const pageDescription = `A collection of ${totalDefinitions} definitions — terms, concepts, and ideas that matter, with sources and personal notes.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="glossary-container animated-bg bg-accent-editorial">
    <div class="glossary-wrapper">
      <div class="main-content">
        {/* Back navigation */}
        <nav class="breadcrumb-nav">
          <Button href="/blog" variant="ghost" size="sm">← Back to Blog</Button>
        </nav>

        {/* Glossary header */}
        <header class="glossary-header">
          <h1 class="glossary-title">Glossary</h1>
          <p class="glossary-description">{pageDescription}</p>

          {/* Stats */}
          <div class="glossary-stats">
            <Card variant="outlined" class="stat-card">
              <span class="stat-number">{totalDefinitions}</span>
              <span class="stat-label">definitions</span>
            </Card>
            <Card variant="outlined" class="stat-card">
              <span class="stat-number">{totalLinkSources}</span>
              <span class="stat-label">linked sources</span>
            </Card>
            <Card variant="outlined" class="stat-card">
              <span class="stat-number">{totalTags}</span>
              <span class="stat-label">tags</span>
            </Card>
          </div>
        </header>

        {/* A-Z letter jump */}
        <nav class="letter-nav" aria-label="Jump to letter">
          {sortedLetters.map((letter) => (
            <a href={`#letter-${letter}`} class="letter-jump">{letter}</a>
          ))}
        </nav>

        {/* Definitions by letter */}
        {sortedLetters.map((letter) => (
          <section class="letter-section" id={`letter-${letter}`}>
            <h2 class="letter-heading">{letter}</h2>
            <div class="letter-definitions">
              {grouped.get(letter)!.map((def) => (
                <Card variant="flat" class="definition-card">
                  <a href={`/definitions/${def.slug}/`} class="definition-link">
                    <h3 class="definition-term">{def.term}</h3>
                    <p class="definition-preview">
                      {def.definition.slice(0, 200)}
                      {def.definition.length > 200 ? '...' : ''}
                    </p>
                    <div class="definition-card-meta">
                      {def.sources && def.sources.length > 0 && (
                        <span class="meta-item">
                          {def.sources.length} source{def.sources.length > 1 ? 's' : ''}
                        </span>
                      )}
                      {def.tags && def.tags.length > 0 && (
                        <div class="card-tags">
                          {def.tags.slice(0, 3).map((tag) => (
                            <Badge variant="secondary" size="sm">#{tag}</Badge>
                          ))}
                          {def.tags.length > 3 && (
                            <span class="more-tags">+{def.tags.length - 3}</span>
                          )}
                        </div>
                      )}
                    </div>
                  </a>
                </Card>
              ))}
            </div>
          </section>
        ))}
      </div>

      {/* Sidebar */}
      <aside class="sidebar">
        <Card variant="flat" class="sidebar-card">
          <h3 class="sidebar-heading">About</h3>
          <p class="sidebar-text">
            A growing collection of terms, concepts, and ideas — each with a definition,
            my personal thoughts, and linked sources. Think of it as a living glossary
            of things worth understanding.
          </p>
        </Card>
      </aside>
    </div>
  </main>

  <ThemeModal />
  <UIInteractions />
  <KeyboardShortcuts />
  <PerformanceOptimizer />

  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';
  @import '../../styles/backgrounds.css';

  .glossary-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-3xl) var(--page-gutter);
    position: relative;
    overflow: hidden;
  }

  .glossary-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-3xl);
    align-items: start;
  }

  .main-content {
    min-width: 0;
  }

  .sidebar {
    position: sticky;
    top: var(--space-3xl);
  }

  .breadcrumb-nav {
    margin-bottom: var(--space-xl);
  }

  .glossary-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .glossary-title {
    font-size: var(--heading-xl);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-md) 0;
    color: var(--text-primary);
    letter-spacing: var(--tracking-tight);
  }

  .glossary-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0 0 var(--space-xl) 0;
    line-height: var(--leading-relaxed);
  }

  .glossary-stats {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .stat-card {
    flex: 1;
    min-width: 120px;
    text-align: center;
    padding: var(--space-lg);
  }

  .stat-number {
    display: block;
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin-bottom: var(--space-xs);
  }

  .stat-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-transform: uppercase;
    font-weight: var(--font-medium);
    letter-spacing: var(--tracking-wide);
  }

  .letter-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-2xl);
    padding: var(--space-md);
    background: var(--bg-secondary);
    border-radius: var(--border-radius);
  }

  .letter-jump {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: all var(--duration-base) var(--ease-out);
  }

  .letter-jump:hover {
    background: var(--accent-primary);
    color: var(--text-light);
  }

  .letter-section {
    margin-bottom: var(--space-3xl);
    scroll-margin-top: var(--space-3xl);
  }

  .letter-heading {
    font-size: var(--heading-md);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin: 0 0 var(--space-lg) 0;
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--accent-primary);
  }

  .letter-definitions {
    display: grid;
    gap: var(--space-lg);
  }

  .definition-card {
    padding: var(--space-lg);
    transition: all var(--duration-base) var(--ease-out);
  }

  .definition-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md) var(--accent-secondary);
  }

  .definition-link {
    text-decoration: none;
    color: inherit;
  }

  .definition-term {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-sm) 0;
  }

  .definition-preview {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-md) 0;
  }

  .definition-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .meta-item {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-weight: var(--font-medium);
  }

  .card-tags {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    align-items: center;
  }

  .more-tags {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    font-weight: var(--font-medium);
  }

  .sidebar-card {
    padding: var(--space-lg);
  }

  .sidebar-heading {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
    margin: 0 0 var(--space-md) 0;
  }

  .sidebar-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  @media (max-width: 1024px) {
    .glossary-wrapper {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .sidebar {
      position: relative;
      top: 0;
    }
  }

  @media (max-width: 768px) {
    .glossary-container {
      padding: var(--space-xl) var(--page-gutter);
    }

    .glossary-title {
      font-size: var(--heading-lg);
    }

    .glossary-stats {
      gap: var(--space-md);
    }

    .stat-card {
      min-width: 100px;
      padding: var(--space-md);
    }

    .stat-number {
      font-size: var(--text-2xl);
    }

    .letter-nav {
      gap: 2px;
      padding: var(--space-sm);
    }

    .letter-jump {
      width: 28px;
      height: 28px;
      font-size: var(--text-xs);
    }

    .theme-toggle-button {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 480px) {
    .glossary-container {
      padding: var(--space-lg) var(--space-md);
    }
  }
</style>