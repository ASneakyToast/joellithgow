---
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import PageTitle from '@components/ui/PageTitle.astro';
import ArtworkGallery from '@components/sections/ArtworkGallery.astro';
import { getAllArtworks } from '@features/artworks';

// Get all artworks (placeholder + API data)
const allArtworks = await getAllArtworks();

// Group artworks by project
const projectGroups = allArtworks.reduce((groups, artwork) => {
  const project = artwork.projectTitle;
  if (!groups[project]) {
    groups[project] = [];
  }
  groups[project].push(artwork);
  return groups;
}, {} as Record<string, typeof allArtworks>);

// Calculate category counts for tag cloud
const categoryCounts = new Map<string, number>();
allArtworks.forEach(artwork => {
  if (artwork.category) {
    categoryCounts.set(artwork.category, (categoryCounts.get(artwork.category) || 0) + 1);
  }
});

const topCategories = Array.from(categoryCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5);

const pageTitle = 'Joel Lithgow > Artworks';
const pageDescription = 'Fine art portfolio featuring printmedia, sculpture, exhibitions, and collaborative works exploring the intersection of digital and analog processes.';
const pageSubtitle = 'Material exploration and printmedia experiments';

// JSON-LD structured data for CollectionPage
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: 'https://joellithgow.com/artworks',
  author: {
    '@type': 'Person',
    name: 'Joel Lithgow',
    url: 'https://joellithgow.com',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://joellithgow.com',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Artworks',
        item: 'https://joellithgow.com/artworks',
      },
    ],
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="artworks-container">
    <div class="artworks-wrapper">
      {/* Main Content Column */}
      <div class="main-content">
        {/* Header Section */}
        <section id="artworks" class="artworks-header-section">
          <header class="artworks-header">
            <PageTitle title="Artworks" subtitle={pageSubtitle} />

            {/* Category tag cloud */}
            {topCategories.length > 0 && (
              <div class="tag-cloud">
                <span class="tag-cloud-label">Categories</span>
                {topCategories.map(([category, count]) => (
                  <span class="tag-cloud-item">
                    {category} <span class="tag-count">{count}</span>
                  </span>
                ))}
              </div>
            )}
          </header>
        </section>

        {/* Gallery Overview */}
        <ArtworkGallery artworks={allArtworks} />

        {/* Artworks by Project */}
        {Object.entries(projectGroups).map(([projectTitle, projectArtworks]) => (
          <section class="project-section">
            <div class="project-header">
              <h2 class="section-heading">{projectTitle}</h2>
              <p class="project-description">{projectArtworks[0].projectDescription}</p>
            </div>

            <div class="artworks-grid">
              {projectArtworks.map((artwork, index) => (
                <Card
                  variant="flat"
                  padding="none"
                  as="article"
                  class="artwork-card animate-on-scroll"
                  style={`animation-delay: ${index * 100}ms`}
                >
                  <div class="artwork-image">
                    {artwork.images && artwork.images.length > 0 ? (
                      <picture>
                        <source
                          srcset={artwork.images[0].srcLarge}
                          media="(min-width: 1200px)"
                        />
                        <img
                          src={artwork.images[0].srcThumbnail || artwork.images[0].src}
                          alt={artwork.images[0].alt}
                          width={artwork.images[0].width || 400}
                          height={artwork.images[0].height || 400}
                          loading="lazy"
                        />
                      </picture>
                    ) : (
                      <div class="no-image-placeholder">No image available</div>
                    )}
                    {artwork.featured && (
                      <Badge variant="tertiary" size="sm" class="featured-badge">Featured</Badge>
                    )}
                  </div>

                  <div class="artwork-info">
                    <time class="artwork-date">
                      {new Date(artwork.creationDate).getFullYear()}
                    </time>

                    <h3 class="artwork-title">{artwork.title}</h3>

                    <div class="artwork-meta">
                      <Badge variant="ghost" size="sm">{artwork.medium}</Badge>
                      {artwork.dimensions && (
                        <Badge variant="ghost" size="sm">{artwork.dimensions}</Badge>
                      )}
                    </div>

                    <p class="artwork-description">{artwork.description}</p>

                    {artwork.collaborators && artwork.collaborators.length > 0 && (
                      <p class="artwork-collaborators">
                        With: {artwork.collaborators.join(', ')}
                      </p>
                    )}

                    <div class="artwork-footer">
                      <Button href={`/artworks/${artwork.id}`} variant="primary" size="md">
                        View Details
                      </Button>
                    </div>
                  </div>
                </Card>
              ))}
            </div>
          </section>
        ))}

        {/* Empty state if no artworks */}
        {allArtworks.length === 0 && (
          <Card class="empty-state">
            <div class="empty-message">
              <Badge>coming soon</Badge>
              <p>No artworks published yet. Check back soon!</p>
            </div>
          </Card>
        )}
      </div>
    </div>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../styles/tokens.css';
  @import '../styles/themes.css';
  @import '../styles/backgrounds.css';

  /* Main container styling — transparent so the site-wide grid shows through */
  .artworks-container {
    min-height: 100vh;
    color: var(--text-primary);
    padding: var(--space-3xl) var(--page-gutter);
    position: relative;
    overflow: hidden;
  }

  .artworks-wrapper {
    max-width: var(--content-full);
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  .main-content {
    min-width: 0;
  }

  /* Header Section */
  .artworks-header-section {
    position: relative;
    margin: var(--space-2xl) 0;
  }

  .artworks-header {
    text-align: left;
    padding-bottom: var(--space-xl);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  /* Tag Cloud Styles */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .tag-cloud-label {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    font-weight: var(--font-medium);
    margin-right: var(--space-xs);
  }

  .tag-cloud-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: var(--space-sm) var(--space-md);
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--radius-full);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    box-shadow: var(--shadow-sm) var(--accent-secondary);
  }

  .tag-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 var(--space-xs);
    background: var(--gradient-primary-light);
    color: var(--text-primary);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border: var(--border-width) solid var(--accent-secondary);
  }

  /* Project Section Styles */
  .project-section {
    position: relative;
    margin: var(--space-3xl) 0;
  }

  .project-header {
    margin-bottom: var(--space-2xl);
  }

  .section-heading {
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-md) 0;
    letter-spacing: var(--tracking-tight);
  }

  .project-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: var(--content-normal);
    margin: 0;
  }

  /* Artworks Grid */
  .artworks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--space-2xl);
  }

  /* Artwork Card Styles */
  .artwork-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--border-width) solid var(--gradient-primary-subtle);
    border-radius: var(--radius-lg);
    transition: all var(--duration-base) var(--ease-out);
  }

  .artwork-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
    border-color: var(--accent-primary);
  }

  .artwork-image {
    position: relative;
    width: 100%;
    height: 280px;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .artwork-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .artwork-card:hover .artwork-image img {
    transform: scale(1.05);
  }

  .featured-badge {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
  }

  .artwork-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-xl);
  }

  .artwork-date {
    display: block;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: var(--tracking-wide);
  }

  .artwork-title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    margin: 0;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }

  .artwork-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: var(--space-xs) 0;
  }

  .artwork-description {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: var(--space-sm) 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .artwork-collaborators {
    font-size: var(--text-sm);
    color: var(--accent-primary);
    font-weight: var(--font-medium);
    margin: 0;
  }

  .artwork-footer {
    margin-top: auto;
    padding-top: var(--space-md);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .no-image-placeholder {
    width: 100%;
    height: 100%;
    background: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    font-style: italic;
    border: var(--border-width) dashed var(--gradient-primary-subtle);
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: var(--space-4xl) var(--space-xl);
    margin-top: var(--space-xl);
  }

  .empty-message :global(.badge) {
    margin-bottom: var(--space-md);
  }

  .empty-message p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  /* Theme toggle button */
  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .artworks-container {
      padding: var(--space-xl) var(--page-gutter);
    }

    .artworks-header {
      padding-bottom: var(--space-lg);
    }

    .tag-cloud {
      gap: var(--space-sm);
    }

    .tag-cloud-item {
      font-size: var(--text-sm);
      padding: var(--space-xs) var(--space-sm);
    }

    .tag-cloud-label {
      font-size: var(--text-base);
    }

    .artworks-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .artwork-info {
      padding: var(--space-lg);
    }

    .section-heading {
      font-size: var(--heading-md);
    }

    .theme-toggle-button {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 480px) {
    .artworks-container {
      padding: var(--space-lg) var(--space-md);
    }

    .artwork-title {
      font-size: var(--text-lg);
    }

    .artwork-info {
      padding: var(--space-md);
    }
  }
</style>
