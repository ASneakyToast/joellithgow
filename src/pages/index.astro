---
import BaseLayout from '@components/common/BaseLayout.astro';

const pageTitle = 'Joel Lithgow - Creative Technologist';
const pageDescription = 'Creative technologist who builds things and writes about them. View my professional work or read my writing.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="landing-page">
    <div class="landing-content">
      <header class="landing-header">
        <h1 class="name">Joel Lithgow</h1>
        <p class="title">Creative Technologist</p>
        <p class="tagline">I build things and write about them</p>
      </header>

      <nav class="landing-nav" aria-label="Main sections">
        <a href="/work" class="nav-card work-card">
          <span class="card-icon" aria-hidden="true">💼</span>
          <span class="card-title">Work</span>
          <span class="card-description">Portfolio & Projects</span>
          <span class="card-arrow" aria-hidden="true">→</span>
        </a>

        <a href="/blog" class="nav-card writing-card">
          <span class="card-icon" aria-hidden="true">✍️</span>
          <span class="card-title">Writing</span>
          <span class="card-description">Blog & Dev Journals</span>
          <span class="card-arrow" aria-hidden="true">→</span>
        </a>
      </nav>

      <footer class="landing-footer">
        <a href="https://linkedin.com/in/joellithgow" target="_blank" rel="noopener noreferrer" class="social-link">
          LinkedIn
        </a>
        <span class="separator">·</span>
        <a href="https://github.com/joellithgow" target="_blank" rel="noopener noreferrer" class="social-link">
          GitHub
        </a>
      </footer>
    </div>

    <!-- Theme toggle (minimal, bottom corner) -->
    <button
      id="landingThemeControl"
      class="theme-toggle-minimal"
      onclick="window.openThemeModal && window.openThemeModal()"
      aria-label="Change theme"
      title="Change theme (Ctrl+T)"
    >
      <span aria-hidden="true">🎨</span>
    </button>
  </main>
</BaseLayout>

<style>
  @import '../styles/themes.css';

  .landing-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: 2rem;
    position: relative;
  }

  .landing-content {
    max-width: 600px;
    width: 100%;
    text-align: center;
    animation: fadeIn 0.6s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .landing-header {
    margin-bottom: 3rem;
  }

  .name {
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .title {
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 500;
    margin: 0 0 1rem 0;
    color: var(--text-secondary);
  }

  .tagline {
    font-size: clamp(1rem, 3vw, 1.25rem);
    margin: 0;
    color: var(--text-secondary);
    font-weight: 400;
  }

  .landing-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 3rem 2rem;
    background: var(--bg-secondary);
    border: 2px solid var(--gradient-primary-subtle);
    border-radius: 12px;
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .nav-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, var(--gradient-primary-subtle) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .nav-card:hover::before {
    opacity: 1;
  }

  .nav-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px var(--gradient-primary-dim);
  }

  .work-card:hover {
    border-color: var(--accent-primary);
  }

  .writing-card:hover {
    border-color: var(--accent-secondary);
  }

  .card-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
    position: relative;
    z-index: 1;
  }

  .card-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    position: relative;
    z-index: 1;
  }

  .card-description {
    font-size: 1rem;
    color: var(--text-secondary);
    position: relative;
    z-index: 1;
  }

  .card-arrow {
    font-size: 1.5rem;
    margin-top: 0.5rem;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
    position: relative;
    z-index: 1;
  }

  .nav-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .landing-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-size: 1rem;
  }

  .social-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
    font-weight: 500;
  }

  .social-link:hover {
    color: var(--accent-primary);
  }

  .separator {
    color: var(--text-secondary);
  }

  .theme-toggle-minimal {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--bg-secondary);
    border: 2px solid var(--gradient-primary-subtle);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    transition: all 0.3s ease;
    z-index: 100;
  }

  .theme-toggle-minimal:hover {
    border-color: var(--accent-primary);
    transform: scale(1.1);
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .landing-page {
      padding: 1.5rem;
    }

    .landing-header {
      margin-bottom: 2rem;
    }

    .landing-nav {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .nav-card {
      padding: 2rem 1.5rem;
    }

    .theme-toggle-minimal {
      bottom: 1.5rem;
      right: 1.5rem;
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 480px) {
    .landing-page {
      padding: 1rem;
    }

    .nav-card {
      padding: 1.75rem 1.25rem;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .landing-content {
      animation: none;
    }

    .nav-card,
    .card-arrow,
    .theme-toggle-minimal {
      transition: none;
    }

    .nav-card:hover {
      transform: none;
    }
  }
</style>

<script>
  // Keyboard shortcut for theme toggle
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 't') {
      e.preventDefault();
      const themeControl = document.getElementById('landingThemeControl');
      if (themeControl) {
        themeControl.click();
      }
    }
  });
</script>
