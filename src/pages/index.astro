---
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import Card from '@components/primitives/Card.astro';
import Button from '@components/primitives/Button.astro';
import Badge from '@components/primitives/Badge.astro';

const pageTitle = 'Joel Lithgow - Creative Technologist';
const pageDescription = 'Creative technologist who builds things and writes about them. View my professional work or read my writing.';
---

<BaseLayout title={pageTitle} description={pageDescription} showGlobalHeader={false}>
  <main class="landing-page animated-bg bg-accent-network">
    <div class="landing-content">
      <div class="landing-grid">
        <!-- Left Column: Name + Social Links -->
        <div class="landing-left">
          <header class="landing-header">
            <h1 class="name">Joel Lithgow</h1>
          </header>

          <footer class="landing-footer">
            <a href="https://linkedin.com/in/joellithgow" target="_blank" rel="noopener noreferrer" class="social-link">
              LinkedIn
            </a>
            <span class="separator">·</span>
            <a href="https://github.com/joellithgow" target="_blank" rel="noopener noreferrer" class="social-link">
              GitHub
            </a>
          </footer>
        </div>

        <!-- Right Column: Navigation Cards -->
        <nav class="landing-nav" aria-label="Main sections">
          <Card variant="alternating" href="/work" class="nav-card">
            <span class="card-title">Portfolio</span>
            <span class="card-description">What I do as a creative technologist</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </Card>

          <Card variant="alternating" href="/blog" class="nav-card">
            <span class="card-title">Blog</span>
            <span class="card-description">I guess this is my social media</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </Card>

          <Card variant="alternating" href="/artworks" class="nav-card">
            <span class="card-title">Artwork</span>
            <span class="card-description">Things I make for myself</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </Card>

          <Card variant="alternating" href="https://thisisahousegallery.com" class="nav-card">
            <span class="card-title">This is a House Gallery</span>
            <span class="card-description">This is also my house lol</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </Card>

          <Card variant="alternating" href="https://divebarnranch.com" class="nav-card">
            <span class="card-title">Dive Barn</span>
            <span class="card-description">An arts and music event I ran</span>
            <span class="card-arrow" aria-hidden="true">→</span>
          </Card>
        </nav>
      </div>
    </div>

    <!-- Theme toggle (minimal, bottom corner) -->
    <Button
      variant="ghost"
      size="md"
      id="landingThemeControl"
      class="theme-toggle-minimal"
      onclick="window.openThemeModal && window.openThemeModal()"
      aria-label="Change theme"
      title="Change theme (Ctrl+T)"
    >
      🎨
    </Button>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />
</BaseLayout>

<style>
  @import '../styles/tokens.css';
  @import '../styles/themes.css';
  @import '../styles/backgrounds.css';

  .landing-page {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-3xl) var(--page-gutter);
    position: relative;
    overflow: hidden; /* Required for animated backgrounds */
  }

  .landing-content {
    max-width: var(--content-normal);
    margin: 0 auto;
    width: 100%;
    padding-top: var(--space-4xl);
    position: relative;
    z-index: 10; /* Above animated backgrounds */
  }

  .landing-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
  }

  .landing-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    width: 100%;
  }

  .landing-header {
    margin-bottom: 0;
    width: 100%;
    text-align: center;
  }

  .name {
    font-size: clamp(40px, 8vw, 100px);
    font-weight: var(--font-bold);
    line-height: 1;
    margin: 0;
    color: var(--text-primary);
    text-shadow: var(--text-shadow) var(--accent-secondary);
    transform: var(--rotation-lg);
    display: inline-block;
  }

  .landing-nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  /* Custom nav card styling - brutalist design */
  .nav-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-2xl) var(--space-xl);
    position: relative;
    transform: var(--rotation-sm);
    transition: all var(--duration-base) var(--ease-out);
  }

  .nav-card:nth-child(even) {
    transform: rotate(1deg);
  }

  .nav-card:hover {
    transform: scale(1.02);
    z-index: 5;
  }

  /* First 3 cards (primary) get more padding */
  .nav-card:nth-child(1),
  .nav-card:nth-child(2),
  .nav-card:nth-child(3) {
    padding: var(--space-3xl) var(--space-2xl);
  }

  .card-title {
    display: block;
    font-size: clamp(32px, 6vw, 60px);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-sm);
  }

  /* First 3 cards get huge titles like the main heading */
  .nav-card:nth-child(1) .card-title,
  .nav-card:nth-child(2) .card-title,
  .nav-card:nth-child(3) .card-title {
    font-size: clamp(40px, 8vw, 100px);
  }

  .card-description {
    display: block;
    font-size: clamp(1.125rem, 3vw, 1.875rem);
    font-weight: var(--font-semibold);
    line-height: var(--leading-relaxed);
  }

  .card-arrow {
    position: absolute;
    right: var(--space-2xl);
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--text-3xl);
    opacity: 0.7;
    transition: all var(--duration-base) var(--ease-out);
  }

  .nav-card:hover .card-arrow {
    opacity: 1;
    transform: translateY(-50%) translateX(8px);
  }

  .landing-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    font-size: var(--text-base);
  }

  .social-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
    font-weight: var(--font-medium);
  }

  .social-link:hover {
    color: var(--accent-primary);
  }

  .separator {
    color: var(--text-secondary);
  }

  .theme-toggle-minimal {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
    border: var(--border-width) solid var(--accent-primary);
    box-shadow: var(--shadow-md) var(--accent-secondary);
    transition: all var(--duration-base) var(--ease-out);
  }

  .theme-toggle-minimal:hover {
    box-shadow: var(--shadow-lg) var(--accent-primary);
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .landing-page {
      padding: var(--space-xl) var(--page-gutter);
    }

    .landing-content {
      padding-top: var(--space-2xl);
    }

    .name {
      font-size: clamp(36px, 8vw, 80px);
    }

    .landing-nav {
      gap: var(--space-lg);
    }

    .nav-card {
      padding: var(--space-xl) var(--space-lg);
    }

    .nav-card:nth-child(1),
    .nav-card:nth-child(2),
    .nav-card:nth-child(3) {
      padding: var(--space-2xl) var(--space-xl);
    }

    .nav-card:nth-child(even) {
      transform: rotate(1deg);
    }

    .theme-toggle-minimal {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 480px) {
    .landing-page {
      padding: var(--space-lg) var(--space-md);
    }

    .landing-content {
      padding-top: var(--space-xl);
    }

    .nav-card {
      padding: var(--space-lg) var(--space-md);
    }

    .nav-card:nth-child(1),
    .nav-card:nth-child(2),
    .nav-card:nth-child(3) {
      padding: var(--space-xl) var(--space-lg);
    }

    .card-title {
      font-size: clamp(28px, 6vw, 48px);
    }

    .nav-card:nth-child(1) .card-title,
    .nav-card:nth-child(2) .card-title,
    .nav-card:nth-child(3) .card-title {
      font-size: clamp(36px, 8vw, 80px);
    }

    .card-arrow {
      right: var(--space-lg);
      font-size: var(--text-2xl);
    }
  }

  /* Desktop layout - Two columns */
  @media (min-width: 1024px) {
    .landing-page {
      height: 100vh;
      overflow: hidden;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .landing-content {
      max-width: none;
      padding: var(--space-3xl) 0 var(--space-3xl) var(--page-gutter);
      height: 100vh;
      width: 100%;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .landing-grid {
      display: grid;
      grid-template-columns: 35% 1fr;
      gap: var(--space-4xl);
      align-items: stretch;
      flex: 1;
      min-height: 0;
    }

    .landing-left {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
      overflow: hidden;
      justify-content: center;
    }

    .landing-header {
      margin-bottom: 0;
      text-align: left;
    }

    .landing-footer {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
      margin-top: 0;
    }

    .social-link {
      font-size: var(--text-lg);
    }

    .separator {
      display: none;
    }

    .landing-nav {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xl);
      overflow-y: auto;
      padding: var(--space-3xl) var(--space-2xl);
      min-height: 0;
    }

    /* Custom scrollbar styling for brutalist aesthetic */
    .landing-nav::-webkit-scrollbar {
      width: 8px;
    }

    .landing-nav::-webkit-scrollbar-track {
      background: transparent;
    }

    .landing-nav::-webkit-scrollbar-thumb {
      background: var(--accent-primary);
      border-radius: var(--radius-sm);
    }

    .landing-nav::-webkit-scrollbar-thumb:hover {
      background: var(--accent-secondary);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .name,
    .nav-card,
    .card-arrow {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  // Keyboard shortcut for theme toggle
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 't') {
      e.preventDefault();
      const themeControl = document.getElementById('landingThemeControl');
      if (themeControl) {
        themeControl.click();
      }
    }
  });
</script>
