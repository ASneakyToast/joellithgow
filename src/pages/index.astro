---
import BaseLayout from '@components/common/BaseLayout.astro';
import Card from '@components/primitives/Card.astro';
import Button from '@components/primitives/Button.astro';

const pageTitle = 'Joel Lithgow - Creative Technologist';
const pageDescription = 'Creative technologist who builds things and writes about them. View my professional work or read my writing.';
---

<BaseLayout title={pageTitle} description={pageDescription} showGlobalHeader={false}>
  <main class="landing-page">
    <div class="landing-content">
      <header class="landing-header">
        <h1 class="name">Joel Lithgow</h1>
        <p class="title">Creative Technologist</p>
        <p class="tagline">I build things and write about them</p>
      </header>

      <nav class="landing-nav" aria-label="Main sections">
        <Card variant="interactive" interactive href="/work" class="nav-card">
          <span class="card-icon" aria-hidden="true">💼</span>
          <span class="card-title">Work</span>
          <span class="card-description">Portfolio & Projects</span>
          <span class="card-arrow" aria-hidden="true">→</span>
        </Card>

        <Card variant="interactive" interactive href="/blog" class="nav-card">
          <span class="card-icon" aria-hidden="true">✍️</span>
          <span class="card-title">Writing</span>
          <span class="card-description">Blog & Dev Journals</span>
          <span class="card-arrow" aria-hidden="true">→</span>
        </Card>
      </nav>

      <footer class="landing-footer">
        <a href="https://linkedin.com/in/joellithgow" target="_blank" rel="noopener noreferrer" class="social-link">
          LinkedIn
        </a>
        <span class="separator">·</span>
        <a href="https://github.com/joellithgow" target="_blank" rel="noopener noreferrer" class="social-link">
          GitHub
        </a>
      </footer>
    </div>

    <!-- Theme toggle (minimal, bottom corner) -->
    <Button
      variant="ghost"
      size="md"
      id="landingThemeControl"
      class="theme-toggle-minimal"
      onclick="window.openThemeModal && window.openThemeModal()"
      aria-label="Change theme"
      title="Change theme (Ctrl+T)"
    >
      🎨
    </Button>
  </main>
</BaseLayout>

<style>
  @import '../styles/tokens.css';
  @import '../styles/themes.css';

  .landing-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-xl);
    position: relative;
  }

  .landing-content {
    max-width: var(--content-normal);
    width: 100%;
    text-align: center;
    animation: fadeIn 0.6s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .landing-header {
    margin-bottom: var(--space-3xl);
  }

  .name {
    font-size: var(--heading-2xl);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-sm) 0;
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }

  .title {
    font-size: var(--heading-md);
    font-weight: var(--font-medium);
    margin: 0 0 var(--space-md) 0;
    color: var(--text-secondary);
  }

  .tagline {
    font-size: var(--heading-sm);
    margin: 0;
    color: var(--text-secondary);
    font-weight: var(--font-normal);
  }

  .landing-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-xl);
    margin-bottom: var(--space-3xl);
  }

  /* Custom nav card styling - extends Card primitive */
  .nav-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-3xl) var(--space-xl);
    position: relative;
    overflow: hidden;
  }

  .nav-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, var(--gradient-primary-subtle) 0%, transparent 100%);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .nav-card:hover::before {
    opacity: 1;
  }

  .card-icon {
    font-size: 3rem;
    margin-bottom: var(--space-sm);
    position: relative;
    z-index: 1;
  }

  .card-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-xs);
    position: relative;
    z-index: 1;
    color: var(--text-primary);
  }

  .card-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    position: relative;
    z-index: 1;
  }

  .card-arrow {
    font-size: var(--text-xl);
    margin-top: var(--space-sm);
    opacity: 0;
    transform: translateX(-10px);
    transition: all var(--duration-base) var(--ease-out);
    position: relative;
    z-index: 1;
  }

  .nav-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .landing-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    font-size: var(--text-base);
  }

  .social-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
    font-weight: var(--font-medium);
  }

  .social-link:hover {
    color: var(--accent-primary);
  }

  .separator {
    color: var(--text-secondary);
  }

  .theme-toggle-minimal {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .landing-page {
      padding: var(--space-lg);
    }

    .landing-header {
      margin-bottom: var(--space-xl);
    }

    .landing-nav {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .nav-card {
      padding: var(--space-xl) var(--space-lg);
    }

    .theme-toggle-minimal {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 480px) {
    .landing-page {
      padding: var(--space-md);
    }

    .nav-card {
      padding: var(--space-lg) var(--space-md);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .landing-content {
      animation: none;
    }

    .nav-card::before,
    .card-arrow {
      transition: none;
    }
  }
</style>

<script>
  // Keyboard shortcut for theme toggle
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 't') {
      e.preventDefault();
      const themeControl = document.getElementById('landingThemeControl');
      if (themeControl) {
        themeControl.click();
      }
    }
  });
</script>
