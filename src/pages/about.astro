---
// About — "specimen sheet" dossier, sharing the blog's design language
// (Fraunces / IBM Plex / mono, flat, themeable) without copying its feed.
// Left = the body of the file (statement, intro, CTAs, contact), set
// editorially like a blog post. Right = the filed record: the
// ProfileConstellation widget over a mono spec-table.
// The container stays transparent so the animated grid shows through.
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Button from '@components/primitives/Button.astro';
import ProfileConstellation from '@components/about/ProfileConstellation.astro';

const pageTitle = 'Joel Lithgow > About';
const pageDescription =
  'Creative technologist Joel Lithgow — a designer who codes and an artist who ships. Filed for the record.';

// Social/contact nodes for the constellation widget.
const social = [
  { label: 'LinkedIn', href: 'https://linkedin.com/in/joellithgow', icon: 'linkedin', external: true },
  { label: 'GitHub', href: 'https://github.com/joellithgow', icon: 'github', external: true },
  { label: 'Instagram', href: 'https://instagram.com/joellithgow', icon: 'instagram', external: true },
  { label: 'Email', href: 'mailto:joelnotlithgow@gmail.com', icon: 'email', external: false },
] as const;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="about-container animated-bg bg-accent-geometric">
    <div class="about-sheet">
      {/* ── Left column: the body of the file ────────────────────── */}
      <div class="file-body">
        <header class="file-header">
          <h1 class="statement">I build for the web and make things with my hands.</h1>
          <p class="file-intro">
            Creative technologist with a BFA from California College of the Arts. By day I'm the
            primary developer behind cca.edu; nights and weekends I'm printmaking, playing guitar,
            and running <a href="https://thisisahousegallery.com" target="_blank" rel="noopener noreferrer">This
            is a House Gallery</a> out of the living room I share with my friend Joseph — it flips
            between chaotic studio and clean white walls, usually with a dog named Naru underfoot.
            Lately most of it runs through AI, this site included.
          </p>
          <div class="cta-row">
            <a href="/work" class="cta cta--primary">See my work →</a>
            <a href="/blog" class="cta cta--secondary">Read the blog</a>
          </div>
        </header>

        {/* CONTACT */}
        <section class="doc-section">
          <h2 class="doc-head">Get in touch</h2>
          <p class="doc-text">Have something in mind, or just want to say hello? Email's the fastest way to reach me.</p>
          <div class="cta-row">
            <a href="mailto:joelnotlithgow@gmail.com" class="cta cta--primary">Email me →</a>
          </div>
        </section>
      </div>

      {/* ── Right spine: the filed record ────────────────────────── */}
      <aside class="spine">
        <ProfileConstellation links={social} monogram="JL" />
      </aside>
    </div>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../styles/tokens.css';
  @import '../styles/themes.css';
  @import '../styles/backgrounds.css';

  /* ---- Shell: NO background here. The grid + accent (.animated-bg
     ::before / ::after) sit at z-index:-1; since this element isn't its own
     stacking context, an opaque background would paint over them and hide
     them. Leaving it transparent lets them show over the body's base color.
     Requires position:relative + overflow:hidden. ---- */
  .about-container {
    min-height: 100vh;
    color: var(--text-primary);
    font-family: var(--font-body);
    padding: var(--space-3xl) 0;
    position: relative;
    overflow: hidden;
  }

  /* Mirror the global header's inner container (.gh-inner) so the content
     column's left edge lines up under the "Joel Lithgow" wordmark. */
  .about-sheet {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 var(--page-gutter);
    position: relative;
    z-index: 10; /* above the animated background */
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    column-gap: var(--space-3xl);
    align-items: start;
  }

  /* ============================================================
     RIGHT SPINE — the filed record
     ============================================================ */
  .spine {
    position: sticky;
    top: var(--space-xl);
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
  }

  /* ============================================================
     RIGHT COLUMN — the body of the file
     ============================================================ */
  .file-body { min-width: 0; }

  .file-header {
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--gradient-primary-subtle);
  }
  .statement {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: var(--font-semibold);
    font-size: var(--heading-xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin: 0 0 var(--space-lg) 0;
    max-width: 20ch;
  }
  .file-intro {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-width: 60ch;
    margin: 0;
  }

  /* Sections read as a running document: hairline rule + Fraunces head */
  .doc-section {
    margin-top: var(--space-2xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--gradient-primary-subtle);
  }
  .doc-head {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: var(--font-semibold);
    font-size: var(--heading-md);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin: 0 0 var(--space-md) 0;
  }
  .doc-text {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-width: 68ch;
    margin: 0;
  }
  .doc-text a,
  .file-intro a {
    color: var(--accent-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--gradient-primary-dim);
  }
  .doc-text a:hover,
  .file-intro a:hover { text-decoration-color: var(--accent-primary); }

  /* CTAs — accent blocks matching the blog asides (.type-card):
     colored fill, --bg-dark border + offset shadow, hover-nudge. */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    letter-spacing: 0.04em;
    text-decoration: none;
    padding: var(--space-sm) var(--space-lg);
    border: var(--border-width) solid var(--bg-dark);
    box-shadow: var(--shadow-md) var(--bg-dark);
    transition: transform var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out);
  }
  .cta:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg) var(--bg-dark);
  }
  .cta:focus-visible {
    outline: var(--border-width) solid var(--bg-dark);
    outline-offset: 3px;
  }
  .cta--primary { background: var(--accent-primary); color: var(--card-alt-text-1); }
  .cta--secondary { background: var(--accent-secondary); color: var(--card-alt-text-2); }

  /* ---- Theme toggle button (matches blog) ---- */
  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  /* ============================================================
     Responsive
     ============================================================ */
  /* Spine drops below the body, centered */
  @media (max-width: 900px) {
    .about-sheet {
      display: block;
      max-width: 720px;
    }
    .spine {
      position: static;
      margin-top: var(--space-2xl);
      padding-top: var(--space-xl);
      border-top: 1px solid var(--gradient-primary-subtle);
    }
  }

  @media (max-width: 640px) {
    .theme-toggle-button {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta { transition: none; }
    .cta:hover { transform: none; }
  }
</style>
