---
/**
 * Background Pattern Gallery
 * Grid of all available noise patterns with links to individual playgrounds
 */
import BaseLayout from '@components/common/BaseLayout.astro';
import NoiseTextureBackground from '@components/backgrounds/NoiseTextureBackground.astro';

const pageTitle = 'Background Patterns';
const pageDescription = 'Interactive playground for WebGL animated background patterns';

// Pattern definitions
const patterns = [
  {
    slug: 'perlin',
    name: 'Perlin',
    description: 'Classic gradient noise',
    defaults: { speed: 0.5, intensity: 0.6, noiseScale: 2.0 }
  },
  {
    slug: 'simplex',
    name: 'Simplex',
    description: 'Smooth organic patterns',
    defaults: { speed: 0.4, intensity: 0.5, noiseScale: 3.0 }
  },
  {
    slug: 'worley',
    name: 'Worley',
    description: 'Cellular/voronoi distance',
    defaults: { speed: 0.3, intensity: 0.5, noiseScale: 1.5 }
  },
  {
    slug: 'voronoi-edge',
    name: 'Voronoi Edge',
    description: 'Cell boundaries/cracks',
    defaults: { speed: 0.4, intensity: 0.6, noiseScale: 2.0 }
  },
  {
    slug: 'turbulence',
    name: 'Turbulence',
    description: 'Billowy clouds/smoke',
    defaults: { speed: 0.5, intensity: 0.55, noiseScale: 2.5 }
  },
  {
    slug: 'ridged',
    name: 'Ridged',
    description: 'Mountain ridges/lightning',
    defaults: { speed: 0.4, intensity: 0.6, noiseScale: 2.0 }
  },
  {
    slug: 'domain-warp',
    name: 'Domain Warp',
    description: 'Fluid distortion/warping',
    defaults: { speed: 0.3, intensity: 0.5, noiseScale: 1.5 }
  },
  {
    slug: 'caustics',
    name: 'Caustics',
    description: 'Underwater light patterns',
    defaults: { speed: 0.6, intensity: 0.55, noiseScale: 1.8 }
  },
  {
    slug: 'marble',
    name: 'Marble',
    description: 'Stone veins/wood grain',
    defaults: { speed: 0.3, intensity: 0.5, noiseScale: 2.0 }
  }
];

// Map slugs to noiseType values
const slugToNoiseType: Record<string, string> = {
  'perlin': 'perlin',
  'simplex': 'simplex',
  'worley': 'worley',
  'voronoi-edge': 'voronoiEdge',
  'turbulence': 'turbulence',
  'ridged': 'ridged',
  'domain-warp': 'domainWarp',
  'caustics': 'caustics',
  'marble': 'marble'
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="gallery-page">
    <header class="gallery-header">
      <h1>Background Patterns</h1>
      <p>Click any pattern to open an interactive playground with live controls.</p>
    </header>

    <div class="patterns-grid">
      {patterns.map((pattern) => (
        <a href={`/backgrounds/${pattern.slug}`} class="pattern-card">
          <div class="pattern-preview">
            <NoiseTextureBackground
              noiseType={slugToNoiseType[pattern.slug] as any}
              speed={pattern.defaults.speed}
              intensity={pattern.defaults.intensity}
              noiseScale={pattern.defaults.noiseScale}
            />
          </div>
          <div class="pattern-info">
            <h2>{pattern.name}</h2>
            <p>{pattern.description}</p>
          </div>
        </a>
      ))}
    </div>

    <footer class="gallery-footer">
      <a href="/primitives-test" class="back-link">← Back to Design Primitives</a>
    </footer>
  </main>
</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  .gallery-page {
    min-height: 100vh;
    padding: var(--space-2xl) var(--space-xl);
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .gallery-header {
    max-width: 1200px;
    margin: 0 auto var(--space-2xl);
    text-align: center;
  }

  .gallery-header h1 {
    font-size: var(--heading-2xl);
    margin-bottom: var(--space-md);
  }

  .gallery-header p {
    color: var(--text-secondary);
    font-size: var(--text-lg);
  }

  .patterns-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-xl);
    max-width: 1200px;
    margin: 0 auto;
  }

  .pattern-card {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--bg-secondary);
    border: 2px solid transparent;
    transition: all 0.3s var(--ease-out);
  }

  .pattern-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-primary);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
  }

  .pattern-preview {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .pattern-info {
    padding: var(--space-lg);
    background: var(--bg-primary);
    border-top: 1px solid var(--bg-secondary);
  }

  .pattern-info h2 {
    margin: 0 0 var(--space-xs);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
  }

  .pattern-info p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .gallery-footer {
    max-width: 1200px;
    margin: var(--space-2xl) auto 0;
    text-align: center;
  }

  .back-link {
    display: inline-block;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent-primary);
  }

  @media (max-width: 768px) {
    .gallery-page {
      padding: var(--space-xl) var(--space-md);
    }

    .patterns-grid {
      grid-template-columns: 1fr;
    }

    .pattern-preview {
      height: 160px;
    }
  }
</style>
