---
/**
 * Interactive Pattern Playground
 * Full-page background with live properties panel
 *
 * Uses the pattern registry for dynamic path generation and configuration.
 * Pattern rendering is fully data-driven via GenericPatternRenderer.
 */
import BaseLayout from '@components/common/BaseLayout.astro';
import PropertiesPanel from '@components/backgrounds/PropertiesPanel.astro';
import PresentationToggle from '@components/backgrounds/PresentationToggle.astro';
import GenericPatternRenderer from '@components/backgrounds/patterns/GenericPatternRenderer.astro';
import { PATTERNS, getPatternById } from '@components/backgrounds/patterns/registry';

// Generate static paths from registry
export function getStaticPaths() {
  return PATTERNS.map(pattern => ({
    params: { pattern: pattern.id }
  }));
}

const { pattern } = Astro.params;
const patternDef = getPatternById(pattern);

// 404 if pattern not found
if (!patternDef) {
  return Astro.redirect('/backgrounds');
}
---

<BaseLayout title={`${patternDef.name} - Background Playground`} description={patternDef.description}>
  <main class="playground-page">
    <GenericPatternRenderer pattern={patternDef} class="fullscreen-background" />

    <PropertiesPanel
      patternName={patternDef.name}
      patternDescription={patternDef.description}
      patternSlug={patternDef.internalId}
      defaults={patternDef.defaults}
    />

    <PresentationToggle />
  </main>
</BaseLayout>

<style is:global>
  /* Full page background */
  .playground-page {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }

  .playground-page .fullscreen-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* Ensure canvas fills container */
  .playground-page .webgl-background-container {
    position: absolute !important;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
  }

  /* Presentation mode - hide all UI for clean screenshots/recordings */
  .properties-panel {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  body.presentation-mode .properties-panel {
    opacity: 0;
    pointer-events: none;
    transform: translateY(20px);
  }
</style>
