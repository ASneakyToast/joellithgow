---
import { marked } from 'marked';
import type { GetStaticPaths } from 'astro';
import { fetchBlogPosts } from '@lib/astraeus';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import PageTitle from '@components/ui/PageTitle.astro';
import LinkCard from '@components/blog/LinkCard.astro';
import CollectionWidget from '@components/blog/CollectionWidget.astro';
import Video from '@components/ui/Video.astro';
import ImageGallery from '@components/modals/ImageGallery.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await fetchBlogPosts();
  const sortedPosts = allPosts.sort(
    (a, b) => new Date(b.publish_date).valueOf() - new Date(a.publish_date).valueOf()
  );
  return paginate(sortedPosts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// Get all posts for sidebar stats (need full collection, not just current page)
const allPosts = await fetchBlogPosts();

// Helper function to truncate HTML content to first N paragraphs
function truncateContent(html: string, maxParagraphs: number = 3): { content: string; isTruncated: boolean } {
  const paragraphs: string[] = [];

  // Simple regex-based approach to extract first few paragraphs
  const pRegex = /<p[^>]*>.*?<\/p>/gs;
  const matches = html.match(pRegex) || [];

  const truncated = matches.slice(0, maxParagraphs).join('');
  const isTruncated = matches.length > maxParagraphs;

  return { content: truncated, isTruncated };
}

// Calculate link collection stats (blog posts only — new types have no links)
const linkCollectionPosts = allPosts.filter(post => post.post_type !== 'spotify_dump' && post.post_type !== 'nature_outing' && 'links' in post && (post as any).links && (post as any).links.length > 0);
const totalLinks = linkCollectionPosts.reduce((sum, post) => sum + (('links' in post && (post as any).links?.length) || 0), 0);

// Get featured links (most recent 6)
const allLinks = linkCollectionPosts
  .flatMap(post => {
    const links = ('links' in post && (post as any).links) ? (post as any).links : [];
    return links.map((link: any) => ({
      ...link,
      dateAdded: new Date(link.date_added),
      sourcePost: {
        title: post.title,
        slug: post.slug,
        publishDate: new Date(post.publish_date),
        author: ('author' in post && (post as any).author) || undefined,
      }
    }));
  })
  .sort((a: any, b: any) => new Date(b.date_added).valueOf() - new Date(a.date_added).valueOf())
  .slice(0, 6);

// Calculate tag counts (all post types contribute tags)
const tagCounts = new Map<string, number>();
allPosts.forEach(post => {
  if (post.tags) {
    post.tags.forEach(tag => {
      tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
    });
  }
});

// Sort tags by count (descending) and get top tags
const topTags = Array.from(tagCounts.entries())
  .filter(([tag, count]) => count >= 2) // Only show tags with 2+ posts
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5); // Show top 5 tags

// Get all collection posts for sidebar widgets (blog posts only)
const collectionPosts = allPosts
  .filter(post => post.post_type === 'collection')
  .sort((a, b) => new Date(b.publish_date).valueOf() - new Date(a.publish_date).valueOf());

// Aggregate links by collection tags
// For each collection post, gather all links from other posts that are tagged for it
const collectionPostsWithLinks = collectionPosts.map(collectionPost => {
  // Find all links across all posts that are tagged for this collection
  const aggregatedLinks = allPosts
    .filter(post => 'links' in post && (post as any).links && (post as any).links.length > 0)
    .flatMap(post =>
      (('links' in post && (post as any).links) || [])
        .filter((link: any) => link.collections?.includes(collectionPost.slug))
        .map((link: any) => ({
          ...link,
          dateAdded: new Date(link.date_added),
          sourcePost: {
            title: post.title,
            slug: post.slug,
            publishDate: new Date(post.publish_date),
            author: ('author' in post && (post as any).author) || undefined,
          }
        }))
    )
    .sort((a: any, b: any) => new Date(b.date_added).valueOf() - new Date(a.date_added).valueOf());

  return {
    ...collectionPost,
    aggregatedLinks
  };
});

const pageTitle = "Joel Lithgow > Blog";
const pageDescription = "Silly ideas, shiny objects, and more things I share digitally";

// JSON-LD structured data for CollectionPage
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: 'https://joellithgow.com/blog',
  author: {
    '@type': 'Person',
    name: 'Joel Lithgow',
    url: 'https://joellithgow.com',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://joellithgow.com',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: 'https://joellithgow.com/blog',
      },
    ],
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="blog-container animated-bg bg-accent-editorial">
    <div class="blog-wrapper">
      {/* Main Content Column */}
      <div class="main-content">
        {/* Header Section */}
        <section id="blog" class="blog-header-section">
          <header class="blog-header">
            <PageTitle title="Blog" subtitle={pageDescription} />

            {/* Tag cloud */}
            {topTags.length > 0 && (
              <div class="tag-cloud">
                <span class="tag-cloud-label">On</span>
                {topTags.map(([tag, count]) => (
                  <a href={`/blog/tags/${tag}`} class="tag-cloud-item">
                    {tag} <span class="tag-count">{count}</span>
                  </a>
                ))}
              </div>
            )}
          </header>
        </section>

        {/* Featured Posts Section */}
        {page.data.length > 0 && (
          <section id="featured-posts" class="featured-posts-section">
            <div class="posts-header">
              <h2 class="section-heading">recent posts</h2>
            </div>
            <div class="featured-posts">
              {page.data.map((post) => (
                post.post_type === 'collection' ? (
                  // Minimal collection card
                  <Card variant="flat" as="article" class="collection-card-minimal">
                    <a href={`/blog/${post.slug}`} class="collection-card-link">
                      <h2 class="collection-title">
                        {post.title}
                        <Badge variant="tertiary" size="sm" class="collection-badge">
                          {('links' in post && (post as any).links?.length) || 0} links
                        </Badge>
                      </h2>
                      <p class="collection-description">{post.description}</p>
                    </a>
                  </Card>
                ) : post.post_type === 'spotify_dump' ? (
                  // Spotify liked song dump — full inline card
                  <Card variant="flat" as="article" class="featured-post-card spotify-dump-card">
                    <header class="gateway-card-header">
                      <div class="gateway-card-meta">
                        <time datetime={new Date(post.publish_date).toISOString()} class="post-date">
                          {new Date(post.publish_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
                        </time>
                      </div>
                      <a href={`/blog/${post.slug}`} class="gateway-permalink" title="Permalink">
                        ↗
                      </a>
                    </header>

                    <h2 class="post-title post-title-text">{post.title}</h2>

                    {(post as any).songs && (post as any).songs.length > 0 && (
                      <div class="spotify-track-list">
                        {((post as any).songs as any[]).map((song: any, i: number) => (
                          <div class="spotify-track">
                            {song.album_art_url && (
                              <img src={song.album_art_url} alt={song.album_name || ''} class="track-album-art" loading="lazy" />
                            )}
                            <span class="track-num">{i + 1}</span>
                            <div class="track-info">
                              <span class="track-name">
                                {song.spotify_url ? (
                                  <a href={song.spotify_url} target="_blank" rel="noopener noreferrer" class="track-link">
                                    {song.track_name}
                                  </a>
                                ) : song.track_name}
                              </span>
                              <span class="track-artist">{song.artist_name}</span>
                            </div>
                          </div>
                        ))}
                      </div>
                    )}

                    {post.tags && post.tags.length > 0 && (
                      <div class="post-tags">
                        {post.tags.map((tag) => (
                          <Badge href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
                        ))}
                      </div>
                    )}
                  </Card>
                ) : post.post_type === 'nature_outing' ? (
                  // iNaturalist outing — full inline card
                  <Card variant="flat" as="article" class="featured-post-card nature-outing-card">
                    <header class="gateway-card-header">
                      <div class="gateway-card-meta">
                        <time datetime={new Date(post.publish_date).toISOString()} class="post-date">
                          {new Date(post.publish_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                        </time>
                      </div>
                      <a href={`/blog/${post.slug}`} class="gateway-permalink" title="Permalink">
                        ↗
                      </a>
                    </header>

                    <h2 class="post-title post-title-text">{post.title}</h2>

                    {(post as any).photo_urls && (post as any).photo_urls.length > 0 && (
                      <div
                        class="nature-photo-grid"
                        data-gallery-urls={JSON.stringify(((post as any).photo_urls as string[]).slice(0, 6))}
                      >
                        {((post as any).photo_urls as string[]).slice(0, 6).map((url: string, i: number) => (
                          <img
                            src={url}
                            alt="iNaturalist observation photo"
                            loading="lazy"
                            class="nature-photo"
                            data-gallery-index={i}
                          />
                        ))}
                      </div>
                    )}

                    {(post as any).species_list && (post as any).species_list.length > 0 && (
                      <div class="species-chips">
                        {((post as any).species_list as string[]).slice(0, 10).map((species: string) => (
                          <span class="species-chip">{species}</span>
                        ))}
                        {(post as any).species_list.length > 10 && (
                          <a href={`/blog/${post.slug}`} class="species-overflow">
                            +{(post as any).species_list.length - 10} more
                          </a>
                        )}
                      </div>
                    )}

                    <div class="nature-outing-stats">
                      <span class="outing-stat">
                        <strong>{(post as any).observation_count || 0}</strong> observations
                      </span>
                      {(post as any).species_list && (
                        <span class="outing-stat">
                          <strong>{(post as any).species_list.length}</strong> species
                        </span>
                      )}
                    </div>

                    {post.tags && post.tags.length > 0 && (
                      <div class="post-tags">
                        {post.tags.map((tag) => (
                          <Badge href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
                        ))}
                      </div>
                    )}
                  </Card>
                ) : post.post_type === 'definition' ? (
                                  // Definition card — styled like a dictionary entry
                                  <Card variant="flat" as="article" class="featured-post-card" data-post-type="definition">
                                    <time
                                      datetime={new Date(post.publish_date).toISOString()}
                                      class="post-date"
                                    >
                                      {new Date(post.publish_date).toLocaleDateString('en-US', {
                                        year: 'numeric',
                                        month: 'long',
                                        day: 'numeric'
                                      })}
                                    </time>

                                    <h2 class="post-title">
                                      <a
                                        href={`/definitions/${post.slug}`}
                                        class="post-title-link"
                                      >
                                        {(post as any).term || post.title}
                                      </a>
                                    </h2>

                                    {(post as any).definition && (
                                      <blockquote class="definition-preview">
                                        <p>&ldquo;{(post as any).definition.slice(0, 300)}{(post as any).definition.length > 300 ? '&hellip;' : ''}&rdquo;</p>
                                      </blockquote>
                                    )}

                                    {(post as any).personal_notes && (
                                      <p class="post-description">{(post as any).personal_notes.slice(0, 200)}{(post as any).personal_notes.length > 200 ? '...' : ''}</p>
                                    )}

                                    {post.tags && post.tags.length > 0 &&  (
                                      <div class="post-tags">
                                        {post.tags.map((tag) => (
                                          <Badge href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
                                        ))}
                                      </div>
                                    )}

                                    <div class="post-meta">
                                      <Button href={`/definitions/${post.slug}`} variant="primary" size="md">
                                        View definition →
                                      </Button>
                                    </div>
                                  </Card>
                                ) : (
                                  // Full post card (article / thought)
                  <Card variant="flat" as="article" class="featured-post-card" data-post-type={post.post_type}>
                    <time
                      datetime={new Date(post.publish_date).toISOString()}
                      class="post-date"
                    >
                      {new Date(post.publish_date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </time>

                    <h2 class="post-title">
                      {(post as any).has_detail_page !== false ? (
                        <a
                          href={`/blog/${post.slug}`}
                          class="post-title-link"
                        >
                          {post.title}
                        </a>
                      ) : (
                        <span class="post-title-text">{post.title}</span>
                      )}
                    </h2>

                    {/* Hero image/video */}
                    {'image' in post && (post as any).image && (
                      <div class="post-hero-image">
                        {(() => {
                          const img = (post as any).image;
                          const isVideo = img.type === 'video';
                          const linkHref = img.link || ((post as any).has_detail_page !== false ? `/blog/${post.slug}` : null);
                          const isExternal = img.link?.startsWith('http');

                          const media = isVideo ? (
                            <Video
                              src={img.src}
                              fallbackSrc={img.fallbackSrc}
                              poster={img.poster}
                              controls={false}
                            />
                          ) : (
                            <img
                              src={img.src}
                              alt={img.alt}
                              loading="lazy"
                            />
                          );

                          return linkHref ? (
                            <a
                              href={linkHref}
                              class="post-hero-link"
                              {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                            >
                              {media}
                            </a>
                          ) : media;
                        })()}
                      </div>
                    )}

                    {'description' in post && (post as any).description && (
                      <p class="post-description">
                        {(post as any).description}
                      </p>
                    )}

                    {/* Render excerpt or full content preview (blog posts only) */}
                    {'excerpt' in post && (post as any).excerpt && (post as any).has_detail_page !== false ? (
                      <div class="post-excerpt-preview" set:html={(post as any).excerpt} />
                    ) : (
                      <div class:list={['post-content-preview', { 'full-content': (post as any).has_detail_page === false }]}
                        set:html={marked.parse(('body_markdown' in post ? (post as any).body_markdown : null) ?? '')}
                      />
                    )}

                    {/* Link collection display for inline posts (legacy thoughts with links) */}
                    {(post as any).has_detail_page === false && 'links' in post && (post as any).links && (post as any).links.length > 0 && (
                      <div class="post-links-section">
                        <div class="post-links-header">
                          <h3 class="post-links-title">Links from this collection</h3>
                          <span class="post-links-count">{(post as any).links.length} link{(post as any).links.length !== 1 ? 's' : ''}</span>
                        </div>

                        <div class="post-links-grid">
                          {(post as any).links.map((link: any) => (
                            <LinkCard link={{ ...link, dateAdded: new Date(link.date_added) }} variant="minimal" />
                          ))}
                        </div>
                      </div>
                    )}

                    {post.tags && post.tags.length > 0 && (
                      <div class="post-tags">
                        {post.tags.map((tag) => (
                          <Badge href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
                        ))}
                      </div>
                    )}

                    {('reading_time' in post && (post as any).reading_time || (post as any).has_detail_page !== false) && (
                      <div class="post-meta">
                        {'reading_time' in post && (post as any).reading_time && (
                          <span class="post-reading-time">{(post as any).reading_time} min read</span>
                        )}

                        {(post as any).has_detail_page !== false && (
                          <Button href={`/blog/${post.slug}`} variant="primary" size="md">
                            {'excerpt' in post && (post as any).excerpt ? 'Read the full story →' : 'Continue reading →'}
                          </Button>
                        )}
                      </div>
                    )}
                  </Card>
                )
              ))}
            </div>
          </section>
        )}

        {/* Featured Links Section - only on page 1 */}
        {allLinks.length > 0 && page.currentPage === 1 && (
          <section id="featured-links" class="featured-links-section">
            <div class="featured-links-header">
              <h2 class="section-heading">recent links</h2>
              <Button href="/blog/links" variant="ghost" size="sm">
                View all {totalLinks} links →
              </Button>
            </div>
            <div class="featured-links-grid">
              {allLinks.map((link) => (
                <LinkCard link={link} variant="minimal" showSourceInfo={true} />
              ))}
            </div>
          </section>
        )}

        {/* Pagination Navigation */}
        {(page.url.prev || page.url.next) && (
          <nav class="pagination" aria-label="Blog pagination">
            {page.url.prev ? (
              <a href={page.url.prev} class="pagination-link prev">
                ← Newer Posts
              </a>
            ) : (
              <span class="pagination-link disabled">← Newer Posts</span>
            )}
            <span class="pagination-info">
              Page {page.currentPage} of {page.lastPage}
            </span>
            {page.url.next ? (
              <a href={page.url.next} class="pagination-link next">
                Older Posts →
              </a>
            ) : (
              <span class="pagination-link disabled">Older Posts →</span>
            )}
          </nav>
        )}

        {/* Empty state if no posts */}
        {page.total === 0 && (
          <Card class="empty-state">
            <div class="empty-message">
              <Badge>coming soon</Badge>
              <p>No blog posts published yet. Check back soon!</p>
            </div>
          </Card>
        )}
      </div>

      {/* Sidebar */}
      <aside class="sidebar">
              <h2 class="sidebar-heading">
                Related Links
                {totalLinks > 0 && (
                  <a href="/blog/links" class="browse-all-link">
                    (Browse all {totalLinks} →)
                  </a>
                )}
              </h2>

              {/* Glossary link */}
                            <CollectionWidget
                              title="Glossary"
                              description="Terms, concepts, and ideas with definitions and sources."
                              links={[{ url: "/definitions", title: "Browse Glossary", dateAdded: new Date() }]}
                              linkLimit={1}
                              viewAllHref="/definitions"
                            />

              {/* Dynamic Collection Widgets */}
        {collectionPostsWithLinks.map((collection) => (
          collection.aggregatedLinks && collection.aggregatedLinks.length > 0 && (
            <CollectionWidget
              title={collection.title}
              description={collection.description}
              links={collection.aggregatedLinks}
              linkLimit={4}
              viewAllHref={`/blog/${collection.slug}`}
            />
          )
        ))}
      </aside>
    </div>
  </main>

  <!-- Image Gallery Lightbox -->
  <ImageGallery />

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <script>
    // Wire up nature photo grids to the image gallery lightbox
    document.querySelectorAll('.nature-photo-grid').forEach((grid) => {
      const urls = JSON.parse((grid as HTMLElement).dataset.galleryUrls || '[]');
      const images = urls.map((url: string) => ({ src: url, alt: 'iNaturalist observation', caption: '' }));
      grid.querySelectorAll('.nature-photo').forEach((img) => {
        (img as HTMLElement).style.cursor = 'zoom-in';
        img.addEventListener('click', () => {
          const idx = parseInt((img as HTMLElement).dataset.galleryIndex || '0', 10);
          (window as any).openGallery?.(images, idx);
        });
      });
    });
  </script>

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';
  @import '../../styles/backgrounds.css';

  /* Clean, traditional blog styling */
  .blog-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-3xl) var(--page-gutter);
    position: relative;
    overflow: hidden; /* Required for animated backgrounds */
  }

  .blog-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 10; /* Above animated backgrounds */
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-3xl);
    align-items: start;
  }

  .main-content {
    min-width: 0; /* Prevents grid blowout */
  }

  .sidebar {
    position: sticky;
    top: var(--space-3xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .sidebar-heading {
    font-family: var(--font-family);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0;
    padding-bottom: var(--space-md);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
    letter-spacing: var(--tracking-tight);
  }

  /* Section Styles */
  .blog-header-section {
    position: relative;
    margin: var(--space-2xl) 0;
  }

  .featured-posts-section,
  .archive-posts-section {
    position: relative;
    margin: var(--space-xl) 0;
  }

  .archive-posts-section {
    margin-top: var(--space-3xl);
    padding-top: var(--space-3xl);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .section-heading {
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin: 0 0 var(--space-xl) 0;
  }

  .blog-header {
    text-align: left;
    padding-bottom: var(--space-xl);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .blog-header :global(.badge) {
    margin-bottom: var(--space-md);
  }

  /* Tag Cloud Styles */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .tag-cloud-label {
    font-family: var(--font-family);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    font-weight: var(--font-medium);
    margin-right: var(--space-xs);
  }

  .tag-cloud-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: var(--space-sm) var(--space-md);
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--radius-full);
    text-decoration: none;
    font-family: var(--font-family);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    transition: all var(--duration-base) var(--ease-out);
    box-shadow: var(--shadow-sm) var(--accent-secondary);
  }

  .tag-cloud-item:hover {
    background: var(--accent-primary);
    color: var(--text-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md) var(--accent-secondary);
  }

  .tag-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 var(--space-xs);
    background: var(--gradient-primary-light);
    color: var(--text-primary);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border: var(--border-width) solid var(--accent-secondary);
  }

  .tag-cloud-item:hover .tag-count {
    background: var(--accent-secondary);
    color: var(--bg-dark);
  }

  /* Browse all links */
  .browse-all-link {
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-secondary);
    text-decoration: none;
    margin-left: var(--space-sm);
    transition: color 0.2s ease;
  }

  .browse-all-link:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  /* Featured Links Section */
  .featured-links-section {
    position: relative;
    margin: var(--space-xl) 0;
  }

  .featured-links-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .featured-links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  /* Posts Header */
  .posts-header {
    margin-bottom: var(--space-xl);
  }

  /* Featured Posts Styles */
  .featured-posts {
    display: grid;
    gap: var(--space-3xl);
    min-width: 0;
  }

  .featured-post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    transform: var(--rotation-sm);
    padding: var(--space-2xl);
    min-width: 0;
  }

  .featured-post-card:nth-child(even) {
    transform: var(--rotation-sm);
  }

  /* Thought Posts - subtle visual distinction */
  .featured-post-card[data-post-type="thought"] {
    border-left: 3px solid var(--accent-primary);
    padding-left: calc(var(--space-2xl) - 3px); /* Maintain alignment */
  }

  /* Minimal Collection Card */
  .collection-card-minimal {
    padding: var(--space-lg) var(--space-xl);
  }

  .collection-card-link {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    text-decoration: none;
    color: inherit;
    transition: all var(--duration-base) var(--ease-out);
  }

  .collection-card-link:hover {
    color: var(--accent-primary);
  }

  .collection-card-minimal .collection-title {
    font-family: var(--font-family-system);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    white-space: nowrap;
  }

  .collection-card-minimal .collection-description {
    font-family: var(--font-family);
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .collection-card-link {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .collection-card-minimal .collection-description {
      white-space: normal;
    }
  }

  /* Archive Posts Styles */
  .archive-posts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .archive-post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    transform: var(--rotation-sm);
    transition: all var(--duration-base) var(--ease-out);
  }

  .archive-post-card:nth-child(even) {
    transform: var(--rotation-sm);
  }

  .archive-post-card:hover {
    transform: scale(1.05);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
    z-index: 5;
  }

  .post-date {
    display: block;
    color: var(--text-secondary);
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: var(--tracking-wide);
  }

  .post-title {
    font-family: var(--font-family-system);
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-md) 0;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .post-title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .post-title-link:hover {
    color: var(--accent-primary);
  }

  .post-title-text {
    color: var(--text-primary);
  }

  .collection-badge {
    margin-left: var(--space-sm);
  }

  .post-description {
    color: var(--text-secondary);
    font-family: var(--font-family);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    margin: 0;
    font-style: italic;
    border-left: 3px solid var(--accent-primary);
    padding-left: var(--space-md);
  }

  /* Hero image styles */
  .post-hero-image {
    margin: var(--space-lg) 0;
    border-radius: var(--border-radius);
    overflow: hidden;
    border: var(--border-width) solid var(--accent-primary);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
  }

  .post-hero-image img,
  .post-hero-image video {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .post-hero-link {
    display: block;
    overflow: hidden;
  }

  .post-hero-link:hover img,
  .post-hero-link:hover video {
    transform: scale(1.05);
  }

  .post-excerpt {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Content Preview Styles */
  .post-content-preview {
    color: var(--text-primary);
    font-family: var(--font-family);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: var(--space-lg) 0;
    position: relative;
    max-height: 400px;
    overflow: hidden;
  }

  .post-excerpt-preview {
    color: var(--text-primary);
    font-family: var(--font-family);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: var(--space-lg) 0;
  }

  .post-content-preview::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to bottom, transparent, var(--bg-secondary));
    pointer-events: none;
  }

  /* Full content for posts without detail pages */
  .post-content-preview.full-content {
    max-height: none;
    overflow: visible;
  }

  .post-content-preview.full-content::after {
    display: none;
  }

  /* Style markdown content in preview */
  .post-content-preview :global(h1),
  .post-content-preview :global(h2),
  .post-content-preview :global(h3),
  .post-content-preview :global(h4),
  .post-excerpt-preview :global(h1),
  .post-excerpt-preview :global(h2),
  .post-excerpt-preview :global(h3),
  .post-excerpt-preview :global(h4) {
    color: var(--text-primary);
    font-weight: var(--font-bold);
    margin: var(--space-lg) 0 var(--space-sm) 0;
    line-height: var(--leading-tight);
  }

  .post-content-preview :global(h2),
  .post-excerpt-preview :global(h2) {
    font-size: var(--text-xl);
    color: var(--accent-primary);
  }

  .post-content-preview :global(h3),
  .post-excerpt-preview :global(h3) {
    font-size: var(--text-lg);
  }

  .post-content-preview :global(p),
  .post-excerpt-preview :global(p) {
    margin: var(--space-md) 0;
  }

  .post-content-preview :global(a),
  .post-excerpt-preview :global(a) {
    color: var(--accent-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-secondary);
  }

  .post-content-preview :global(strong),
  .post-excerpt-preview :global(strong) {
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .post-content-preview :global(em),
  .post-excerpt-preview :global(em) {
    font-style: italic;
  }

  .post-content-preview :global(ul),
  .post-content-preview :global(ol),
  .post-excerpt-preview :global(ul),
  .post-excerpt-preview :global(ol) {
    margin: var(--space-md) 0;
    padding-left: var(--space-xl);
  }

  .post-content-preview :global(li),
  .post-excerpt-preview :global(li) {
    margin: var(--space-xs) 0;
  }

  .post-content-preview :global(code),
  .post-excerpt-preview :global(code) {
    background: var(--gradient-secondary-light);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .post-content-preview :global(pre),
  .post-excerpt-preview :global(pre) {
    display: none; /* Hide code blocks in preview to keep it clean */
  }

  .post-content-preview :global(img),
  .post-excerpt-preview :global(img) {
    display: none; /* Hide images in preview */
  }

  /* Show all content for full posts */
  .post-content-preview.full-content :global(pre) {
    display: block;
    background: var(--bg-dark);
    color: var(--text-light);
    padding: var(--space-xl);
    margin: var(--space-2xl) 0;
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md) var(--accent-secondary);
    overflow-x: auto;
  }

  .post-content-preview.full-content :global(pre code) {
    background: none;
    border: none;
    color: inherit;
    padding: 0;
  }

  .post-content-preview.full-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: var(--space-2xl) auto;
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
  }

  /* Link collection styles for blog index */
  .post-links-section {
    margin: var(--space-2xl) 0;
    padding-top: var(--space-xl);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .post-links-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xl);
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .post-links-title {
    font-family: var(--font-family);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin: 0;
  }

  .post-links-count {
    background: var(--accent-tertiary);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-md);
    font-family: var(--font-family);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-sm) var(--accent-primary);
  }

  .post-links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-sm);
    padding-top: var(--space-md);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .post-reading-time {
    font-family: var(--font-family);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-4xl) var(--space-xl);
    margin-top: var(--space-xl);
  }

  .empty-message :global(.badge) {
    margin-bottom: var(--space-md);
  }

  .empty-message p {
    font-family: var(--font-family);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-xl);
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .pagination-link {
    padding: var(--space-md) var(--space-xl);
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--radius-full);
    text-decoration: none;
    font-family: var(--font-family);
    font-weight: var(--font-medium);
    transition: all var(--duration-base) var(--ease-out);
  }

  .pagination-link:hover:not(.disabled) {
    background: var(--accent-primary);
    color: var(--text-light);
    transform: translateY(-2px);
  }

  .pagination-link.disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pagination-info {
    color: var(--text-secondary);
    font-family: var(--font-family);
    font-size: var(--text-sm);
  }

  /* Responsive design */
  @media (max-width: 1024px) {
    .blog-wrapper {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .sidebar {
      position: relative;
      top: 0;
    }

    /* Archive posts still 2 columns on tablet */
    .archive-posts {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (max-width: 768px) {
    .blog-container {
      padding: var(--space-xl) var(--page-gutter);
    }

    .blog-header {
      margin-bottom: var(--space-xl);
      padding-bottom: var(--space-lg);
    }

    .tag-cloud {
      gap: var(--space-sm);
    }

    .tag-cloud-item {
      font-size: var(--text-sm);
      padding: var(--space-xs) var(--space-sm);
    }

    .tag-cloud-label {
      font-size: var(--text-base);
    }

    /* Archive posts switch to single column on mobile */
    .archive-posts {
      grid-template-columns: 1fr;
    }

    /* Link collection grid to single column on mobile */
    .post-links-grid {
      grid-template-columns: 1fr;
    }

    /* Featured links to single column on mobile */
    .featured-links-grid {
      grid-template-columns: 1fr;
    }

    .featured-links-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .featured-post-card {
      padding: var(--space-lg);
    }

    .post-content-preview {
      max-height: 300px;
      font-size: var(--text-sm);
    }

    .post-excerpt-preview {
      font-size: var(--text-sm);
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .blog-container {
      padding: var(--space-lg) var(--space-md);
    }

    .featured-post-card {
      padding: var(--space-md);
    }

    .post-title {
      font-size: var(--text-xl);
    }

    .post-description {
      font-size: var(--text-base);
    }

    .post-excerpt {
      font-size: var(--text-sm);
    }

    .post-content-preview {
      max-height: 250px;
    }

    .pagination {
      flex-direction: column;
      gap: var(--space-md);
    }

    .pagination-link {
      padding: var(--space-sm) var(--space-lg);
      font-size: var(--text-sm);
    }

    .section-heading {
      font-size: var(--heading-md);
    }
  }

  /* ------------------------------------------------------------------ */
  /* Gateway cards — Spotify & iNaturalist                              */
  /* ------------------------------------------------------------------ */

  .gateway-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .gateway-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .gateway-card-icon {
    font-size: var(--text-xl);
    line-height: 1;
  }

  .gateway-place {
    font-family: var(--font-family);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-style: italic;
  }

  .gateway-permalink {
    font-size: var(--text-base);
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-width) solid var(--gradient-primary-subtle);
    border-radius: var(--radius-sm);
    transition: all var(--duration-base) var(--ease-out);
    flex-shrink: 0;
  }

  .gateway-permalink:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
  }

  /* Spotify */
  .spotify-dump-card {
    border-left: 3px solid #1db954;
    min-width: 0;
    max-width: 100%;
    contain: layout;
  }

  .spotify-track-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: var(--border-width) solid var(--gradient-primary-subtle);
    border-radius: var(--border-radius);
    overflow-x: hidden;
    overflow-y: auto;
    max-height: 360px;
    margin: var(--space-lg) 0;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-primary) transparent;
  }

  .spotify-track {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
    transition: background var(--duration-base) var(--ease-out);
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .spotify-track:last-child {
    border-bottom: none;
  }

  .spotify-track:hover {
    background: var(--bg-secondary);
  }

  .track-album-art {
    width: 36px;
    height: 36px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .track-num {
    font-family: var(--font-family);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    width: 1.5rem;
    text-align: right;
    flex-shrink: 0;
  }

  .track-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .track-name {
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }

  .track-link {
    color: inherit;
    text-decoration: none;
  }

  .track-link:hover {
    color: #1db954;
    text-decoration: underline;
  }

  .track-artist {
    font-family: var(--font-family);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }

  /* iNaturalist */
  .nature-outing-card {
    border-left: 3px solid #74ac00;
  }

  .nature-photo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    border-radius: var(--border-radius);
    overflow: hidden;
    margin: var(--space-lg) 0;
  }

  @media (min-width: 600px) {
    .nature-photo-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .nature-photo {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-sm);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nature-photo:hover {
    transform: scale(1.03);
  }

  .species-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: var(--space-lg) 0 var(--space-md);
  }

  .species-chip {
    font-family: var(--font-family);
    font-size: var(--text-xs);
    color: var(--text-primary);
    background: var(--bg-secondary);
    border: var(--border-width) solid #74ac00;
    border-radius: var(--radius-full);
    padding: var(--space-xs) var(--space-sm);
  }

  .species-overflow {
    font-family: var(--font-family);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-width) solid var(--gradient-primary-subtle);
    border-radius: var(--radius-full);
  }

  .species-overflow:hover {
    color: #74ac00;
    border-color: #74ac00;
  }

  .nature-outing-stats {
    display: flex;
    gap: var(--space-xl);
    font-family: var(--font-family);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: var(--space-md) 0 var(--space-lg);
    padding-top: var(--space-md);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .outing-stat strong {
    color: var(--text-primary);
    font-weight: var(--font-bold);
  }

  /* Definition preview blockquote in blog feed */
    .definition-preview {
      margin: var(--space-lg) 0;
      padding: var(--space-md) var(--space-lg);
      background: var(--bg-secondary);
      border-left: 3px solid var(--accent-primary);
      font-style: italic;
      color: var(--text-secondary);
      font-size: var(--text-base);
      line-height: var(--leading-relaxed);
    }

    .definition-preview p {
      margin: 0;
    }

    /* Theme toggle button */
    .theme-toggle-button {
      position: fixed;
      bottom: var(--space-xl);
      right: var(--space-xl);
      width: 48px;
      height: 48px;
      border-radius: var(--radius-full);
      z-index: var(--z-sticky);
    }

    @media (max-width: 768px) {
      .theme-toggle-button {
        bottom: var(--space-lg);
        right: var(--space-lg);
        width: 44px;
        height: 44px;
      }
    }
</style>
