---
import { marked } from 'marked';
import type { GetStaticPaths } from 'astro';
import { fetchBlogPosts } from '@lib/astraeus';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import PageTitle from '@components/ui/PageTitle.astro';
import LinkCard from '@components/blog/LinkCard.astro';
import CollectionWidget from '@components/blog/CollectionWidget.astro';
import Video from '@components/ui/Video.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await fetchBlogPosts();
  const sortedPosts = allPosts.sort(
    (a, b) => new Date(b.publish_date).valueOf() - new Date(a.publish_date).valueOf()
  );
  return paginate(sortedPosts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// Get all posts for sidebar stats (need full collection, not just current page)
const allPosts = await fetchBlogPosts();

// Helper function to truncate HTML content to first N paragraphs
function truncateContent(html: string, maxParagraphs: number = 3): { content: string; isTruncated: boolean } {
  const paragraphs: string[] = [];

  // Simple regex-based approach to extract first few paragraphs
  const pRegex = /<p[^>]*>.*?<\/p>/gs;
  const matches = html.match(pRegex) || [];

  const truncated = matches.slice(0, maxParagraphs).join('');
  const isTruncated = matches.length > maxParagraphs;

  return { content: truncated, isTruncated };
}

// Calculate link collection stats
const linkCollectionPosts = allPosts.filter(post => post.links && post.links.length > 0);
const totalLinks = linkCollectionPosts.reduce((sum, post) => sum + (post.links?.length || 0), 0);

// Get featured links (most recent 6)
const allLinks = linkCollectionPosts
  .flatMap(post =>
    (post.links ?? []).map(link => ({
      ...link,
      dateAdded: new Date(link.date_added),
      sourcePost: {
        title: post.title,
        slug: post.slug,
        publishDate: new Date(post.publish_date),
        author: post.author
      }
    }))
  )
  .sort((a, b) => new Date(b.date_added).valueOf() - new Date(a.date_added).valueOf())
  .slice(0, 6);

// Calculate tag counts
const tagCounts = new Map<string, number>();
allPosts.forEach(post => {
  if (post.tags) {
    post.tags.forEach(tag => {
      tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
    });
  }
});

// Sort tags by count (descending) and get top tags
const topTags = Array.from(tagCounts.entries())
  .filter(([tag, count]) => count >= 2) // Only show tags with 2+ posts
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5); // Show top 5 tags

// Get all collection posts for sidebar widgets
const collectionPosts = allPosts
  .filter(post => post.post_type === 'collection')
  .sort((a, b) => new Date(b.publish_date).valueOf() - new Date(a.publish_date).valueOf());

// Aggregate links by collection tags
// For each collection post, gather all links from other posts that are tagged for it
const collectionPostsWithLinks = collectionPosts.map(collectionPost => {
  // Find all links across all posts that are tagged for this collection
  const aggregatedLinks = allPosts
    .filter(post => post.links && post.links.length > 0)
    .flatMap(post =>
      (post.links ?? [])
        .filter(link => link.collections?.includes(collectionPost.slug))
        .map(link => ({
          ...link,
          dateAdded: new Date(link.date_added),
          sourcePost: {
            title: post.title,
            slug: post.slug,
            publishDate: new Date(post.publish_date),
            author: post.author
          }
        }))
    )
    .sort((a, b) => new Date(b.date_added).valueOf() - new Date(a.date_added).valueOf());

  return {
    ...collectionPost,
    aggregatedLinks
  };
});

const pageTitle = "Joel Lithgow > Blog";
const pageDescription = "Silly ideas, shiny objects, and more things I share digitally";

// JSON-LD structured data for CollectionPage
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: 'https://joellithgow.com/blog',
  author: {
    '@type': 'Person',
    name: 'Joel Lithgow',
    url: 'https://joellithgow.com',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://joellithgow.com',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: 'https://joellithgow.com/blog',
      },
    ],
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="blog-container animated-bg bg-accent-editorial">
    <div class="blog-wrapper">
      {/* Main Content Column */}
      <div class="main-content">
        {/* Header Section */}
        <section id="blog" class="blog-header-section">
          <header class="blog-header">
            <PageTitle title="Blog" subtitle={pageDescription} />

            {/* Tag cloud */}
            {topTags.length > 0 && (
              <div class="tag-cloud">
                <span class="tag-cloud-label">On</span>
                {topTags.map(([tag, count]) => (
                  <a href={`/blog/tags/${tag}`} class="tag-cloud-item">
                    {tag} <span class="tag-count">{count}</span>
                  </a>
                ))}
              </div>
            )}
          </header>
        </section>

        {/* Featured Posts Section */}
        {page.data.length > 0 && (
          <section id="featured-posts" class="featured-posts-section">
            <div class="posts-header">
              <h2 class="section-heading">recent posts</h2>
            </div>
            <div class="featured-posts">
              {page.data.map((post) => (
                post.post_type === 'collection' ? (
                  // Minimal collection card
                  <Card variant="flat" as="article" class="collection-card-minimal">
                    <a href={`/blog/${post.slug}`} class="collection-card-link">
                      <h2 class="collection-title">
                        {post.title}
                        <Badge variant="tertiary" size="sm" class="collection-badge">
                          {post.links?.length || 0} links
                        </Badge>
                      </h2>
                      <p class="collection-description">{post.description}</p>
                    </a>
                  </Card>
                ) : (
                  // Full post card
                  <Card variant="flat" as="article" class="featured-post-card" data-post-type={post.post_type}>
                    <time
                      datetime={new Date(post.publish_date).toISOString()}
                      class="post-date"
                    >
                      {new Date(post.publish_date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </time>

                    <h2 class="post-title">
                      {post.has_detail_page !== false ? (
                        <a
                          href={`/blog/${post.slug}`}
                          class="post-title-link"
                        >
                          {post.title}
                        </a>
                      ) : (
                        <span class="post-title-text">{post.title}</span>
                      )}
                    </h2>

                    {/* Hero image/video */}
                    {post.image && (
                      <div class="post-hero-image">
                        {(() => {
                          const isVideo = post.image.type === 'video';
                          const linkHref = post.image.link || (post.has_detail_page !== false ? `/blog/${post.slug}` : null);
                          const isExternal = post.image.link?.startsWith('http');

                          const media = isVideo ? (
                            <Video
                              src={post.image.src}
                              fallbackSrc={post.image.fallbackSrc}
                              poster={post.image.poster}
                              controls={false}
                            />
                          ) : (
                            <img
                              src={post.image.src}
                              alt={post.image.alt}
                              loading="lazy"
                            />
                          );

                          return linkHref ? (
                            <a
                              href={linkHref}
                              class="post-hero-link"
                              {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                            >
                              {media}
                            </a>
                          ) : media;
                        })()}
                      </div>
                    )}

                    <p class="post-description">
                      {post.description}
                    </p>

                    {/* Render excerpt or full content preview */}
                    {post.excerpt && post.has_detail_page !== false ? (
                      <div class="post-excerpt-preview" set:html={post.excerpt} />
                    ) : (
                      <div class:list={['post-content-preview', { 'full-content': post.has_detail_page === false }]}
                        set:html={marked.parse(post.body_markdown ?? '')}
                      />
                    )}

                    {/* Link collection display for inline posts (legacy thoughts with links) */}
                    {post.has_detail_page === false && post.links && post.links.length > 0 && (
                      <div class="post-links-section">
                        <div class="post-links-header">
                          <h3 class="post-links-title">Links from this collection</h3>
                          <span class="post-links-count">{post.links.length} link{post.links.length !== 1 ? 's' : ''}</span>
                        </div>

                        <div class="post-links-grid">
                          {post.links.map((link) => (
                            <LinkCard link={{ ...link, dateAdded: new Date(link.date_added) }} variant="minimal" />
                          ))}
                        </div>
                      </div>
                    )}

                    {post.tags && post.tags.length > 0 && (
                      <div class="post-tags">
                        {post.tags.map((tag) => (
                          <Badge href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
                        ))}
                      </div>
                    )}

                    {(post.reading_time || post.has_detail_page !== false) && (
                      <div class="post-meta">
                        {post.reading_time && (
                          <span class="post-reading-time">{post.reading_time} min read</span>
                        )}

                        {post.has_detail_page !== false && (
                          <Button href={`/blog/${post.slug}`} variant="primary" size="md">
                            {post.excerpt ? 'Read the full story →' : 'Continue reading →'}
                          </Button>
                        )}
                      </div>
                    )}
                  </Card>
                )
              ))}
            </div>
          </section>
        )}

        {/* Featured Links Section - only on page 1 */}
        {allLinks.length > 0 && page.currentPage === 1 && (
          <section id="featured-links" class="featured-links-section">
            <div class="featured-links-header">
              <h2 class="section-heading">recent links</h2>
              <Button href="/blog/links" variant="ghost" size="sm">
                View all {totalLinks} links →
              </Button>
            </div>
            <div class="featured-links-grid">
              {allLinks.map((link) => (
                <LinkCard link={link} variant="minimal" showSourceInfo={true} />
              ))}
            </div>
          </section>
        )}

        {/* Pagination Navigation */}
        {(page.url.prev || page.url.next) && (
          <nav class="pagination" aria-label="Blog pagination">
            {page.url.prev ? (
              <a href={page.url.prev} class="pagination-link prev">
                ← Newer Posts
              </a>
            ) : (
              <span class="pagination-link disabled">← Newer Posts</span>
            )}
            <span class="pagination-info">
              Page {page.currentPage} of {page.lastPage}
            </span>
            {page.url.next ? (
              <a href={page.url.next} class="pagination-link next">
                Older Posts →
              </a>
            ) : (
              <span class="pagination-link disabled">Older Posts →</span>
            )}
          </nav>
        )}

        {/* Empty state if no posts */}
        {page.total === 0 && (
          <Card class="empty-state">
            <div class="empty-message">
              <Badge>coming soon</Badge>
              <p>No blog posts published yet. Check back soon!</p>
            </div>
          </Card>
        )}
      </div>

      {/* Sidebar */}
      <aside class="sidebar">
        <h2 class="sidebar-heading">
          Related Links
          {totalLinks > 0 && (
            <a href="/blog/links" class="browse-all-link">
              (Browse all {totalLinks} →)
            </a>
          )}
        </h2>

        {/* Dynamic Collection Widgets */}
        {collectionPostsWithLinks.map((collection) => (
          collection.aggregatedLinks && collection.aggregatedLinks.length > 0 && (
            <CollectionWidget
              title={collection.title}
              description={collection.description}
              links={collection.aggregatedLinks}
              linkLimit={4}
              viewAllHref={`/blog/${collection.slug}`}
            />
          )
        ))}
      </aside>
    </div>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';
  @import '../../styles/backgrounds.css';

  /* Clean, traditional blog styling */
  .blog-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-3xl) var(--page-gutter);
    position: relative;
    overflow: hidden; /* Required for animated backgrounds */
  }

  .blog-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 10; /* Above animated backgrounds */
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-3xl);
    align-items: start;
  }

  .main-content {
    min-width: 0; /* Prevents grid blowout */
  }

  .sidebar {
    position: sticky;
    top: var(--space-3xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .sidebar-heading {
    font-family: var(--font-family);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0;
    padding-bottom: var(--space-md);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
    letter-spacing: var(--tracking-tight);
  }

  /* Section Styles */
  .blog-header-section {
    position: relative;
    margin: var(--space-2xl) 0;
  }

  .featured-posts-section,
  .archive-posts-section {
    position: relative;
    margin: var(--space-xl) 0;
  }

  .archive-posts-section {
    margin-top: var(--space-3xl);
    padding-top: var(--space-3xl);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .section-heading {
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin: 0 0 var(--space-xl) 0;
  }

  .blog-header {
    text-align: left;
    padding-bottom: var(--space-xl);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .blog-header :global(.badge) {
    margin-bottom: var(--space-md);
  }

  /* Tag Cloud Styles */
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .tag-cloud-label {
    font-family: var(--font-family);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    font-weight: var(--font-medium);
    margin-right: var(--space-xs);
  }

  .tag-cloud-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: var(--space-sm) var(--space-md);
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--radius-full);
    text-decoration: none;
    font-family: var(--font-family);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    transition: all var(--duration-base) var(--ease-out);
    box-shadow: var(--shadow-sm) var(--accent-secondary);
  }

  .tag-cloud-item:hover {
    background: var(--accent-primary);
    color: var(--text-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md) var(--accent-secondary);
  }

  .tag-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 var(--space-xs);
    background: var(--gradient-primary-light);
    color: var(--text-primary);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border: var(--border-width) solid var(--accent-secondary);
  }

  .tag-cloud-item:hover .tag-count {
    background: var(--accent-secondary);
    color: var(--bg-dark);
  }

  /* Browse all links */
  .browse-all-link {
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-secondary);
    text-decoration: none;
    margin-left: var(--space-sm);
    transition: color 0.2s ease;
  }

  .browse-all-link:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  /* Featured Links Section */
  .featured-links-section {
    position: relative;
    margin: var(--space-xl) 0;
  }

  .featured-links-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .featured-links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  /* Posts Header */
  .posts-header {
    margin-bottom: var(--space-xl);
  }

  /* Featured Posts Styles */
  .featured-posts {
    display: grid;
    gap: var(--space-3xl);
  }

  .featured-post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    transform: var(--rotation-sm);
    padding: var(--space-2xl);
  }

  .featured-post-card:nth-child(even) {
    transform: var(--rotation-sm);
  }

  /* Thought Posts - subtle visual distinction */
  .featured-post-card[data-post-type="thought"] {
    border-left: 3px solid var(--accent-primary);
    padding-left: calc(var(--space-2xl) - 3px); /* Maintain alignment */
  }

  /* Minimal Collection Card */
  .collection-card-minimal {
    padding: var(--space-lg) var(--space-xl);
  }

  .collection-card-link {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    text-decoration: none;
    color: inherit;
    transition: all var(--duration-base) var(--ease-out);
  }

  .collection-card-link:hover {
    color: var(--accent-primary);
  }

  .collection-card-minimal .collection-title {
    font-family: var(--font-family-system);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    white-space: nowrap;
  }

  .collection-card-minimal .collection-description {
    font-family: var(--font-family);
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .collection-card-link {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .collection-card-minimal .collection-description {
      white-space: normal;
    }
  }

  /* Archive Posts Styles */
  .archive-posts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .archive-post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    transform: var(--rotation-sm);
    transition: all var(--duration-base) var(--ease-out);
  }

  .archive-post-card:nth-child(even) {
    transform: var(--rotation-sm);
  }

  .archive-post-card:hover {
    transform: scale(1.05);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
    z-index: 5;
  }

  .post-date {
    display: block;
    color: var(--text-secondary);
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: var(--tracking-wide);
  }

  .post-title {
    font-family: var(--font-family-system);
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-md) 0;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .post-title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .post-title-link:hover {
    color: var(--accent-primary);
  }

  .post-title-text {
    color: var(--text-primary);
  }

  .collection-badge {
    margin-left: var(--space-sm);
  }

  .post-description {
    color: var(--text-secondary);
    font-family: var(--font-family);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    margin: 0;
    font-style: italic;
    border-left: 3px solid var(--accent-primary);
    padding-left: var(--space-md);
  }

  /* Hero image styles */
  .post-hero-image {
    margin: var(--space-lg) 0;
    border-radius: var(--border-radius);
    overflow: hidden;
    border: var(--border-width) solid var(--accent-primary);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
  }

  .post-hero-image img,
  .post-hero-image video {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .post-hero-link {
    display: block;
    overflow: hidden;
  }

  .post-hero-link:hover img,
  .post-hero-link:hover video {
    transform: scale(1.05);
  }

  .post-excerpt {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Content Preview Styles */
  .post-content-preview {
    color: var(--text-primary);
    font-family: var(--font-family);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: var(--space-lg) 0;
    position: relative;
    max-height: 400px;
    overflow: hidden;
  }

  .post-excerpt-preview {
    color: var(--text-primary);
    font-family: var(--font-family);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: var(--space-lg) 0;
  }

  .post-content-preview::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to bottom, transparent, var(--bg-secondary));
    pointer-events: none;
  }

  /* Full content for posts without detail pages */
  .post-content-preview.full-content {
    max-height: none;
