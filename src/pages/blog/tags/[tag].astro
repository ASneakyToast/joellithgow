---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@components/common/BaseLayout.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';

export const getStaticPaths = (async () => {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  // Get all unique tags
  const allTags = new Set<string>();
  allPosts.forEach((post) => {
    post.data.tags?.forEach((tag) => allTags.add(tag));
  });

  // Create a path for each tag
  return Array.from(allTags).map((tag) => {
    const postsWithTag = allPosts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

    return {
      params: { tag },
      props: { posts: postsWithTag, tag },
    };
  });
}) satisfies GetStaticPaths;

const { posts, tag } = Astro.props;

const pageTitle = `Posts tagged "${tag}"`;
const pageDescription = `All blog posts tagged with ${tag}.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="tag-posts-container">
    <div class="tag-posts-wrapper">
      <header class="tag-header">
        <Badge>tag</Badge>
        <h1 class="tag-title">#{tag}</h1>
        <p class="tag-description">
          {posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged with <strong>{tag}</strong>
        </p>
        <div class="nav-links">
          <Button href="/blog" variant="ghost" size="sm">← Back to Blog</Button>
          <Button href="/blog/tags" variant="ghost" size="sm">View All Tags</Button>
        </div>
      </header>

      <div class="blog-posts">
        {posts.map((post) => (
          <Card variant="interactive" interactive as="article" class="blog-post-card">
            <time
              datetime={post.data.publishDate.toISOString()}
              class="post-date"
            >
              {post.data.publishDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>

            <h2 class="post-title">
              <a
                href={`/blog/${post.slug}`}
                class="post-title-link"
              >
                {post.data.title}
              </a>
            </h2>

            <p class="post-excerpt">
              {post.data.description}
            </p>

            {post.data.tags && post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((postTag) => (
                  <Badge
                    href={`/blog/tags/${postTag}`}
                    variant={postTag === tag ? 'default' : 'secondary'}
                    size="sm"
                  >
                    #{postTag}
                  </Badge>
                ))}
              </div>
            )}

            <div class="post-meta">
              <span class="post-author">
                By {post.data.author}
                {post.data.readingTime && (
                  <span> • {post.data.readingTime} min read</span>
                )}
              </span>

              <Button href={`/blog/${post.slug}`} variant="ghost" size="sm">
                Read more →
              </Button>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  @import '../../../styles/tokens.css';
  @import '../../../styles/themes.css';

  .tag-posts-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-3xl) var(--space-xl);
  }

  .tag-posts-wrapper {
    max-width: var(--content-normal);
    margin: 0 auto;
  }

  .tag-header {
    text-align: left;
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--gradient-primary-subtle);
  }

  .tag-header :global(.badge) {
    margin-bottom: var(--space-md);
  }

  .tag-title {
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    margin: var(--space-sm) 0 var(--space-md) 0;
    color: var(--accent-primary);
    letter-spacing: var(--tracking-tight);
  }

  .tag-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-md) 0;
  }

  .nav-links {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .blog-posts {
    display: grid;
    gap: var(--space-2xl);
  }

  .blog-post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .post-date {
    display: block;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: var(--tracking-wide);
  }

  .post-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    margin: 0;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .post-title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .post-title-link:hover {
    color: var(--accent-primary);
  }

  .post-excerpt {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--gradient-primary-subtle);
  }

  .post-author {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .tag-posts-container {
      padding: var(--space-xl) var(--space-lg);
    }

    .tag-header {
      margin-bottom: var(--space-xl);
      padding-bottom: var(--space-lg);
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .tag-posts-container {
      padding: var(--space-lg) var(--space-md);
    }

    .post-title {
      font-size: var(--text-xl);
    }

    .post-excerpt {
      font-size: var(--text-sm);
    }
  }
</style>
