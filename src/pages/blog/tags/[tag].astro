---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';

export const getStaticPaths = (async () => {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  // Get all unique tags
  const allTags = new Set<string>();
  allPosts.forEach((post) => {
    post.data.tags?.forEach((tag) => allTags.add(tag));
  });

  // Create a path for each tag
  return Array.from(allTags).map((tag) => {
    const postsWithTag = allPosts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

    return {
      params: { tag },
      props: { posts: postsWithTag, tag },
    };
  });
}) satisfies GetStaticPaths;

const { posts, tag } = Astro.props;

// Render markdown content for all posts
const postsWithContent = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await post.render();
    return { post, Content };
  })
);

const pageTitle = `Posts tagged "${tag}"`;
const pageDescription = `All blog posts tagged with ${tag}.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="blog-container animated-bg bg-accent-editorial">
    <div class="blog-wrapper">
      {/* Main Content Column */}
      <div class="main-content">
        {/* Back navigation */}
        <nav class="breadcrumb-nav">
          <Button href="/blog" variant="ghost" size="sm">← Back to Blog</Button>
        </nav>

        <header class="tag-header">
          <h1 class="tag-title">#{tag}</h1>
        </header>

        <section class="tag-posts-section">
          <h2 class="section-heading">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</h2>
          <div class="blog-posts">
        {postsWithContent.map(({ post, Content }) => (
          <Card variant="flat" as="article" class="blog-post-card">
            <time
              datetime={post.data.publishDate.toISOString()}
              class="post-date"
            >
              {post.data.publishDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>

            <h2 class="post-title">
              {post.data.hasDetailPage !== false ? (
                <a
                  href={`/blog/${post.slug}`}
                  class="post-title-link"
                >
                  {post.data.title}
                </a>
              ) : (
                <span class="post-title-text">{post.data.title}</span>
              )}
              {post.data.category === 'link-collection' && (
                <Badge variant="tertiary" size="sm" class="link-collection-badge">
                  {post.data.links?.length || 0} links
                </Badge>
              )}
            </h2>

            <p class="post-description">
              {post.data.description}
            </p>

            {/* Render actual content preview */}
            <div class:list={['post-content-preview', { 'full-content': post.data.hasDetailPage === false }]}>
              <Content />
            </div>

            {/* Link collection display for inline posts */}
            {post.data.hasDetailPage === false && post.data.links && post.data.links.length > 0 && (
              <div class="post-links-section">
                <div class="post-links-header">
                  <h3 class="post-links-title">Links from this collection</h3>
                  <span class="post-links-count">{post.data.links.length} link{post.data.links.length !== 1 ? 's' : ''}</span>
                </div>

                <div class="post-links-grid">
                  {post.data.links.map((link) => (
                    <article class="post-link-card">
                      <div class="post-link-header">
                        {link.category && (
                          <span class="post-link-category">{link.category}</span>
                        )}
                        <time class="post-link-date">
                          {link.dateAdded.toLocaleDateString('en-US', {
                            month: 'short',
                            day: 'numeric'
                          })}
                        </time>
                      </div>

                      <h4 class="post-link-title">
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class="post-link-url">
                          {link.title}
                        </a>
                      </h4>

                      <p class="post-link-description">
                        {link.description}
                      </p>

                      {link.tags && link.tags.length > 0 && (
                        <div class="post-link-tags">
                          {link.tags.map((linkTag) => (
                            <span class="post-link-tag">#{linkTag}</span>
                          ))}
                        </div>
                      )}
                    </article>
                  ))}
                </div>
              </div>
            )}

            {post.data.tags && post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((postTag) => (
                  <Badge
                    href={`/blog/tags/${postTag}`}
                    variant={postTag === tag ? 'default' : 'secondary'}
                    size="sm"
                  >
                    #{postTag}
                  </Badge>
                ))}
              </div>
            )}

            <div class="post-meta">
              <span class="post-author">
                By {post.data.author}
                {post.data.readingTime && (
                  <span> • {post.data.readingTime} min read</span>
                )}
              </span>

              {post.data.hasDetailPage !== false && (
                <Button href={`/blog/${post.slug}`} variant="primary" size="md">
                  Continue reading →
                </Button>
              )}
            </div>
          </Card>
        ))}
          </div>
        </section>
      </div>

      {/* Sidebar */}
      <aside class="sidebar">
        {/* Could add tag-specific info here in the future */}
      </aside>
    </div>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../../styles/tokens.css';
  @import '../../../styles/themes.css';
  @import '../../../styles/backgrounds.css';

  /* Clean, traditional blog styling */
  .blog-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-3xl) var(--page-gutter);
    position: relative;
    overflow: hidden; /* Required for animated backgrounds */
  }

  .blog-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 10; /* Above animated backgrounds */
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-3xl);
    align-items: start;
  }

  .main-content {
    min-width: 0; /* Prevents grid blowout */
  }

  .sidebar {
    position: sticky;
    top: var(--space-3xl);
  }

  /* Breadcrumb navigation */
  .breadcrumb-nav {
    margin-bottom: var(--space-xl);
  }

  .tag-header {
    text-align: left;
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--gradient-primary-subtle);
  }

  .tag-title {
    font-size: var(--heading-xl);
    font-weight: var(--font-bold);
    margin: var(--space-sm) 0;
    color: var(--accent-primary);
    letter-spacing: var(--tracking-tight);
  }

  .tag-posts-section {
    position: relative;
    margin: var(--space-xl) 0;
  }

  .section-heading {
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-xl) 0;
    letter-spacing: var(--tracking-tight);
  }

  .blog-posts {
    display: grid;
    gap: var(--space-3xl);
  }

  .blog-post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding: var(--space-2xl);
  }

  .post-date {
    display: block;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: var(--tracking-wide);
  }

  .post-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    margin: 0;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .post-title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .post-title-link:hover {
    color: var(--accent-primary);
  }

  .post-title-text {
    color: var(--text-primary);
  }

  .link-collection-badge {
    margin-left: var(--space-sm);
  }

  .post-description {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    margin: 0;
    font-style: italic;
    border-left: 3px solid var(--accent-primary);
    padding-left: var(--space-md);
  }

  .post-excerpt {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Content Preview Styles */
  .post-content-preview {
    color: var(--text-primary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: var(--space-lg) 0;
    position: relative;
    max-height: 400px;
    overflow: hidden;
  }

  .post-content-preview::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to bottom, transparent, var(--bg-primary));
    pointer-events: none;
  }

  .post-content-preview.full-content {
    max-height: none;
    overflow: visible;
  }

  .post-content-preview.full-content::after {
    display: none;
  }

  /* Style markdown content in preview */
  .post-content-preview :global(h1),
  .post-content-preview :global(h2),
  .post-content-preview :global(h3),
  .post-content-preview :global(h4) {
    color: var(--text-primary);
    font-weight: var(--font-bold);
    margin: var(--space-lg) 0 var(--space-sm) 0;
    line-height: var(--leading-tight);
  }

  .post-content-preview :global(h2) {
    font-size: var(--text-xl);
    color: var(--accent-primary);
  }

  .post-content-preview :global(h3) {
    font-size: var(--text-lg);
  }

  .post-content-preview :global(p) {
    margin: var(--space-md) 0;
  }

  .post-content-preview :global(a) {
    color: var(--accent-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-secondary);
  }

  .post-content-preview :global(strong) {
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .post-content-preview :global(em) {
    font-style: italic;
  }

  .post-content-preview :global(ul),
  .post-content-preview :global(ol) {
    margin: var(--space-md) 0;
    padding-left: var(--space-xl);
  }

  .post-content-preview :global(li) {
    margin: var(--space-xs) 0;
  }

  .post-content-preview :global(code) {
    background: var(--gradient-secondary-light);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .post-content-preview :global(pre) {
    display: none;
  }

  .post-content-preview :global(img) {
    display: none;
  }

  .post-content-preview.full-content :global(pre) {
    display: block;
    background: var(--bg-dark);
    color: var(--text-light);
    padding: var(--space-xl);
    margin: var(--space-2xl) 0;
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md) var(--accent-secondary);
    overflow-x: auto;
  }

  .post-content-preview.full-content :global(pre code) {
    background: none;
    border: none;
    color: inherit;
    padding: 0;
  }

  .post-content-preview.full-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: var(--space-2xl) auto;
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
  }

  /* Link collection styles */
  .post-links-section {
    margin: var(--space-2xl) 0;
    padding-top: var(--space-xl);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .post-links-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xl);
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .post-links-title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin: 0;
  }

  .post-links-count {
    background: var(--accent-tertiary);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-sm) var(--accent-primary);
  }

  .post-links-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .post-link-card {
    background: var(--gradient-primary-light);
    border: var(--border-width) solid var(--accent-secondary);
    border-radius: var(--border-radius);
    padding: var(--space-lg);
    box-shadow: var(--shadow-md) var(--accent-primary);
    transition: all var(--duration-base) var(--ease-out);
  }

  .post-link-card:nth-child(even) {
    background: var(--gradient-secondary-light);
    border-color: var(--accent-tertiary);
  }

  .post-link-card:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-lg) var(--accent-primary);
  }

  .post-link-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
  }

  .post-link-category {
    background: var(--accent-primary);
    color: var(--text-light);
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--border-radius);
  }

  .post-link-date {
    background: var(--accent-tertiary);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--border-radius);
  }

  .post-link-title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-sm);
  }

  .post-link-url {
    color: var(--text-primary);
    text-decoration: none;
    transition: all var(--duration-base) var(--ease-out);
    position: relative;
  }

  .post-link-url:hover {
    color: var(--accent-primary);
  }

  .post-link-url::after {
    content: "↗";
    font-size: 0.8em;
    margin-left: var(--space-xs);
    opacity: 0.7;
    transition: all var(--duration-base) var(--ease-out);
  }

  .post-link-url:hover::after {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .post-link-description {
    color: var(--text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
  }

  .post-link-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .post-link-tag {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-xs);
    border: var(--border-width) solid var(--accent-secondary);
    border-radius: var(--border-radius);
    font-weight: var(--font-bold);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--gradient-primary-subtle);
  }

  .post-author {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Responsive design */
  @media (max-width: 1024px) {
    .blog-wrapper {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .sidebar {
      position: relative;
      top: 0;
    }
  }

  @media (max-width: 768px) {
    .blog-container {
      padding: var(--space-xl) var(--page-gutter);
    }

    .tag-header {
      padding-bottom: var(--space-lg);
    }

    .tag-title {
      font-size: var(--heading-lg);
    }

    .blog-post-card {
      padding: var(--space-xl);
    }

    .post-content-preview {
      max-height: 300px;
      font-size: var(--text-sm);
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .blog-container {
      padding: var(--space-lg) var(--space-md);
    }

    .blog-post-card {
      padding: var(--space-lg);
    }

    .post-title {
      font-size: var(--text-xl);
    }

    .post-description {
      font-size: var(--text-base);
    }

    .post-excerpt {
      font-size: var(--text-sm);
    }

    .post-content-preview {
      max-height: 250px;
    }
  }

  /* Theme toggle button */
  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  @media (max-width: 768px) {
    .theme-toggle-button {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }
</style>
