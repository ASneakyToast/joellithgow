---
import { marked } from 'marked';
import { fetchBlogPosts } from '@lib/astraeus';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import LinkCard from '@components/blog/LinkCard.astro';

export const getStaticPaths = (async () => {
  const allPosts = await fetchBlogPosts();

  // Get all unique tags from posts
  const allTags = new Set<string>();
  allPosts.forEach((post) => {
    post.tags?.forEach((tag) => allTags.add(tag));
  });

  // Also get tags from links
  allPosts.forEach((post) => {
    post.links?.forEach((link) => {
      link.tags?.forEach((tag: string) => allTags.add(tag));
    });
  });

  // Create a path for each tag
  return Array.from(allTags).map((tag) => {
    const postsWithTag = allPosts
      .filter((post) => post.tags?.includes(tag))
      .sort((a, b) => new Date(b.publish_date).valueOf() - new Date(a.publish_date).valueOf());

    // Get all links with this tag
    const linksWithTag = allPosts
      .flatMap((post) =>
        post.links
          ?.filter((link) => link.tags?.includes(tag))
          .map((link) => ({
            ...link,
            dateAdded: new Date(link.date_added),
            sourcePost: {
              title: post.title,
              slug: post.slug,
              publishDate: new Date(post.publish_date),
              author: post.author,
            },
          })) || []
      )
      .sort((a, b) => new Date(b.date_added).valueOf() - new Date(a.date_added).valueOf());

    return {
      params: { tag },
      props: { posts: postsWithTag, links: linksWithTag, tag },
    };
  });
}) satisfies GetStaticPaths;

const { posts, links, tag } = Astro.props;

const pageTitle = `Posts tagged "${tag}"`;
const pageDescription = `All blog posts tagged with ${tag}.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="blog-container animated-bg bg-accent-editorial">
    <div class="blog-wrapper">
      {/* Main Content Column */}
      <div class="main-content">
        {/* Back navigation */}
        <nav class="breadcrumb-nav">
          <Button href="/blog" variant="ghost" size="sm">← Back to Blog</Button>
        </nav>

        <header class="tag-header">
          <h1 class="tag-title">#{tag}</h1>
        </header>

        <section class="tag-posts-section">
          <h2 class="section-heading">
            {posts.length} {posts.length === 1 ? 'post' : 'posts'}
            {links.length > 0 && <span class="section-heading-separator">•</span>}
            {links.length > 0 && <span>{links.length} {links.length === 1 ? 'link' : 'links'}</span>}
          </h2>
          <div class="blog-posts">
        {posts.map((post) => (
          <Card variant="flat" as="article" class="blog-post-card">
            <time
              datetime={new Date(post.publish_date).toISOString()}
              class="post-date"
            >
              {new Date(post.publish_date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>

            <h2 class="post-title">
              {post.has_detail_page !== false ? (
                <a
                  href={`/blog/${post.slug}`}
                  class="post-title-link"
                >
                  {post.title}
                </a>
              ) : (
                <span class="post-title-text">{post.title}</span>
              )}
              {post.post_type === 'collection' && (
                <Badge variant="tertiary" size="sm" class="collection-badge">
                  {post.links?.length || 0} links
                </Badge>
              )}
            </h2>

            <p class="post-description">
              {post.description}
            </p>

            {/* Render actual content preview */}
            <div
              class:list={['post-content-preview', { 'full-content': post.has_detail_page === false }]}
              set:html={marked.parse(post.body_markdown ?? '')}
            />

            {/* Link collection display for inline posts */}
            {post.has_detail_page === false && post.links && post.links.length > 0 && (
              <div class="post-links-section">
                <div class="post-links-header">
                  <h3 class="post-links-title">Links from this collection</h3>
                  <span class="post-links-count">{post.links.length} link{post.links.length !== 1 ? 's' : ''}</span>
                </div>

                <div class="post-links-grid">
                  {post.links.map((link) => (
                    <LinkCard link={{ ...link, dateAdded: new Date(link.date_added) }} variant="minimal" />
                  ))}
                </div>
              </div>
            )}

            {post.tags && post.tags.length > 0 && (
              <div class="post-tags">
                {post.tags.map((postTag) => (
                  <Badge
                    href={`/blog/tags/${postTag}`}
                    variant={postTag === tag ? 'default' : 'secondary'}
                    size="sm"
                  >
                    #{postTag}
                  </Badge>
                ))}
              </div>
            )}

            <div class="post-meta">
              <span class="post-author">
                By {post.author}
                {post.reading_time && (
                  <span> • {post.reading_time} min read</span>
                )}
              </span>

              {post.has_detail_page !== false && (
                <Button href={`/blog/${post.slug}`} variant="primary" size="md">
                  Continue reading →
                </Button>
              )}
            </div>
          </Card>
        ))}
          </div>
        </section>

        {/* Links section */}
        {links.length > 0 && (
          <section class="tag-links-section">
            <div class="links-grid">
              {links.map((link) => (
                <div class="link-item">
                  <LinkCard link={link} variant="minimal" showSourceInfo={true} />
                </div>
              ))}
            </div>
          </section>
        )}
      </div>

      {/* Sidebar */}
      <aside class="sidebar">
        {/* Could add tag-specific info here in the future */}
      </aside>
    </div>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../../styles/tokens.css';
  @import '../../../styles/themes.css';
  @import '../../../styles/backgrounds.css';

  /* Clean, traditional blog styling */
  .blog-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-3xl) var(--page-gutter);
    position: relative;
    overflow: hidden; /* Required for animated backgrounds */
  }

  .blog-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 10; /* Above animated backgrounds */
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-3xl);
    align-items: start;
  }

  .main-content {
    min-width: 0; /* Prevents grid blowout */
  }

  .sidebar {
    position: sticky;
    top: var(--space-3xl);
  }

  /* Breadcrumb navigation */
  .breadcrumb-nav {
    margin-bottom: var(--space-xl);
  }

  .tag-header {
    text-align: left;
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--gradient-primary-subtle);
  }

  .tag-title {
    font-size: var(--heading-xl);
    font-weight: var(--font-bold);
    margin: var(--space-sm) 0;
    color: var(--accent-primary);
    letter-spacing: var(--tracking-tight);
  }

  .tag-posts-section {
    position: relative;
    margin: var(--space-xl) 0;
  }

  .section-heading {
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-xl) 0;
    letter-spacing: var(--tracking-tight);
  }

  .section-heading-separator {
    margin: 0 var(--space-sm);
    color: var(--text-secondary);
  }

  .blog-posts {
    display: grid;
    gap: var(--space-3xl);
  }

  .blog-post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding: var(--space-2xl);
  }

  .post-date {
    display: block;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: var(--tracking-wide);
  }

  .post-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    margin: 0;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .post-title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .post-title-link:hover {
    color: var(--accent-primary);
  }

  .post-title-text {
    color: var(--text-primary);
  }

  .collection-badge {
    margin-left: var(--space-sm);
  }

  .post-description {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    margin: 0;
    font-style: italic;
    border-left: 3px solid var(--accent-primary);
    padding-left: var(--space-md);
  }

  .post-excerpt {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Content Preview Styles */
  .post-content-preview {
    color: var(--text-primary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: var(--space-lg) 0;
    position: relative;
    max-height: 400px;
    overflow: hidden;
  }

  .post-content-preview::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to bottom, transparent, var(--bg-primary));
    pointer-events: none;
  }

  .post-content-preview.full-content {
    max-height: none;
    overflow: visible;
  }

  .post-content-preview.full-content::after {
    display: none;
  }

  /* Style markdown content in preview */
  .post-content-preview :global(h1),
  .post-content-preview :global(h2),
  .post-content-preview :global(h3),
  .post-content-preview :global(h4) {
    color: var(--text-primary);
    font-weight: var(--font-bold);
    margin: var(--space-lg) 0 var(--space-sm) 0;
    line-height: var(--leading-tight);
  }

  .post-content-preview :global(h2) {
    font-size: var(--text-xl);
    color: var(--accent-primary);
  }

  .post-content-preview :global(h3) {
    font-size: var(--text-lg);
  }

  .post-content-preview :global(p) {
    margin: var(--space-md) 0;
  }

  .post-content-preview :global(a) {
    color: var(--accent-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-secondary);
  }

  .post-content-preview :global(strong) {
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .post-content-preview :global(em) {
    font-style: italic;
  }

  .post-content-preview :global(ul),
  .post-content-preview :global(ol) {
    margin: var(--space-md) 0;
    padding-left: var(--space-xl);
  }

  .post-content-preview :global(li) {
    margin: var(--space-xs) 0;
  }

  .post-content-preview :global(code) {
    background: var(--gradient-secondary-light);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .post-content-preview :global(pre) {
    display: none;
  }

  .post-content-preview :global(img) {
    display: none;
  }

  .post-content-preview.full-content :global(pre) {
    display: block;
    background: var(--bg-dark);
    color: var(--text-light);
    padding: var(--space-xl);
    margin: var(--space-2xl) 0;
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md) var(--accent-secondary);
    overflow-x: auto;
  }

  .post-content-preview.full-content :global(pre code) {
    background: none;
    border: none;
    color: inherit;
    padding: 0;
  }

  .post-content-preview.full-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: var(--space-2xl) auto;
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
  }

  /* Link collection styles */
  .post-links-section {
    margin: var(--space-2xl) 0;
    padding-top: var(--space-xl);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .post-links-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xl);
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .post-links-title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin: 0;
  }

  .post-links-count {
    background: var(--accent-tertiary);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-sm) var(--accent-primary);
  }

  .post-links-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--gradient-primary-subtle);
  }

  .post-author {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Links section */
  .tag-links-section {
    position: relative;
    margin: var(--space-3xl) 0;
    padding-top: var(--space-3xl);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .links-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .link-item {
    position: relative;
  }

  .link-item::before {
    content: '🔗';
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    font-size: var(--text-lg);
    z-index: 1;
  }

  /* Responsive design */
  @media (max-width: 1024px) {
    .blog-wrapper {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .sidebar {
      position: relative;
      top: 0;
    }
  }

  @media (max-width: 768px) {
    .blog-container {
      padding: var(--space-xl) var(--page-gutter);
    }

    .tag-header {
      padding-bottom: var(--space-lg);
    }

    .tag-title {
      font-size: var(--heading-lg);
    }

    .blog-post-card {
      padding: var(--space-xl);
    }

    .post-content-preview {
      max-height: 300px;
      font-size: var(--text-sm);
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .blog-container {
      padding: var(--space-lg) var(--space-md);
    }

    .blog-post-card {
      padding: var(--space-lg);
    }

    .post-title {
      font-size: var(--text-xl);
    }

    .post-description {
      font-size: var(--text-base);
    }

    .post-excerpt {
      font-size: var(--text-sm);
    }

    .post-content-preview {
      max-height: 250px;
    }
  }

  /* Theme toggle button */
  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  @media (max-width: 768px) {
    .theme-toggle-button {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }
</style>
