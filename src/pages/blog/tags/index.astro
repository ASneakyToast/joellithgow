---
import { getCollection } from 'astro:content';
import BaseLayout from '@components/common/BaseLayout.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';

// Get all blog posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// Extract and count all tags
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

// Sort tags by count (descending) then alphabetically
const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1]; // Sort by count first
  return a[0].localeCompare(b[0]); // Then alphabetically
});

const pageTitle = 'Blog Tags';
const pageDescription = 'Explore blog posts by topic and tag.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="tags-container">
    <div class="tags-wrapper">
      <header class="tags-header">
        <Badge>explore by topic</Badge>
        <h1 class="tags-title">Tags</h1>
        <p class="tags-description">{pageDescription}</p>
        <Button href="/blog" variant="ghost" size="sm">← Back to Blog</Button>
      </header>

      <div class="tags-grid">
        {sortedTags.map(([tag, count]) => (
          <Card variant="interactive" interactive href={`/blog/tags/${tag}`} class="tag-card">
            <span class="tag-name">#{tag}</span>
            <span class="tag-count">{count} {count === 1 ? 'post' : 'posts'}</span>
          </Card>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  @import '../../../styles/tokens.css';
  @import '../../../styles/themes.css';

  .tags-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-3xl) var(--space-xl);
  }

  .tags-wrapper {
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  .tags-header {
    text-align: left;
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--gradient-primary-subtle);
  }

  .tags-header :global(.badge) {
    margin-bottom: var(--space-md);
  }

  .tags-title {
    font-size: var(--heading-xl);
    font-weight: var(--font-bold);
    margin: var(--space-sm) 0 var(--space-md) 0;
    color: var(--text-primary);
    letter-spacing: var(--tracking-tight);
  }

  .tags-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-md) 0;
  }

  .tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-xl);
  }

  .tag-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .tag-name {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
  }

  .tag-count {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .tags-container {
      padding: var(--space-xl) var(--space-lg);
    }

    .tags-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .tags-container {
      padding: var(--space-lg) var(--space-md);
    }

    .tags-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
