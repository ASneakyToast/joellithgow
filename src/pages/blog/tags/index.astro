---
import { getCollection } from 'astro:content';
import BaseLayout from '@components/common/BaseLayout.astro';

// Get all blog posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// Extract and count all tags
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

// Sort tags by count (descending) then alphabetically
const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1]; // Sort by count first
  return a[0].localeCompare(b[0]); // Then alphabetically
});

const pageTitle = 'Blog Tags';
const pageDescription = 'Explore blog posts by topic and tag.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="tags-container">
    <div class="tags-wrapper">
      <header class="tags-header">
        <div class="badge">explore by topic</div>
        <h1 class="tags-title">Tags</h1>
        <p class="tags-description">{pageDescription}</p>
        <a href="/blog" class="back-link">← Back to Blog</a>
      </header>

      <div class="tags-grid">
        {sortedTags.map(([tag, count]) => (
          <a href={`/blog/tags/${tag}`} class="tag-card">
            <span class="tag-name">#{tag}</span>
            <span class="tag-count">{count} {count === 1 ? 'post' : 'posts'}</span>
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .tags-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: 3rem 2rem;
  }

  .tags-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .tags-header {
    text-align: left;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--gradient-primary-subtle);
  }

  .badge {
    display: inline-block;
    background: var(--gradient-primary-subtle);
    color: var(--accent-primary);
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    border-radius: 4px;
  }

  .tags-title {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 700;
    margin: 0.5rem 0 1rem 0;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .tags-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 0 1rem 0;
  }

  .back-link {
    display: inline-block;
    color: var(--accent-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent-secondary);
  }

  .tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .tag-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--gradient-primary-subtle);
    border-radius: 8px;
    padding: 1.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .tag-card:hover {
    border-color: var(--gradient-primary-dim);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
    transform: translateY(-2px);
  }

  .tag-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-primary);
  }

  .tag-count {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .tags-container {
      padding: 2rem 1.5rem;
    }

    .tags-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 1rem;
    }

    .tag-card {
      padding: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .tags-container {
      padding: 1.5rem 1rem;
    }

    .tags-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
