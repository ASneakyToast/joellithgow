---
import { getCollection } from 'astro:content';
import BaseLayout from '@components/common/BaseLayout.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';

const allPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// Sort posts by publish date (newest first)
const sortedPosts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// Calculate link collection stats
const linkCollectionPosts = allPosts.filter(post => post.data.links && post.data.links.length > 0);
const totalLinks = linkCollectionPosts.reduce((sum, post) => sum + (post.data.links?.length || 0), 0);

const pageTitle = "Blog";
const pageDescription = "Reflections on web development, AI tools, creative projects, and lessons learned along the way.";

// JSON-LD structured data for CollectionPage
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: 'https://joellithgow.com/blog',
  author: {
    '@type': 'Person',
    name: 'Joel Lithgow',
    url: 'https://joellithgow.com',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://joellithgow.com',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: 'https://joellithgow.com/blog',
      },
    ],
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="blog-container">
    <div class="blog-wrapper">
      <header class="blog-header">
        <Badge>reflections & insights</Badge>
        <h1 class="blog-title">Blog</h1>
        <p class="blog-description">{pageDescription}</p>
      </header>

      {/* Links collection showcase */}
      {totalLinks > 0 && (
        <Card variant="outlined" class="links-showcase">
          <div class="links-showcase-content">
            <p class="links-showcase-text">
              📎 {totalLinks} curated links from {linkCollectionPosts.length} collection{linkCollectionPosts.length !== 1 ? 's' : ''}
            </p>
            <Button href="/links" size="sm">
              Browse Links →
            </Button>
          </div>
        </Card>
      )}

      {sortedPosts.length > 0 ? (
        <div class="blog-posts">
          {sortedPosts.map((post) => (
            <Card variant="interactive" interactive as="article" class="blog-post-card">
              <time
                datetime={post.data.publishDate.toISOString()}
                class="post-date"
              >
                {post.data.publishDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>

              <h2 class="post-title">
                <a
                  href={`/blog/${post.slug}`}
                  class="post-title-link"
                >
                  {post.data.title}
                </a>
                {post.data.category === 'link-collection' && (
                  <Badge variant="tertiary" size="sm" class="link-collection-badge">
                    {post.data.links?.length || 0} links
                  </Badge>
                )}
              </h2>

              <p class="post-excerpt">
                {post.data.description}
              </p>

              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((tag) => (
                    <Badge href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
                  ))}
                </div>
              )}

              <div class="post-meta">
                <span class="post-author">
                  By {post.data.author}
                  {post.data.readingTime && (
                    <span> • {post.data.readingTime} min read</span>
                  )}
                </span>

                <Button href={`/blog/${post.slug}`} variant="ghost" size="sm">
                  Read more →
                </Button>
              </div>
            </Card>
          ))}
        </div>
      ) : (
        <Card class="empty-state">
          <div class="empty-message">
            <Badge>coming soon</Badge>
            <p>No blog posts published yet. Check back soon!</p>
          </div>
        </Card>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  /* Clean, traditional blog styling */
  .blog-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-3xl) var(--space-xl);
  }

  .blog-wrapper {
    max-width: var(--content-normal);
    margin: 0 auto;
  }

  .blog-header {
    text-align: left;
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--gradient-primary-subtle);
  }

  .blog-header :global(.badge) {
    margin-bottom: var(--space-md);
  }

  .blog-title {
    font-size: var(--heading-xl);
    font-weight: var(--font-bold);
    margin: var(--space-sm) 0 var(--space-md) 0;
    color: var(--text-primary);
    letter-spacing: var(--tracking-tight);
  }

  .blog-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Links showcase section */
  .links-showcase {
    margin: 0 0 var(--space-3xl) 0;
  }

  .links-showcase-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
  }

  .links-showcase-text {
    color: var(--text-secondary);
    margin: 0;
    font-size: var(--text-base);
  }

  .blog-posts {
    display: grid;
    gap: var(--space-2xl);
  }

  .blog-post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .post-date {
    display: block;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    letter-spacing: var(--tracking-wide);
  }

  .post-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    margin: 0;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .post-title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .post-title-link:hover {
    color: var(--accent-primary);
  }

  .link-collection-badge {
    margin-left: var(--space-sm);
  }

  .post-excerpt {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--gradient-primary-subtle);
  }

  .post-author {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-4xl) var(--space-xl);
    margin-top: var(--space-xl);
  }

  .empty-message :global(.badge) {
    margin-bottom: var(--space-md);
  }

  .empty-message p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .blog-container {
      padding: var(--space-xl) var(--space-lg);
    }

    .blog-header {
      margin-bottom: var(--space-xl);
      padding-bottom: var(--space-lg);
    }

    .blog-title {
      font-size: var(--heading-lg);
    }

    .blog-description {
      font-size: var(--text-base);
    }

    .links-showcase-content {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-md);
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .blog-container {
      padding: var(--space-lg) var(--space-md);
    }

    .post-title {
      font-size: var(--text-xl);
    }

    .post-excerpt {
      font-size: var(--text-sm);
    }
  }
</style>
