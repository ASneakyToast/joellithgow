---
import { getCollection } from 'astro:content';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import LinkCard from '@components/blog/LinkCard.astro';

// Get all blog posts that have links
const allPosts = await getCollection('blog', ({ data }) => {
  return !data.draft && data.links && data.links.length > 0;
});

// Aggregate all links from all posts
const allLinks = allPosts.flatMap(post =>
  post.data.links.map(link => ({
    ...link,
    sourcePost: {
      title: post.data.title,
      slug: post.slug,
      publishDate: post.data.publishDate,
      author: post.data.author
    }
  }))
);

// Sort links by date added (newest first)
const sortedLinks = allLinks.sort(
  (a, b) => new Date(b.dateAdded).valueOf() - new Date(a.dateAdded).valueOf()
);

// Get unique tags for filtering (sorted by frequency)
const tagCounts = allLinks.reduce((acc, link) => {
  link.tags?.forEach(tag => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const popularTags = Object.entries(tagCounts)
  .sort(([, a], [, b]) => b - a)
  .map(([tag]) => tag);

// Get some stats
const totalLinks = allLinks.length;
const totalPosts = allPosts.length;
const uniqueDomains = [...new Set(allLinks.map(link => {
  try {
    return new URL(link.url).hostname;
  } catch {
    return 'unknown';
  }
}))].length;

const pageTitle = "Link Collection";
const pageDescription = `Browse all ${totalLinks} links from ${totalPosts} blog posts. Discover curated resources, tools, and interesting finds.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="blog-container animated-bg bg-accent-editorial">
    <div class="blog-wrapper">
      {/* Main Content Column */}
      <div class="main-content">
        {/* Back navigation */}
        <nav class="breadcrumb-nav">
          <Button href="/blog" variant="ghost" size="sm">← Back to Blog</Button>
        </nav>

        <header class="links-header">
          <h1 class="links-title">Link Collection</h1>
          <p class="links-description">{pageDescription}</p>

          {/* Stats */}
          <div class="links-stats">
            <Card variant="outlined" class="stat-card">
              <span class="stat-number">{totalLinks}</span>
              <span class="stat-label">total links</span>
            </Card>
            <Card variant="outlined" class="stat-card">
              <span class="stat-number">{totalPosts}</span>
              <span class="stat-label">source posts</span>
            </Card>
            <Card variant="outlined" class="stat-card">
              <span class="stat-number">{uniqueDomains}</span>
              <span class="stat-label">unique domains</span>
            </Card>
          </div>
        </header>

        {/* Controls */}
        <div class="controls-wrapper">
          <Card variant="flat" class="links-controls">
            <div class="search-container">
              <input
                type="text"
                id="search-input"
                placeholder="Search links by title, description, or tags..."
                class="search-input"
              />
            </div>
          </Card>
        </div>

        {/* Tag filters */}
        {popularTags.length > 0 && (
          <div class="filters-wrapper">
          <Card variant="flat" class="tag-filters">
            <div class="tag-filters-inner">
              <Badge
                variant="default"
                size="md"
                class="tag-filter-badge active"
                data-tag=""
              >
                all ({totalLinks})
              </Badge>
              {popularTags.map(tag => (
                <Badge
                  variant="secondary"
                  size="md"
                  class="tag-filter-badge"
                  data-tag={tag}
                >
                  #{tag} ({tagCounts[tag]})
                </Badge>
              ))}
            </div>
          </Card>
          </div>
        )}

        {/* Links Grid */}
        {sortedLinks.length > 0 ? (
          <div class="links-grid" id="links-grid">
            {sortedLinks.map((link) => (
              <div class="link-item-wrapper" data-tags={link.tags?.join(' ') || ''}>
                <LinkCard link={link} variant="minimal" showSourceInfo={true} />
              </div>
            ))}
          </div>
        ) : (
          <Card class="empty-state">
            <div class="empty-message">
              <Badge>coming soon</Badge>
              <p>No links found. Check back as we add more curated content!</p>
              <Button href="/blog">Browse blog posts →</Button>
            </div>
          </Card>
        )}
      </div>

      {/* Sidebar */}
      <aside class="sidebar">
        {/* Could add link stats or popular tags here */}
      </aside>
    </div>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<script>
// Search and filter functionality
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const linksGrid = document.getElementById('links-grid');
  const linkItems = linksGrid?.querySelectorAll('.link-item-wrapper');
  const tagFilterBadges = document.querySelectorAll('.tag-filter-badge');

  let selectedTag = '';

  function filterLinks() {
    const searchTerm = searchInput?.value.toLowerCase() || '';

    linkItems?.forEach(item => {
      const linkElement = item as HTMLElement;
      const title = linkElement.querySelector('.link-title')?.textContent?.toLowerCase() || '';
      const description = linkElement.querySelector('.link-description')?.textContent?.toLowerCase() || '';
      const tags = linkElement.dataset.tags?.toLowerCase() || '';

      const matchesSearch = !searchTerm ||
        title.includes(searchTerm) ||
        description.includes(searchTerm) ||
        tags.includes(searchTerm);

      const matchesTag = !selectedTag || tags.includes(selectedTag.toLowerCase());

      if (matchesSearch && matchesTag) {
        linkElement.style.display = 'block';
      } else {
        linkElement.style.display = 'none';
      }
    });
  }

  searchInput?.addEventListener('input', filterLinks);

  // Tag filter badge handlers
  tagFilterBadges.forEach(badge => {
    badge.addEventListener('click', function(e) {
      e.preventDefault();
      const badgeElement = this as HTMLElement;
      selectedTag = badgeElement.dataset.tag || '';

      // Update active state
      tagFilterBadges.forEach(b => b.classList.remove('active'));
      badgeElement.classList.add('active');

      filterLinks();
    });
  });
});
</script>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';
  @import '../../styles/backgrounds.css';

  .blog-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-3xl) var(--page-gutter);
    position: relative;
    overflow: hidden;
  }

  .blog-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-3xl);
    align-items: start;
  }

  .main-content {
    min-width: 0;
  }

  .sidebar {
    position: sticky;
    top: var(--space-3xl);
  }

  .breadcrumb-nav {
    margin-bottom: var(--space-xl);
  }

  .links-header {
    text-align: left;
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .links-title {
    font-size: var(--heading-xl);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-md) 0;
    color: var(--text-primary);
    letter-spacing: var(--tracking-tight);
  }

  .links-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: 0 0 var(--space-xl) 0;
    line-height: var(--leading-relaxed);
  }

  .links-stats {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .stat-card {
    flex: 1;
    min-width: 120px;
    text-align: center;
    padding: var(--space-lg);
  }

  .stat-number {
    display: block;
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin-bottom: var(--space-xs);
  }

  .stat-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-transform: uppercase;
    font-weight: var(--font-medium);
    letter-spacing: var(--tracking-wide);
  }

  .controls-wrapper {
    margin-bottom: var(--space-xl);
  }

  .links-controls {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
    flex-wrap: wrap;
    padding: var(--space-xl);
  }

  .search-container {
    flex: 1;
    min-width: 0;
  }

  .search-input {
    width: 100%;
    padding: var(--space-md);
    border: var(--border-width) solid var(--accent-primary);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    border-radius: var(--border-radius);
    transition: all var(--duration-base) var(--ease-out);
    box-sizing: border-box;
  }

  .search-input:focus {
    outline: none;
    box-shadow: var(--shadow-md) var(--accent-secondary);
  }

  .search-input::placeholder {
    color: var(--text-secondary);
    font-style: italic;
  }

  .filters-wrapper {
    margin-bottom: var(--space-xl);
  }

  .tag-filters-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tag-filter-badge {
    cursor: pointer;
    transition: all var(--duration-base) var(--ease-out);
  }

  .tag-filter-badge:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md) var(--accent-secondary);
  }

  .tag-filter-badge.active {
    background: var(--accent-primary);
    color: var(--text-light);
    border-color: var(--accent-primary);
  }

  .links-grid {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-3xl);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-4xl) var(--space-xl);
    margin-top: var(--space-xl);
  }

  .empty-message :global(.badge) {
    margin-bottom: var(--space-md);
  }

  .empty-message p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin: var(--space-md) 0;
  }

  /* Theme toggle button */
  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  /* Responsive design */
  @media (max-width: 1024px) {
    .blog-wrapper {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .sidebar {
      position: relative;
      top: 0;
    }
  }

  @media (max-width: 768px) {
    .blog-container {
      padding: var(--space-xl) var(--page-gutter);
    }

    .links-header {
      margin-bottom: var(--space-xl);
    }

    .links-title {
      font-size: var(--heading-lg);
    }

    .links-stats {
      gap: var(--space-md);
    }

    .stat-card {
      min-width: 100px;
      padding: var(--space-md);
    }

    .stat-number {
      font-size: var(--text-2xl);
    }

    .links-controls {
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-lg);
    }

    .search-container {
      min-width: unset;
    }

    .tag-filters {
      padding: var(--space-lg);
    }

    .theme-toggle-button {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 480px) {
    .blog-container {
      padding: var(--space-lg) var(--space-md);
    }

    .links-stats {
      flex-direction: column;
    }

    .stat-card {
      min-width: unset;
    }

    .links-controls {
      padding: var(--space-md);
    }

    .tag-filters {
      padding: var(--space-md);
    }
  }
</style>
