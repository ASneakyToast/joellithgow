---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@components/common/BaseLayout.astro';
import Navigation from '@components/common/Navigation.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => {
    return !data.draft;
  });
  
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, 
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const { title, description, publishDate, author, tags, readingTime, image, links, category } = entry.data;

// JSON-LD structured data for BlogPosting
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: author,
    url: 'https://joellithgow.com',
  },
  datePublished: publishDate.toISOString(),
  dateModified: publishDate.toISOString(),
  keywords: tags?.join(', '),
  url: `https://joellithgow.com/blog/${entry.slug}`,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://joellithgow.com/blog/${entry.slug}`,
  },
  publisher: {
    '@type': 'Person',
    name: 'Joel Lithgow',
    url: 'https://joellithgow.com',
  },
};

if (image) {
  jsonLd['image'] = {
    '@type': 'ImageObject',
    url: new URL(image.src, Astro.url).href,
    description: image.alt || title,
  };
}
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  articlePublishedTime={publishDate.toISOString()}
  articleAuthor={author}
  articleTags={tags}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Navigation Component -->
  <Navigation />

  <main class="article-container">
    <div class="article-wrapper">
      {/* Back to blog link */}
      <nav class="article-nav">
        <Button href="/blog" variant="secondary" size="md" class="nav-back-btn">
          ← Back to blog
        </Button>
      </nav>

      <article class="blog-article">
        {/* Hero-style header with featured image */}
        {image && (
          <div class="article-hero">
            <img
              src={image.src}
              alt={image.alt}
              class="hero-image"
            />
            <div class="hero-overlay"></div>
          </div>
        )}

        {/* Article header */}
        <header class="article-header">
          <div class="article-meta-top">
            <time
              datetime={publishDate.toISOString()}
              class="article-date"
            >
              {publishDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          </div>

          <h1 class="article-title">{title}</h1>

          <p class="article-description">
            {description}
          </p>

          <div class="article-meta">
            <div class="author-info">
              <span>By {author}</span>
              {readingTime && (
                <span> • {readingTime} min read</span>
              )}
            </div>

            {tags && tags.length > 0 && (
              <div class="article-tags">
                {tags.map((tag) => (
                  <Badge href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
                ))}
              </div>
            )}
          </div>
        </header>

        {/* Article content */}
        <div class="article-content">
          <Content />
        </div>

        {/* Link collection display */}
        {links && links.length > 0 && (
          <section class="links-section">
            <div class="links-header">
              <h2 class="links-title">Links from this collection</h2>
              <div class="links-meta">
                <span class="links-count">{links.length} link{links.length !== 1 ? 's' : ''}</span>
              </div>
            </div>

            <div class="links-grid">
              {links.map((link) => (
                <article class="link-card">
                  <div class="link-header">
                    {link.category && (
                      <span class="link-category">{link.category}</span>
                    )}
                    <time class="link-date">
                      {link.dateAdded.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric'
                      })}
                    </time>
                  </div>

                  <h3 class="link-title">
                    <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-url">
                      {link.title}
                    </a>
                  </h3>

                  <p class="link-description">
                    {link.description}
                  </p>

                  {link.tags && link.tags.length > 0 && (
                    <div class="link-tags">
                      {link.tags.map((tag) => (
                        <span class="link-tag">#{tag}</span>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </div>

            <div class="links-footer">
              <p class="links-note">
                Curated links and resources from this post.
              </p>
            </div>
          </section>
        )}
      </article>

      {/* Footer navigation */}
      <footer class="article-footer">
        <nav class="footer-nav">
          <Button href="/blog" variant="tertiary" size="md" class="footer-nav-btn footer-nav-back">
            ← Back to all posts
          </Button>

          <Button href="/" variant="tertiary" size="md" class="footer-nav-btn footer-nav-home">
            Home →
          </Button>
        </nav>
      </footer>
    </div>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  /* Blog post styling aligned with design system */
  .article-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-2xl) var(--space-lg);
    position: relative;
  }

  .article-wrapper {
    max-width: var(--content-normal);
    margin: 0 auto;
    position: relative;
  }

  .article-nav {
    margin-bottom: var(--space-2xl);
  }

  .blog-article {
    background: var(--bg-secondary);
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
    position: relative;
    margin-bottom: var(--space-3xl);
    overflow: hidden;
  }

  /* Hero-style header */
  .article-hero {
    position: relative;
    width: 100%;
    height: 400px;
    overflow: hidden;
    margin: calc(var(--space-3xl) * -1) calc(var(--space-3xl) * -1) var(--space-3xl);
    border-bottom: var(--border-width) solid var(--accent-primary);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .blog-article:hover .hero-image {
    transform: scale(1.05);
  }

  .hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100px;
    background: linear-gradient(to top, var(--bg-secondary), transparent);
    pointer-events: none;
  }

  .article-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
    padding: 0 var(--space-3xl) var(--space-2xl);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .article-meta-top {
    margin-bottom: var(--space-lg);
  }

  .article-date {
    display: inline-block;
    background: var(--accent-tertiary);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-sm) var(--accent-primary);
  }

  .article-title {
    font-size: var(--heading-2xl);
    font-weight: var(--font-bold);
    margin: var(--space-lg) 0;
    color: var(--text-primary);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .article-description {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-2xl);
    font-style: italic;
  }

  .article-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .author-info {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-weight: var(--font-medium);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Article content styling */
  .article-content {
    position: relative;
    z-index: 2;
    line-height: var(--leading-relaxed);
    font-size: var(--text-lg);
  }

  .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4),
  .article-content :global(h5),
  .article-content :global(h6) {
    color: var(--text-primary);
    font-weight: var(--font-bold);
    margin: var(--space-2xl) 0 var(--space-md) 0;
    position: relative;
    letter-spacing: var(--tracking-tight);
  }

  .article-content :global(h1) {
    font-size: var(--heading-xl);
    color: var(--accent-primary);
  }

  .article-content :global(h2) {
    font-size: var(--heading-lg);
    color: var(--accent-primary);
    padding-bottom: var(--space-sm);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .article-content :global(h3) {
    font-size: var(--heading-md);
    color: var(--text-primary);
  }

  .article-content :global(h4),
  .article-content :global(h5),
  .article-content :global(h6) {
    font-size: var(--heading-sm);
    color: var(--text-primary);
  }

  .article-content :global(p) {
    margin: var(--space-lg) 0;
    color: var(--text-primary);
  }

  .article-content :global(a) {
    color: var(--accent-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-secondary);
    text-underline-offset: 3px;
    transition: all var(--duration-base) var(--ease-out);
  }

  .article-content :global(a:hover) {
    color: var(--accent-secondary);
    text-decoration-color: var(--accent-primary);
  }

  .article-content :global(strong) {
    color: var(--text-primary);
    font-weight: var(--font-bold);
  }

  .article-content :global(em) {
    color: var(--text-secondary);
    font-style: italic;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: var(--space-lg) 0;
    padding-left: var(--space-2xl);
  }

  .article-content :global(li) {
    margin: var(--space-sm) 0;
    color: var(--text-primary);
    line-height: var(--leading-relaxed);
  }

  .article-content :global(ul li::marker) {
    color: var(--accent-primary);
  }

  .article-content :global(ol li::marker) {
    color: var(--accent-secondary);
    font-weight: var(--font-bold);
  }

  .article-content :global(blockquote) {
    background: var(--gradient-primary-light);
    border-left: 4px solid var(--accent-primary);
    padding: var(--space-lg);
    margin: var(--space-2xl) 0;
    border-radius: var(--border-radius);
    font-style: italic;
    color: var(--text-primary);
  }

  .article-content :global(code) {
    background: var(--gradient-secondary-light);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-width) solid var(--accent-secondary);
    border-radius: var(--radius-sm);
    font-family: var(--font-family);
    font-weight: var(--font-medium);
    font-size: var(--text-sm);
  }

  .article-content :global(pre) {
    background: var(--bg-dark);
    color: var(--text-light);
    padding: var(--space-xl);
    margin: var(--space-2xl) 0;
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md) var(--accent-secondary);
    overflow-x: auto;
  }

  .article-content :global(pre code) {
    background: none;
    border: none;
    color: inherit;
    padding: 0;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: var(--space-2xl) auto;
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
    transition: all var(--duration-base) var(--ease-out);
  }

  .article-content :global(img:hover) {
    transform: scale(1.02);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
  }

  .article-content :global(.image-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    margin: var(--space-2xl) 0;
  }

  .article-content :global(.image-grid img) {
    margin: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-content :global(.image-row) {
    display: flex;
    gap: var(--space-lg);
    margin: var(--space-2xl) 0;
    flex-wrap: wrap;
  }

  .article-content :global(.image-row img) {
    margin: 0;
    flex: 1;
    min-width: 250px;
  }

  .article-content :global(hr) {
    border: none;
    height: var(--border-width);
    background: var(--gradient-primary-subtle);
    margin: var(--space-3xl) 0;
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-2xl) 0;
    background: var(--bg-secondary);
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md) var(--accent-secondary);
    overflow: hidden;
  }

  .article-content :global(th),
  .article-content :global(td) {
    padding: var(--space-md);
    text-align: left;
    border: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .article-content :global(th) {
    background: var(--accent-primary);
    color: var(--text-light);
    font-weight: var(--font-bold);
  }

  /* Link collection styles */
  .links-section {
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .links-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-2xl);
    gap: var(--space-2xl);
    flex-wrap: wrap;
  }

  .links-title {
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin: 0;
    flex: 1;
  }

  .links-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-md);
  }

  .links-count {
    background: var(--accent-tertiary);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-sm) var(--accent-primary);
  }

  .links-grid {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
  }

  .link-card {
    background: var(--gradient-primary-light);
    border: var(--border-width) solid var(--accent-secondary);
    border-radius: var(--border-radius);
    padding: var(--space-lg);
    box-shadow: var(--shadow-md) var(--accent-primary);
    transition: all var(--duration-base) var(--ease-out);
    position: relative;
  }

  .link-card:nth-child(even) {
    background: var(--gradient-secondary-light);
    border-color: var(--accent-tertiary);
  }

  .link-card:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-lg) var(--accent-primary);
  }

  .link-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
  }

  .link-category {
    background: var(--accent-primary);
    color: var(--text-light);
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--border-radius);
  }

  .link-date {
    background: var(--accent-tertiary);
    color: var(--bg-dark);
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--border-radius);
  }

  .link-title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-sm);
  }

  .link-url {
    color: var(--text-primary);
    text-decoration: none;
    transition: all var(--duration-base) var(--ease-out);
    position: relative;
  }

  .link-url:hover {
    color: var(--accent-primary);
  }

  .link-url::after {
    content: "↗";
    font-size: 0.8em;
    margin-left: var(--space-xs);
    opacity: 0.7;
    transition: all var(--duration-base) var(--ease-out);
  }

  .link-url:hover::after {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .link-description {
    color: var(--text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
  }

  .link-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .link-tag {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-xs);
    border: var(--border-width) solid var(--accent-secondary);
    border-radius: var(--border-radius);
    font-weight: var(--font-bold);
  }

  .links-footer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
    text-align: center;
  }

  .links-note {
    color: var(--text-secondary);
    font-style: italic;
    margin: 0;
    font-size: var(--text-sm);
  }


  .article-footer {
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
  }

  .footer-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .article-container {
      padding: var(--space-xl) var(--space-md);
    }

    .blog-article {
      padding: var(--space-2xl);
    }

    .article-hero {
      height: 300px;
      margin: calc(var(--space-2xl) * -1) calc(var(--space-2xl) * -1) var(--space-2xl);
    }

    .article-header {
      padding: 0 var(--space-md) var(--space-xl);
    }

    .article-title {
      font-size: var(--heading-xl);
    }

    .article-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }

    .article-content {
      font-size: var(--text-base);
    }

    .article-content :global(h1) {
      font-size: var(--heading-lg);
    }

    .article-content :global(h2) {
      font-size: var(--heading-md);
    }

    .article-content :global(img) {
      margin: var(--space-lg) auto;
    }

    .article-content :global(.image-row) {
      flex-direction: column;
    }

    .article-content :global(.image-row img) {
      min-width: 100%;
    }

    .article-content :global(.image-grid) {
      grid-template-columns: 1fr;
    }

    .links-header {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-md);
    }

    .links-title {
      text-align: center;
    }

    .links-meta {
      align-items: center;
    }

    .footer-nav {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (max-width: 480px) {
    .article-container {
      padding: var(--space-lg) var(--space-sm);
    }

    .blog-article {
      padding: var(--space-xl);
    }

    .article-hero {
      height: 250px;
      margin: calc(var(--space-xl) * -1) calc(var(--space-xl) * -1) var(--space-xl);
    }

    .article-header {
      padding: 0 var(--space-sm) var(--space-lg);
    }

    .article-title {
      font-size: var(--heading-lg);
    }

    .article-content {
      font-size: var(--text-sm);
    }

    .article-content :global(img) {
      margin: var(--space-md) auto;
      box-shadow: var(--shadow-md) var(--accent-secondary);
    }

    .links-title {
      font-size: var(--heading-md);
    }

    .link-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* Theme toggle button */
  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
