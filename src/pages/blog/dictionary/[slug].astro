---
import { marked } from 'marked';
import { fetchDefinitions } from '@lib/astraeus';
import type { AstraeusDocument, Definition } from '@lib/astraeus-types';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import LinkCard from '@components/blog/LinkCard.astro';
import '../../../styles/log.css';

export async function getStaticPaths() {
  const definitions = await fetchDefinitions();
  return definitions.map((def) => ({
    params: { slug: def.slug },
    props: { definition: def },
  }));
}

const { definition } = Astro.props as {
  definition: AstraeusDocument<Definition>;
};

const term = definition.term;
const publishDate = new Date(definition.publish_date);
const notesHtml = definition.personal_notes ? marked.parse(definition.personal_notes) : null;

// Separate sources into links and citations
const linkSources = (definition.sources ?? []).filter((s) => s.type === 'link');
const citationSources = (definition.sources ?? []).filter((s) => s.type === 'citation');

const pageTitle = `${term} — Definition`;
const pageDescription = `Definition of "${term}" — ${definition.definition.slice(0, 150)}...`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="blog-container">
    <article class="def-wrapper" data-cms-id={definition._id} data-cms-type="definition">
      {/* Back to the dictionary index */}
      <nav class="def-back">
        <Button href="/blog/dictionary" variant="ghost" size="sm">← Dictionary</Button>
      </nav>

      {/* Header — mono date eyebrow + quoted display-font term */}
      <header class="section-head def-head">
        <p class="def-eyebrow">
          <time datetime={definition.publish_date}>
            {publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </p>
        <h1 class="section-title def-term" data-cms-field="term">{term}</h1>
      </header>

      {/* The definition itself — subtle left-rule quote, matching the index */}
      <blockquote class="def-quote" data-cms-field="definition">
        <p>{definition.definition}</p>
      </blockquote>

      {/* Citations — pulled quotes with mono attribution */}
      {citationSources.length > 0 && (
        <section class="def-citations">
          {citationSources.map((source) => (
            <figure class="def-citation">
              <blockquote><p>{source.quote}</p></blockquote>
              {source.attribution && <figcaption>— {source.attribution}</figcaption>}
            </figure>
          ))}
        </section>
      )}

      {/* Personal notes */}
      {notesHtml && (
        <section class="def-section">
          <h2 class="def-label">Notes</h2>
          <div class="def-notes" set:html={notesHtml}></div>
        </section>
      )}

      {/* Link sources */}
      {linkSources.length > 0 && (
        <section class="def-section">
          <h2 class="def-label">
            Sources <span class="def-count">{linkSources.length}</span>
          </h2>
          <div class="def-sources-grid">
            {linkSources.map((source) => (
              <LinkCard
                link={{
                  url: source.url ?? '#',
                  title: source.title ?? 'Untitled',
                  description: source.description ?? '',
                  dateAdded: new Date(definition.publish_date),
                }}
                variant="minimal"
              />
            ))}
          </div>
        </section>
      )}

      {/* Tags — quiet mono outline chips, matching the index */}
      {definition.tags && definition.tags.length > 0 && (
        <div class="def-tags">
          {definition.tags.map((tag) => (
            <Badge href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
          ))}
        </div>
      )}
    </article>
  </main>

  <ThemeModal />
  <UIInteractions />
  <KeyboardShortcuts />
  <PerformanceOptimizer />

  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../../styles/tokens.css';
  @import '../../../styles/themes.css';
  @import '../../../styles/backgrounds.css';

  /* Page chrome (.blog-container) comes from log.css; the container is
     transparent so the site-wide grid background shows through. */

  /* Single centered reading column */
  .def-wrapper {
    max-width: var(--content-normal);
    margin: 0 auto;
    position: relative;
    z-index: 10; /* above the background */
  }

  .def-back {
    margin-bottom: var(--space-lg);
  }

  /* Header — .section-head gives the 2px hairline underline; add a top eyebrow */
  .def-head {
    margin-bottom: var(--space-xl);
  }

  .def-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
    margin: 0 0 var(--space-sm) 0;
  }

  /* Quoted display-font term, mirroring the dictionary index */
  .def-term::before { content: '\201C'; color: var(--accent-primary); margin-right: 0.02em; }
  .def-term::after { content: '\201D'; color: var(--accent-primary); margin-left: 0.02em; }

  /* Definition quote — same left-rule treatment as the index, one step larger */
  .def-quote {
    background: var(--bg-secondary);
    margin: 0 0 var(--space-2xl) 0;
    padding: var(--space-lg) var(--space-xl);
    border-left: 3px solid var(--accent-primary);
    color: var(--text-primary);
  }
  .def-quote p {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    max-width: 68ch;
    margin: 0;
  }

  /* Citations — pulled quotes with a mono attribution line */
  .def-citations {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: 0 0 var(--space-2xl) 0;
  }
  .def-citation {
    margin: 0;
    padding-left: var(--space-lg);
    border-left: 1px solid var(--gradient-primary-subtle);
  }
  .def-citation blockquote {
    margin: 0;
  }
  .def-citation blockquote p {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-style: italic;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
    margin: 0;
  }
  .def-citation figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
    margin-top: var(--space-sm);
  }

  /* Sections (notes, sources) */
  .def-section {
    margin: 0 0 var(--space-2xl) 0;
  }

  /* Mono section label with a hairline underline, matching .sidebar-heading */
  .def-label {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: 0 0 var(--space-md) 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-primary);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--text-primary);
  }

  .def-count {
    font-weight: var(--font-normal);
    color: var(--text-secondary);
  }

  .def-notes {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
  }
  .def-notes :global(p) { margin: 0 0 var(--space-md) 0; }
  .def-notes :global(p:last-child) { margin-bottom: 0; }

  .def-sources-grid {
    display: grid;
    gap: var(--space-md);
  }

  /* Tags — quiet mono outline chips, identical to the dictionary index */
  .def-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--gradient-primary-subtle);
  }
  .def-tags :global(.badge) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-normal);
    text-transform: none;
    letter-spacing: 0;
    color: var(--text-secondary);
    background: none;
    border: 1px solid var(--gradient-primary-subtle);
    border-radius: var(--radius-sm);
    box-shadow: none;
    padding: 1px var(--space-sm);
  }
  .def-tags :global(.badge:hover) {
    color: var(--text-primary);
    border-color: var(--accent-primary);
    background: none;
  }

  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  @media (max-width: 768px) {
    .theme-toggle-button {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }
</style>
