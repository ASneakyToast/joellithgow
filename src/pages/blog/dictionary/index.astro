---
import { fetchDefinitions } from '@lib/astraeus';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import '../../../styles/log.css';

const definitions = await fetchDefinitions();

// Three most-recent terms for the sidebar
const recent = [...definitions]
  .sort((a, b) => new Date(b.publish_date).valueOf() - new Date(a.publish_date).valueOf())
  .slice(0, 3);

// All terms, sorted alphabetically (flat list — no letter grouping for now)
const sortedDefinitions = [...definitions].sort((a, b) => a.term.localeCompare(b.term));

const totalDefinitions = definitions.length;

const pageTitle = "Dictionary";
const pageDescription = `A collection of ${totalDefinitions} definitions — terms, concepts, and ideas that matter, with sources and personal notes.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="blog-container">
    <div class="blog-wrapper">
      <div class="main-content">
        {/* Dictionary header */}
        <header class="section-head">
          <h1 class="section-title">Dictionary</h1>
          <p class="section-desc">{pageDescription}</p>
        </header>

        {/* All terms, alphabetical */}
        <div class="def-list">
          {sortedDefinitions.map((def) => (
            <article class="def-item">
              <h3 class="def-term">{def.term}</h3>
              <blockquote class="def-quote"><p>{def.definition}</p></blockquote>
              {def.tags && def.tags.length > 0 && (
                <div class="def-tags">
                  {def.tags.map((tag) => (
                    <Badge href={`/blog/tags/${tag}`} size="sm">#{tag}</Badge>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>

      {/* Sidebar — recent terms + about */}
      <aside class="sidebar">
        <h2 class="sidebar-heading">Recent</h2>
        {recent.length > 0 && (
          <nav class="type-nav" aria-label="Recent terms">
            {recent.map((def, i) => (
              <a href={`/blog/dictionary/${def.slug}/`} class:list={['type-card', `type-card--${['primary', 'secondary', 'tertiary'][i % 3]}`]}>
                <span class="tc-label">{def.term}</span>
                <span class="tc-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </nav>
        )}
        <p class="sidebar-note">
          A growing collection of terms, concepts, and ideas — each with a definition,
          my personal thoughts, and linked sources.
        </p>
      </aside>
    </div>
  </main>

  <ThemeModal />
  <UIInteractions />
  <KeyboardShortcuts />
  <PerformanceOptimizer />

  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../../styles/tokens.css';
  @import '../../../styles/themes.css';
  @import '../../../styles/backgrounds.css';

  /* Page chrome (.blog-container/.blog-wrapper/.main-content/.sidebar) is in log.css */

  .sidebar-note {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Section header comes from log.css; scorecard removed */

  .def-list {
    display: flex;
    flex-direction: column;
  }

  /* Definition item — mirrors the blog index (quoted term + white card + tags) */
  .def-item {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--gradient-primary-subtle);
  }
  .def-item:first-child { border-top: none; padding-top: 0; }

  .def-term {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: var(--font-semibold);
    font-size: var(--heading-md);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin: 0 0 var(--space-sm) 0;
  }
  .def-term::before { content: '\201C'; color: var(--accent-primary); margin-right: 0.02em; }
  .def-term::after { content: '\201D'; color: var(--accent-primary); margin-left: 0.02em; }

  .def-quote {
    background: var(--bg-secondary);
    width: fit-content;
    margin: 0 0 var(--space-sm) 0;
    padding: var(--space-md);
    border-left: 3px solid var(--accent-primary);
    color: var(--text-primary);
  }
  .def-quote p {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    max-width: 68ch;
    margin: 0;
  }

  .def-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  /* Quiet mono outline chips, matching the blog index */
  .def-tags :global(.badge) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-normal);
    text-transform: none;
    letter-spacing: 0;
    color: var(--text-secondary);
    background: none;
    border: 1px solid var(--gradient-primary-subtle);
    border-radius: var(--radius-sm);
    box-shadow: none;
    padding: 1px var(--space-sm);
  }
  .def-tags :global(.badge:hover) {
    color: var(--text-primary);
    border-color: var(--accent-primary);
    background: none;
  }

  .sidebar-card {
    padding: var(--space-lg);
  }

  .sidebar-heading {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
    margin: 0 0 var(--space-md) 0;
  }

  .sidebar-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  @media (max-width: 768px) {
    .theme-toggle-button {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }

</style>