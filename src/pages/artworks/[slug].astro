---
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import UIInteractions from '@components/interactive/UIInteractions.astro';
import KeyboardShortcuts from '@components/interactive/KeyboardShortcuts.astro';
import PerformanceOptimizer from '@components/ui/PerformanceOptimizer.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import { getAllArtworks, getArtworkById } from '@features/artworks';
import type { Artwork } from '@content/config';

export async function getStaticPaths() {
  const allArtworks = await getAllArtworks();

  return allArtworks.map((artwork) => ({
    params: { slug: artwork.id },
    props: { artwork },
  }));
}

type Props = {
  artwork: Artwork;
};

const { artwork } = Astro.props;

const pageTitle = `${artwork.title} - Joel Lithgow`;
const pageDescription = artwork.description;

// JSON-LD structured data for Artwork
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: artwork.title,
  description: artwork.description,
  url: `https://joellithgow.com/artworks/${artwork.id}`,
  creator: {
    '@type': 'Person',
    name: 'Joel Lithgow',
    url: 'https://joellithgow.com',
  },
  dateCreated: artwork.creationDate,
  artMedium: artwork.medium,
  artform: artwork.category,
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://joellithgow.com',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Artworks',
        item: 'https://joellithgow.com/artworks',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: artwork.title,
        item: `https://joellithgow.com/artworks/${artwork.id}`,
      },
    ],
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="artwork-detail-container animated-bg bg-accent-geometric">
    <div class="artwork-detail-wrapper">
      {/* Navigation */}
      <nav class="breadcrumb-nav">
        <Button href="/artworks" variant="ghost" size="sm">
          ← Back to Artworks
        </Button>
      </nav>

      {/* Header Section */}
      <section class="artwork-header-section animate-on-scroll">
        <header class="artwork-header">
          <h1 class="artwork-title">
            <a href="/" class="breadcrumb-link">Joel Lithgow</a>
            <span class="breadcrumb-separator">/</span>
            <a href="/artworks" class="breadcrumb-link">Artworks</a>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-current">{artwork.title}</span>
          </h1>

          <p class="project-context">{artwork.projectTitle}</p>

          <div class="artwork-meta-badges">
            <Badge variant="default" size="md">{artwork.medium}</Badge>
            {artwork.dimensions && (
              <Badge variant="ghost" size="md">{artwork.dimensions}</Badge>
            )}
            <Badge variant="ghost" size="md">
              {new Date(artwork.creationDate).getFullYear()}
            </Badge>
            {artwork.featured && (
              <Badge variant="tertiary" size="md">Featured</Badge>
            )}
          </div>

          {artwork.collaborators && artwork.collaborators.length > 0 && (
            <p class="collaborators">
              Collaboration with: {artwork.collaborators.join(', ')}
            </p>
          )}
        </header>
      </section>

      {/* Main Content Grid */}
      <div class="content-grid">
        {/* Left Column - Images */}
        <div class="images-column">
          {/* Primary Image */}
          <section class="primary-image-section animate-on-scroll">
            {artwork.images && artwork.images.length > 0 ? (
              <div class="main-image">
                <picture>
                  <source
                    srcset={artwork.images[0].srcLarge}
                    media="(min-width: 1200px)"
                  />
                  <source
                    srcset={artwork.images[0].src}
                    media="(min-width: 768px)"
                  />
                  <img
                    src={artwork.images[0].srcThumbnail || artwork.images[0].src}
                    alt={artwork.images[0].alt}
                    width={artwork.images[0].width}
                    height={artwork.images[0].height}
                    class="primary-image"
                  />
                </picture>
                {artwork.images[0].caption && (
                  <p class="image-caption">{artwork.images[0].caption}</p>
                )}
              </div>
            ) : (
              <div class="no-image-placeholder">
                No images available for this artwork
              </div>
            )}
          </section>

          {/* Additional Images */}
          {artwork.images && artwork.images.length > 1 && (
            <section class="additional-images-section animate-on-scroll">
              <h2 class="section-heading">Additional Views</h2>
              <div class="image-grid">
                {artwork.images.slice(1).map((image, index) => (
                  <Card variant="flat" padding="none" class="image-card">
                    <picture>
                      <source
                        srcset={image.src}
                        media="(min-width: 768px)"
                      />
                      <img
                        src={image.srcThumbnail || image.src}
                        alt={image.alt}
                        width={image.width || 400}
                        height={image.height || 300}
                        loading="lazy"
                        class="additional-image"
                      />
                    </picture>
                    <div class="image-info">
                      <Badge variant="secondary" size="sm">{image.type}</Badge>
                      {image.caption && (
                        <p class="image-caption">{image.caption}</p>
                      )}
                    </div>
                  </Card>
                ))}
              </div>
            </section>
          )}

          {/* About Section */}
          <section class="about-section animate-on-scroll">
            <h2 class="section-heading">About This Work</h2>
            <p class="description">{artwork.description}</p>

            {artwork.artistStatement && (
              <div class="content-block">
                <h3 class="subsection-heading">Artist Statement</h3>
                <p>{artwork.artistStatement}</p>
              </div>
            )}

            {artwork.processNotes && (
              <div class="content-block">
                <h3 class="subsection-heading">Process</h3>
                <p>{artwork.processNotes}</p>
              </div>
            )}

            {artwork.inspiration && (
              <div class="content-block">
                <h3 class="subsection-heading">Inspiration</h3>
                <p>{artwork.inspiration}</p>
              </div>
            )}
          </section>
        </div>

        {/* Right Column - Sidebar */}
        <aside class="sidebar">
          {/* Technical Details Card */}
          <Card variant="outlined" padding="lg" class="details-card animate-on-scroll">
            <h3 class="card-title">Technical Details</h3>

            {artwork.materials && artwork.materials.length > 0 && (
              <div class="detail-group">
                <h4 class="detail-label">Materials</h4>
                <div class="detail-tags">
                  {artwork.materials.map(material => (
                    <Badge variant="ghost" size="sm">{material}</Badge>
                  ))}
                </div>
              </div>
            )}

            {artwork.techniques && artwork.techniques.length > 0 && (
              <div class="detail-group">
                <h4 class="detail-label">Techniques</h4>
                <div class="detail-tags">
                  {artwork.techniques.map(technique => (
                    <Badge variant="ghost" size="sm">{technique}</Badge>
                  ))}
                </div>
              </div>
            )}

            {artwork.series && (
              <div class="detail-group">
                <h4 class="detail-label">Series</h4>
                <p class="detail-value">{artwork.series}</p>
              </div>
            )}

            {artwork.technicalNotes && (
              <div class="detail-group">
                <h4 class="detail-label">Technical Notes</h4>
                <p class="detail-value">{artwork.technicalNotes}</p>
              </div>
            )}

            {artwork.tags && artwork.tags.length > 0 && (
              <div class="detail-group">
                <h4 class="detail-label">Tags</h4>
                <div class="detail-tags">
                  {artwork.tags.map(tag => (
                    <Badge variant="default" size="sm">#{tag}</Badge>
                  ))}
                </div>
              </div>
            )}
          </Card>

          {/* Exhibition History Card */}
          {artwork.exhibitions && artwork.exhibitions.length > 0 && (
            <Card variant="outlined" padding="lg" class="details-card animate-on-scroll">
              <h3 class="card-title">Exhibition History</h3>
              <div class="exhibitions-list">
                {artwork.exhibitions.map((exhibition, index) => (
                  <div class="exhibition-item">
                    <h4 class="exhibition-name">{exhibition.name}</h4>
                    <p class="exhibition-location">{exhibition.location}</p>
                    <div class="exhibition-meta">
                      <span class="exhibition-date">{exhibition.date}</span>
                      {exhibition.type && (
                        <Badge variant="ghost" size="sm">{exhibition.type} show</Badge>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </Card>
          )}
        </aside>
      </div>

      {/* Project Context Section */}
      <section class="project-context-section animate-on-scroll">
        <Card variant="flat" padding="xl" class="project-card">
          <h2 class="section-heading">Project: {artwork.projectTitle}</h2>
          <p class="project-description">{artwork.projectDescription}</p>
          <Button href="/artworks" variant="secondary" size="md">
            View All Artworks
          </Button>
        </Card>
      </section>
    </div>
  </main>

  <!-- Theme Modal -->
  <ThemeModal />

  <!-- Enhanced UI Interactions -->
  <UIInteractions />

  <!-- Keyboard Shortcuts and Accessibility -->
  <KeyboardShortcuts />

  <!-- Performance Optimization and Monitoring -->
  <PerformanceOptimizer />

  <!-- Theme toggle button -->
  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';
  @import '../../styles/backgrounds.css';

  /* Main container styling */
  .artwork-detail-container {
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-3xl) var(--page-gutter);
    position: relative;
    overflow: hidden;
  }

  .artwork-detail-wrapper {
    max-width: var(--content-full);
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  /* Breadcrumb Navigation */
  .breadcrumb-nav {
    margin-bottom: var(--space-xl);
  }

  /* Header Section */
  .artwork-header-section {
    margin-bottom: var(--space-2xl);
  }

  .artwork-header {
    padding-bottom: var(--space-xl);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .artwork-title {
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-md) 0;
    color: var(--text-primary);
    letter-spacing: var(--tracking-tight);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    line-height: var(--leading-relaxed);
  }

  .breadcrumb-link {
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--accent-secondary);
    text-underline-offset: 3px;
    transition: all var(--duration-base) var(--ease-out);
    font-size: var(--text-lg);
  }

  .breadcrumb-link:hover {
    color: var(--accent-primary);
    text-decoration-color: var(--accent-primary);
  }

  .breadcrumb-separator {
    color: var(--text-secondary);
    font-weight: var(--font-normal);
    font-size: var(--text-lg);
  }

  .breadcrumb-current {
    color: var(--text-primary);
  }

  .project-context {
    font-size: var(--text-lg);
    color: var(--accent-primary);
    margin: 0 0 var(--space-lg) 0;
    font-weight: var(--font-medium);
  }

  .artwork-meta-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .collaborators {
    font-size: var(--text-base);
    color: var(--text-secondary);
    font-style: italic;
    margin: 0;
  }

  /* Content Grid */
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-3xl);
    align-items: start;
    margin-bottom: var(--space-3xl);
  }

  .images-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
    min-width: 0;
  }

  /* Primary Image Section */
  .primary-image-section {
    margin-bottom: var(--space-xl);
  }

  .main-image {
    text-align: center;
  }

  .primary-image {
    max-width: 100%;
    height: auto;
    border: var(--border-width) solid var(--gradient-primary-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
  }

  .image-caption {
    font-style: italic;
    color: var(--text-secondary);
    margin-top: var(--space-lg);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    max-width: var(--content-normal);
    margin-left: auto;
    margin-right: auto;
  }

  .no-image-placeholder {
    width: 100%;
    min-height: 300px;
    background: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    font-style: italic;
    border: var(--border-width) dashed var(--gradient-primary-subtle);
    border-radius: var(--radius-lg);
  }

  /* Additional Images Section */
  .additional-images-section {
    margin-top: var(--space-xl);
  }

  .section-heading {
    font-size: var(--heading-md);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-xl) 0;
    letter-spacing: var(--tracking-tight);
  }

  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-xl);
  }

  .image-card {
    overflow: hidden;
    border: var(--border-width) solid var(--gradient-primary-subtle);
    border-radius: var(--radius-lg);
    transition: all var(--duration-base) var(--ease-out);
  }

  .image-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md) var(--accent-secondary);
  }

  .additional-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  .image-info {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* About Section */
  .about-section {
    margin-top: var(--space-xl);
  }

  .description {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
    margin: 0 0 var(--space-2xl) 0;
  }

  .content-block {
    margin-bottom: var(--space-2xl);
    padding-left: var(--space-lg);
    border-left: var(--border-width-thick) solid var(--accent-primary);
  }

  .subsection-heading {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin: 0 0 var(--space-md) 0;
  }

  .content-block p {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin: 0;
  }

  /* Sidebar */
  .sidebar {
    position: sticky;
    top: var(--space-3xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .details-card {
    border-color: var(--gradient-primary-subtle);
  }

  .card-title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-xl) 0;
    padding-bottom: var(--space-md);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .detail-group {
    margin-bottom: var(--space-xl);
  }

  .detail-group:last-child {
    margin-bottom: 0;
  }

  .detail-label {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin: 0 0 var(--space-sm) 0;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .detail-value {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  /* Exhibitions List */
  .exhibitions-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .exhibition-item {
    padding-bottom: var(--space-lg);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .exhibition-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .exhibition-name {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-xs) 0;
  }

  .exhibition-location {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0 0 var(--space-sm) 0;
  }

  .exhibition-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .exhibition-date {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Project Context Section */
  .project-context-section {
    margin-top: var(--space-3xl);
  }

  .project-card {
    background: var(--bg-secondary);
    border: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .project-card .section-heading {
    margin-bottom: var(--space-md);
  }

  .project-card .project-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-xl) 0;
    max-width: var(--content-normal);
  }

  /* Theme toggle button */
  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  /* Responsive design */
  @media (max-width: 1024px) {
    .content-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .sidebar {
      position: relative;
      top: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--space-xl);
    }
  }

  @media (max-width: 768px) {
    .artwork-detail-container {
      padding: var(--space-xl) var(--page-gutter);
    }

    .artwork-title {
      font-size: var(--heading-md);
    }

    .breadcrumb-link,
    .breadcrumb-separator {
      font-size: var(--text-base);
    }

    .section-heading {
      font-size: var(--heading-sm);
    }

    .image-grid {
      grid-template-columns: 1fr;
    }

    .sidebar {
      grid-template-columns: 1fr;
    }

    .theme-toggle-button {
      bottom: var(--space-lg);
      right: var(--space-lg);
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 480px) {
    .artwork-detail-container {
      padding: var(--space-lg) var(--space-md);
    }

    .artwork-title {
      font-size: var(--text-xl);
      flex-direction: column;
      align-items: flex-start;
    }

    .description {
      font-size: var(--text-base);
    }

    .artwork-meta-badges {
      gap: var(--space-xs);
    }
  }
</style>
