---
import { getCollection } from 'astro:content';
import BaseLayout from '@components/common/BaseLayout.astro';
import Card from '@components/primitives/Card.astro';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import ApplicationsQuickStats from '@components/applications/ApplicationsQuickStats.astro';
import PageTitle from '@components/ui/PageTitle.astro';
import {
  APPLICATION_STATUSES,
  STATUS_LABELS,
  STATUS_COLORS,
  ACTIVE_STATUSES,
  CLOSED_STATUSES,
  getStatusLabel,
  getStatusColor
} from '@utils/applicationStatus';
import { shouldBuildApplications } from '@/utils/buildConfig';

if (!shouldBuildApplications()) return Astro.redirect('/404');

const applications = await getCollection('applications', ({ data }) => {
  return data.public;
});

// Sort by company A-Z, then position A-Z
const sortedApplications = applications.sort((a, b) => {
  const companyCompare = a.data.company.localeCompare(b.data.company);
  if (companyCompare !== 0) return companyCompare;
  return a.data.position.localeCompare(b.data.position);
});

// Calculate status counts
const statusCounts = new Map<string, number>();
applications.forEach(app => {
  const status = app.data.status;
  statusCounts.set(status, (statusCounts.get(status) || 0) + 1);
});

// Calculate quick stats
const totalCount = applications.length;
const activeCount = applications.filter(app => ACTIVE_STATUSES.includes(app.data.status as any)).length;

// Calculate success rate (offered / total closed applications)
const closedApps = applications.filter(app => CLOSED_STATUSES.includes(app.data.status as any));
const offeredApps = applications.filter(app => app.data.status === 'offered');
const successRate = closedApps.length > 0
  ? Math.round((offeredApps.length / closedApps.length) * 100)
  : undefined;

const fitLabels: Record<string, string> = {
  'very-strong': 'Very Strong Fit',
  'strong': 'Strong Fit',
  'moderate': 'Moderate Fit',
  'stretch': 'Stretch'
};
---

<BaseLayout
  title="Job Applications | Joel Lithgow"
  description="Tracking my job search journey with transparency."
>
  <main class="applications-page animated-bg">
    <div class="applications-wrapper">
      {/* Main Content */}
      <div class="main-content">
        <!-- Header -->
        <header class="page-header">
          <PageTitle
            title="Applications"
            subtitle="Tracking my job search with transparency"
          />
        </header>

        <!-- Status filters -->
        <div class="status-filters">
          <Badge variant="default" size="sm" href="/applications">
            All ({totalCount})
          </Badge>
          {APPLICATION_STATUSES.map((key) => {
            const count = statusCounts.get(key) || 0;
            return (
              <Badge
                variant="secondary"
                size="sm"
                href={`/applications/status/${key}`}
              >
                {STATUS_LABELS[key]} ({count})
              </Badge>
            );
          })}
        </div>

        <!-- Applications grid -->
        <div class="applications-grid">
          {sortedApplications.map((app) => (
            <Card
              variant="primary"
              as="article"
              class="application-card"
            >
              <div class="card-header">
                <Badge variant={getStatusColor(app.data.status)} size="sm">
                  {getStatusLabel(app.data.status)}
                </Badge>
                {app.data.fit && (
                  <Badge
                    variant={app.data.fit === 'very-strong' || app.data.fit === 'strong' ? 'primary' : 'secondary'}
                    size="sm"
                    class={`fit-badge fit-${app.data.fit}`}
                  >
                    {fitLabels[app.data.fit]}
                  </Badge>
                )}
              </div>

              <h2 class="job-title">{app.data.position}</h2>
              <p class="company">{app.data.company}</p>

              <div class="job-meta">
                <span class="location">{app.data.location}</span>
                {app.data.salary && (
                  <span class="salary">{app.data.salary}</span>
                )}
              </div>

              {app.data.deadline && (
                <p class="deadline">
                  Deadline: {app.data.deadline.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </p>
              )}

              <div class="card-actions">
                <Button href={`/applications/${app.slug}`} variant="secondary" size="sm">
                  View Details
                </Button>
                <Button href={`/applications/${app.slug}/cover-letter`} variant="ghost" size="sm">
                  Cover Letter
                </Button>
                <Button href={`/applications/${app.slug}/resume`} variant="ghost" size="sm">
                  Resume
                </Button>
                {app.data.outreach && (
                  <Button href={`/applications/${app.slug}/outreach`} variant="ghost" size="sm">
                    Outreach
                  </Button>
                )}
              </div>
            </Card>
          ))}
        </div>

        {sortedApplications.length === 0 && (
          <div class="empty-state">
            <p>No applications yet. Check back soon!</p>
          </div>
        )}
      </div>

      {/* Sidebar */}
      <aside class="sidebar">
        <ApplicationsQuickStats
          total={totalCount}
          active={activeCount}
          successRate={successRate}
        />
        <Card variant="outlined" padding="lg">
          <h3 class="widget-title">Resources</h3>
          <nav class="resource-links">
            <a href="/applications/flow" class="resource-link">Application Flow</a>
            <a href="/applications/outreach" class="resource-link">Outreach Template</a>
          </nav>
        </Card>
      </aside>
    </div>
  </main>

  <ThemeModal />

  <Button
    variant="ghost"
    size="md"
    id="themeControl"
    class="theme-toggle-button"
    onclick="window.openThemeModal && window.openThemeModal()"
    aria-label="Change theme"
    title="Change theme (Ctrl+T)"
  >
    🎨
  </Button>
</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';
  @import '../../styles/backgrounds.css';

  .applications-page {
    min-height: 100vh;
    padding: var(--space-3xl) var(--page-gutter);
    position: relative;
    overflow: hidden;
  }

  .applications-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-3xl);
    align-items: start;
    position: relative;
    z-index: 10;
  }

  .main-content {
    min-width: 0; /* Prevents grid blowout */
  }

  .sidebar {
    position: sticky;
    top: var(--space-3xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .page-header {
    margin-bottom: var(--space-3xl);
  }

  .status-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
  }

  .widget-title {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin: 0 0 var(--space-md);
  }

  .resource-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .resource-link {
    color: var(--accent-primary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color 0.2s;
  }

  .resource-link:hover {
    text-decoration: underline;
  }

  .applications-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .application-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .card-header {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .job-title {
    font-size: var(--heading-md);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: var(--space-sm) 0 0;
  }

  .company {
    font-size: var(--text-lg);
    color: var(--accent-primary);
    margin: 0;
    font-weight: var(--font-medium);
  }

  .job-meta {
    display: flex;
    gap: var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    flex-wrap: wrap;
  }

  .deadline {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: var(--space-sm) 0 0;
  }

  .card-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-color, var(--gradient-primary-subtle));
  }

  .empty-state {
    text-align: center;
    padding: var(--space-3xl);
    color: var(--text-secondary);
  }

  .theme-toggle-button {
    position: fixed;
    bottom: var(--space-xl);
    right: var(--space-xl);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    z-index: var(--z-sticky);
  }

  /* Responsive: Tablet and below */
  @media (max-width: 1024px) {
    .applications-wrapper {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .sidebar {
      position: relative;
      top: 0;
      order: -1; /* Move sidebar above main content on mobile */
    }
  }

  @media (max-width: 768px) {
    .applications-page {
      padding: var(--space-xl) var(--space-md);
    }

    .theme-toggle-button {
      bottom: var(--space-lg);
      right: var(--space-lg);
    }
  }
</style>
