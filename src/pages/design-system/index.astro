---
import DocLayout from '@layouts/DocLayout.astro';
import DocNav from '@components/docs/DocNav.astro';
import TokenTable from '@components/docs/TokenTable.astro';
import Badge from '@components/primitives/Badge.astro';
import Card from '@components/primitives/Card.astro';

const pageTitle = 'Overview';
const pageDescription = 'A three-tier token architecture for a brutalist portfolio. Philosophy, structure, and quick navigation.';

// Token tree examples
const buttonTokens = [
  { component: '--button-padding-x', semantic: '--space-lg', primitive: '--p-space-24', value: '24px' },
  { component: '--button-shadow', semantic: '--shadow-md', primitive: '--p-shadow-4', value: '4px 4px 0px' },
  { component: '--button-font-size', semantic: '--text-base', primitive: '--p-font-16', value: '16px' },
];

const cardTokens = [
  { component: '--card-padding', semantic: '--space-xl', primitive: '--p-space-32', value: '32px' },
  { component: '--card-radius', semantic: '--radius-lg', primitive: '--p-radius-12', value: '12px' },
  { component: '--card-shadow', semantic: '--shadow-lg', primitive: '--p-shadow-6', value: '6px 6px 0px' },
];
---

<DocLayout title={pageTitle} description={pageDescription} section="overview">
  <!-- Header -->
  <header class="doc-header">
    <h1 class="page-title">Design System</h1>
    <p class="page-lead">
      A three-tier token architecture for a brutalist portfolio.
    </p>
  </header>

  <!-- Philosophy Section -->
  <section class="doc-section">
    <h2 class="section-title">Philosophy</h2>

    <div class="philosophy-grid">
      <Card variant="outlined" padding="md">
        <h3 class="philosophy-title">Brutalist</h3>
        <p class="philosophy-text">
          Offset shadows with no blur. Sharp edges. Thick borders. The aesthetic embraces rawness over polish.
        </p>
      </Card>

      <Card variant="outlined" padding="md">
        <h3 class="philosophy-title">Monospace</h3>
        <p class="philosophy-text">
          Code-forward typography using Monaco/Menlo. Every character occupies equal space, creating a technical, deliberate rhythm.
        </p>
      </Card>

      <Card variant="outlined" padding="md">
        <h3 class="philosophy-title">Playful</h3>
        <p class="philosophy-text">
          Subtle rotations and tilts. Vibrant accent colors. Interactions that feel responsive and alive.
        </p>
      </Card>

      <Card variant="outlined" padding="md">
        <h3 class="philosophy-title">Two Themes</h3>
        <p class="philosophy-text">
          <strong>Default:</strong> Vibrant red/teal/yellow with monospace type.<br/>
          <strong>Minimal:</strong> Grayscale with system fonts for a cleaner look.
        </p>
      </Card>
    </div>
  </section>

  <!-- Token Architecture Section -->
  <section class="doc-section">
    <h2 class="section-title">Token Architecture</h2>

    <p class="section-description">
      Tokens flow from raw values to purpose to specific usage. This creates a traceable, maintainable system.
    </p>

    <div class="tier-flow">
      <div class="tier-card">
        <Badge variant="default">Tier 1</Badge>
        <h3>Primitives</h3>
        <p>Raw values. The "allowed palette" of the system. Never use directly in components.</p>
        <code>--p-space-24: 1.5rem</code>
      </div>

      <div class="tier-arrow">&rarr;</div>

      <div class="tier-card">
        <Badge variant="secondary">Tier 2</Badge>
        <h3>Semantic</h3>
        <p>Purpose-driven aliases. Describe what something IS, not the raw value.</p>
        <code>--space-lg: var(--p-space-24)</code>
      </div>

      <div class="tier-arrow">&rarr;</div>

      <div class="tier-card">
        <Badge variant="tertiary">Tier 3</Badge>
        <h3>Component</h3>
        <p>Specific usage in components. Self-documenting and easy to update globally.</p>
        <code>--button-padding-x: var(--space-lg)</code>
      </div>
    </div>

    <h3 class="subsection-title">Token Tree Examples</h3>
    <p class="section-description">Trace any component token back to its raw value:</p>

    <TokenTable title="Button Tokens" tokens={buttonTokens} />
    <TokenTable title="Card Tokens" tokens={cardTokens} />
  </section>

  <!-- Quick Navigation -->
  <section class="doc-section">
    <h2 class="section-title">Explore the System</h2>

    <div class="nav-cards">
      <a href="/design-system/foundations/colors" class="nav-card">
        <div class="nav-card-icon" style="background: var(--accent-primary);"></div>
        <div class="nav-card-content">
          <h3>Colors</h3>
          <p>Accent palette, text colors, and gradients</p>
        </div>
      </a>

      <a href="/design-system/foundations/typography" class="nav-card">
        <div class="nav-card-icon" style="background: var(--accent-secondary);">Aa</div>
        <div class="nav-card-content">
          <h3>Typography</h3>
          <p>Type hierarchy, weights, and line heights</p>
        </div>
      </a>

      <a href="/design-system/foundations/spacing" class="nav-card">
        <div class="nav-card-icon" style="background: var(--accent-tertiary);"></div>
        <div class="nav-card-content">
          <h3>Spacing</h3>
          <p>4px grid system and rhythm patterns</p>
        </div>
      </a>

      <a href="/design-system/foundations/elevation" class="nav-card">
        <div class="nav-card-icon elevation-icon"></div>
        <div class="nav-card-content">
          <h3>Elevation</h3>
          <p>Shadows, borders, and depth</p>
        </div>
      </a>

      <a href="/design-system/components" class="nav-card">
        <div class="nav-card-icon" style="background: var(--bg-dark);">&lt;/&gt;</div>
        <div class="nav-card-content">
          <h3>Components</h3>
          <p>Button, Card, and Badge primitives</p>
        </div>
      </a>

      <a href="/design-system/patterns" class="nav-card">
        <div class="nav-card-icon pattern-icon"></div>
        <div class="nav-card-content">
          <h3>Patterns</h3>
          <p>Media frames, CTAs, and compositions</p>
        </div>
      </a>
    </div>
  </section>

  <DocNav
    nextPage={{ title: 'Colors', href: '/design-system/foundations/colors' }}
  />
</DocLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  /* Header */
  .doc-header {
    margin-bottom: var(--docs-section-gap);
    padding-bottom: var(--space-xl);
    border-bottom: var(--border-width-thick) solid var(--accent-primary);
  }

  .page-title {
    font-size: var(--heading-2xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-md);
  }

  .page-lead {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    margin: 0;
    max-width: var(--content-normal);
  }

  /* Sections */
  .doc-section {
    margin-bottom: var(--docs-section-gap);
  }

  .section-title {
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: var(--border-width) solid var(--accent-secondary);
  }

  .subsection-title {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: var(--space-2xl) 0 var(--space-md);
  }

  .section-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin: 0 0 var(--space-lg);
    max-width: var(--content-normal);
    line-height: var(--leading-relaxed);
  }

  /* Philosophy Grid */
  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-lg);
  }

  .philosophy-title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin: 0 0 var(--space-sm);
  }

  .philosophy-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  /* Tier Flow */
  .tier-flow {
    display: flex;
    align-items: stretch;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-2xl);
  }

  .tier-card {
    flex: 1;
    min-width: 200px;
    padding: var(--space-lg);
    background: var(--bg-secondary);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--radius-md);
  }

  .tier-card h3 {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    margin: var(--space-sm) 0;
  }

  .tier-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0 0 var(--space-md);
    line-height: var(--leading-relaxed);
  }

  .tier-card code {
    font-size: var(--text-xs);
    font-family: var(--font-family);
    background: var(--gradient-primary-subtle);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    display: block;
  }

  .tier-arrow {
    display: flex;
    align-items: center;
    font-size: var(--text-2xl);
    color: var(--accent-primary);
    font-weight: var(--font-bold);
  }

  /* Navigation Cards */
  .nav-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .nav-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--bg-secondary);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .nav-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-md) var(--accent-secondary);
    border-color: var(--accent-primary);
  }

  .nav-card-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--bg-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--text-light);
    flex-shrink: 0;
  }

  .elevation-icon {
    background: var(--bg-secondary);
    box-shadow: var(--shadow-md) var(--accent-secondary);
  }

  .pattern-icon {
    background: linear-gradient(135deg, var(--accent-primary) 25%, transparent 25%),
                linear-gradient(-135deg, var(--accent-secondary) 25%, transparent 25%),
                linear-gradient(45deg, var(--accent-tertiary) 25%, transparent 25%),
                linear-gradient(-45deg, var(--bg-dark) 25%, transparent 25%);
    background-size: 20px 20px;
  }

  .nav-card-content h3 {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-xs);
  }

  .nav-card-content p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .tier-flow {
      flex-direction: column;
    }

    .tier-arrow {
      transform: rotate(90deg);
      justify-content: center;
    }
  }
</style>
