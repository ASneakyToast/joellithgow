---
import DocLayout from '@layouts/DocLayout.astro';
import DocNav from '@components/docs/DocNav.astro';
import Badge from '@components/primitives/Badge.astro';

const pageTitle = 'Typography';
const pageDescription = 'A complete type system with composite styles. One class = complete typography recipe.';

// Type sets data for display
const headingTypes = [
  {
    name: 'Hero',
    class: 'type-hero',
    sample: 'Big Impact Moments',
    use: 'Landing page headlines, major announcements',
    specs: {
      size: '--heading-2xl',
      weight: '--font-bold',
      leading: '--leading-tight',
      tracking: '--tracking-tight',
      color: '--text-primary'
    }
  },
  {
    name: 'Page Title',
    class: 'type-page-title',
    sample: 'Page & Section Headers',
    use: 'Page titles, main headings (h1)',
    specs: {
      size: '--heading-xl',
      weight: '--font-bold',
      leading: '--leading-tight',
      tracking: '--tracking-tight',
      color: '--text-primary'
    }
  },
  {
    name: 'Section Title',
    class: 'type-section-title',
    sample: 'Major Sections & Groups',
    use: 'Section headings (h2), card group titles',
    specs: {
      size: '--heading-lg',
      weight: '--font-bold',
      leading: '--leading-tight',
      color: '--text-primary'
    }
  },
  {
    name: 'Subsection Title',
    class: 'type-subsection-title',
    sample: 'Secondary Headings',
    use: 'Subsection headings (h3), card titles',
    specs: {
      size: '--heading-md',
      weight: '--font-bold',
      leading: '--leading-snug',
      color: '--text-primary'
    }
  },
  {
    name: 'Card Title',
    class: 'type-card-title',
    sample: 'Compact Headings',
    use: 'Card headers (h4), list item titles',
    specs: {
      size: '--text-lg',
      weight: '--font-bold',
      leading: '--leading-snug',
      color: '--text-primary'
    }
  }
];

const bodyTypes = [
  {
    name: 'Lead',
    class: 'type-lead',
    sample: 'Introductory paragraphs that set the tone and context for the content that follows.',
    use: 'Page intros, hero descriptions, emphasized paragraphs',
    specs: {
      size: '--text-xl',
      weight: '--font-normal',
      leading: '--leading-relaxed',
      color: '--text-secondary'
    }
  },
  {
    name: 'Body',
    class: 'type-body',
    sample: 'Standard body text for most content. Comfortable for reading at length across different screen sizes.',
    use: 'Paragraphs, list items, general content',
    specs: {
      size: '--text-base',
      weight: '--font-normal',
      leading: '--leading-relaxed',
      color: '--text-primary'
    }
  },
  {
    name: 'Body Small',
    class: 'type-body-small',
    sample: 'Compact text for tighter layouts and secondary information areas.',
    use: 'Sidebar text, secondary descriptions, tight layouts',
    specs: {
      size: '--text-sm',
      weight: '--font-normal',
      leading: '--leading-relaxed',
      color: '--text-primary'
    }
  }
];

const supportingTypes = [
  {
    name: 'Meta',
    class: 'type-meta',
    sample: 'January 26, 2024 · 5 min read',
    use: 'Dates, reading time, author names, descriptions',
    specs: {
      size: '--text-sm',
      weight: '--font-normal',
      leading: '--leading-normal',
      color: '--text-secondary'
    }
  },
  {
    name: 'Caption',
    class: 'type-caption',
    sample: 'LABELS · TIMESTAMPS · BADGES',
    use: 'Image captions, form labels, timestamps, badges',
    specs: {
      size: '--text-xs',
      weight: '--font-semibold',
      leading: '--leading-normal',
      tracking: '--tracking-wide',
      transform: 'uppercase',
      color: '--text-secondary'
    }
  },
  {
    name: 'Code',
    class: 'type-code',
    sample: '--button-padding-x: var(--space-lg)',
    use: 'Inline code, technical values, tokens',
    specs: {
      size: '--text-sm',
      weight: '--font-normal',
      leading: '--leading-normal',
      color: '--text-primary'
    }
  }
];
---

<DocLayout title={pageTitle} description={pageDescription} section="foundations" currentPage="typography">
  <header class="doc-header">
    <h1 class="page-title">Typography</h1>
    <p class="page-lead">
      One class, complete typography. No more remembering which size goes with which weight.
    </p>
  </header>

  <!-- Philosophy -->
  <section class="doc-section">
    <h2 class="section-title">The Problem & Solution</h2>

    <div class="problem-solution">
      <div class="problem">
        <Badge variant="danger" size="sm">Before</Badge>
        <h3>Remembering combos</h3>
        <div class="code-block">
          <code>
            font-size: var(--heading-2xl);<br/>
            font-weight: var(--font-bold);<br/>
            line-height: var(--leading-tight);<br/>
            letter-spacing: var(--tracking-tight);<br/>
            color: var(--text-primary);
          </code>
        </div>
        <p>5 properties to remember. Easy to miss one. Inconsistent results.</p>
      </div>

      <div class="arrow">&rarr;</div>

      <div class="solution">
        <Badge variant="success" size="sm">After</Badge>
        <h3>One class</h3>
        <div class="code-block">
          <code>class="type-hero"</code>
        </div>
        <p>Complete recipe. Consistent everywhere. Easy to use.</p>
      </div>
    </div>
  </section>

  <!-- Quick Reference -->
  <section class="doc-section">
    <h2 class="section-title">Quick Reference</h2>
    <p class="section-description">
      All available type sets at a glance. Click to jump to details.
    </p>

    <div class="quick-ref">
      <div class="quick-ref-group">
        <span class="quick-ref-label">Headings</span>
        <a href="#type-hero" class="quick-ref-item">.type-hero</a>
        <a href="#type-page-title" class="quick-ref-item">.type-page-title</a>
        <a href="#type-section-title" class="quick-ref-item">.type-section-title</a>
        <a href="#type-subsection-title" class="quick-ref-item">.type-subsection-title</a>
        <a href="#type-card-title" class="quick-ref-item">.type-card-title</a>
      </div>
      <div class="quick-ref-group">
        <span class="quick-ref-label">Body</span>
        <a href="#type-lead" class="quick-ref-item">.type-lead</a>
        <a href="#type-body" class="quick-ref-item">.type-body</a>
        <a href="#type-body-small" class="quick-ref-item">.type-body-small</a>
      </div>
      <div class="quick-ref-group">
        <span class="quick-ref-label">Supporting</span>
        <a href="#type-meta" class="quick-ref-item">.type-meta</a>
        <a href="#type-caption" class="quick-ref-item">.type-caption</a>
        <a href="#type-code" class="quick-ref-item">.type-code</a>
      </div>
    </div>
  </section>

  <!-- Heading Types -->
  <section class="doc-section">
    <h2 class="section-title">Headings</h2>

    {headingTypes.map((type) => (
      <div class="type-card" id={type.class}>
        <div class="type-card-header">
          <div class="type-card-meta">
            <code class="type-class">.{type.class}</code>
            <span class="type-name">{type.name}</span>
          </div>
          <span class="type-use">{type.use}</span>
        </div>

        <div class="type-card-preview">
          <span class={type.class}>{type.sample}</span>
        </div>

        <div class="type-card-specs">
          <div class="spec">
            <span class="spec-label">size</span>
            <code>{type.specs.size}</code>
          </div>
          <div class="spec">
            <span class="spec-label">weight</span>
            <code>{type.specs.weight}</code>
          </div>
          <div class="spec">
            <span class="spec-label">line-height</span>
            <code>{type.specs.leading}</code>
          </div>
          {type.specs.tracking && (
            <div class="spec">
              <span class="spec-label">tracking</span>
              <code>{type.specs.tracking}</code>
            </div>
          )}
          <div class="spec">
            <span class="spec-label">color</span>
            <code>{type.specs.color}</code>
          </div>
        </div>
      </div>
    ))}
  </section>

  <!-- Body Types -->
  <section class="doc-section">
    <h2 class="section-title">Body Text</h2>

    {bodyTypes.map((type) => (
      <div class="type-card" id={type.class}>
        <div class="type-card-header">
          <div class="type-card-meta">
            <code class="type-class">.{type.class}</code>
            <span class="type-name">{type.name}</span>
          </div>
          <span class="type-use">{type.use}</span>
        </div>

        <div class="type-card-preview body-preview">
          <span class={type.class}>{type.sample}</span>
        </div>

        <div class="type-card-specs">
          <div class="spec">
            <span class="spec-label">size</span>
            <code>{type.specs.size}</code>
          </div>
          <div class="spec">
            <span class="spec-label">weight</span>
            <code>{type.specs.weight}</code>
          </div>
          <div class="spec">
            <span class="spec-label">line-height</span>
            <code>{type.specs.leading}</code>
          </div>
          <div class="spec">
            <span class="spec-label">color</span>
            <code>{type.specs.color}</code>
          </div>
        </div>
      </div>
    ))}
  </section>

  <!-- Supporting Types -->
  <section class="doc-section">
    <h2 class="section-title">Supporting Text</h2>

    {supportingTypes.map((type) => (
      <div class="type-card" id={type.class}>
        <div class="type-card-header">
          <div class="type-card-meta">
            <code class="type-class">.{type.class}</code>
            <span class="type-name">{type.name}</span>
          </div>
          <span class="type-use">{type.use}</span>
        </div>

        <div class="type-card-preview">
          <span class={type.class}>{type.sample}</span>
        </div>

        <div class="type-card-specs">
          <div class="spec">
            <span class="spec-label">size</span>
            <code>{type.specs.size}</code>
          </div>
          <div class="spec">
            <span class="spec-label">weight</span>
            <code>{type.specs.weight}</code>
          </div>
          <div class="spec">
            <span class="spec-label">line-height</span>
            <code>{type.specs.leading}</code>
          </div>
          {type.specs.tracking && (
            <div class="spec">
              <span class="spec-label">tracking</span>
              <code>{type.specs.tracking}</code>
            </div>
          )}
          {type.specs.transform && (
            <div class="spec">
              <span class="spec-label">transform</span>
              <code>{type.specs.transform}</code>
            </div>
          )}
          <div class="spec">
            <span class="spec-label">color</span>
            <code>{type.specs.color}</code>
          </div>
        </div>
      </div>
    ))}
  </section>

  <!-- Usage -->
  <section class="doc-section">
    <h2 class="section-title">Usage</h2>

    <div class="usage-examples">
      <div class="usage-example">
        <h3>HTML</h3>
        <div class="code-block">
          <code>
            &lt;h1 class="type-page-title"&gt;Page Title&lt;/h1&gt;<br/>
            &lt;p class="type-lead"&gt;Intro paragraph...&lt;/p&gt;<br/>
            &lt;p class="type-body"&gt;Regular content...&lt;/p&gt;<br/>
            &lt;span class="type-meta"&gt;Jan 26, 2024&lt;/span&gt;
          </code>
        </div>
      </div>

      <div class="usage-example">
        <h3>Override color</h3>
        <div class="code-block">
          <code>
            &lt;!-- Use color modifier classes --&gt;<br/>
            &lt;h2 class="type-section-title type-accent"&gt;...&lt;/h2&gt;<br/>
            &lt;p class="type-body type-secondary"&gt;...&lt;/p&gt;<br/>
            &lt;span class="type-caption type-light"&gt;...&lt;/span&gt;
          </code>
        </div>
      </div>
    </div>
  </section>

  <!-- Color Modifiers -->
  <section class="doc-section">
    <h2 class="section-title">Color Modifiers</h2>
    <p class="section-description">
      Need to override the default color? Add a modifier class.
    </p>

    <div class="color-modifiers">
      <div class="modifier">
        <code>.type-primary</code>
        <span class="type-body type-primary">Primary text color</span>
      </div>
      <div class="modifier">
        <code>.type-secondary</code>
        <span class="type-body type-secondary">Secondary text color</span>
      </div>
      <div class="modifier">
        <code>.type-accent</code>
        <span class="type-body type-accent">Accent text color</span>
      </div>
      <div class="modifier dark-bg">
        <code>.type-light</code>
        <span class="type-body type-light">Light text (on dark)</span>
      </div>
    </div>
  </section>

  <!-- Font Stack -->
  <section class="doc-section">
    <h2 class="section-title">Font Stack</h2>

    <div class="font-stacks">
      <div class="font-stack-card">
        <h3>Default Theme</h3>
        <code>'Monaco', 'Menlo', 'Ubuntu Mono', monospace</code>
        <p class="stack-sample mono">
          The quick brown fox jumps over the lazy dog. 0123456789
        </p>
        <span class="type-meta">Code-forward, technical aesthetic</span>
      </div>

      <div class="font-stack-card">
        <h3>Minimal Theme</h3>
        <code>-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif</code>
        <p class="stack-sample sans">
          The quick brown fox jumps over the lazy dog. 0123456789
        </p>
        <span class="type-meta">Clean, professional system fonts</span>
      </div>
    </div>
  </section>

  <DocNav
    prevPage={{ title: 'Colors', href: '/design-system/foundations/colors' }}
    nextPage={{ title: 'Spacing', href: '/design-system/foundations/spacing' }}
  />
</DocLayout>

<style>
  @import '../../../styles/tokens.css';
  @import '../../../styles/themes.css';
  @import '../../../styles/typography.css';

  .doc-header {
    margin-bottom: var(--docs-section-gap);
    padding-bottom: var(--space-xl);
    border-bottom: var(--border-width-thick) solid var(--accent-primary);
  }

  .page-title {
    font-size: var(--heading-2xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-md);
  }

  .page-lead {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    margin: 0;
  }

  .doc-section {
    margin-bottom: var(--docs-section-gap);
  }

  .section-title {
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: var(--border-width) solid var(--accent-secondary);
  }

  .section-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin: 0 0 var(--space-lg);
    line-height: var(--leading-relaxed);
  }

  /* Problem/Solution */
  .problem-solution {
    display: flex;
    align-items: stretch;
    gap: var(--space-lg);
  }

  .problem, .solution {
    flex: 1;
    padding: var(--space-lg);
    border-radius: var(--radius-md);
  }

  .problem {
    background: var(--gradient-primary-subtle);
    border: var(--border-width) solid var(--accent-primary);
  }

  .solution {
    background: var(--gradient-secondary-subtle);
    border: var(--border-width) solid var(--accent-secondary);
  }

  .problem h3, .solution h3 {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    margin: var(--space-sm) 0 var(--space-md);
  }

  .problem p, .solution p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: var(--space-md) 0 0;
  }

  .arrow {
    display: flex;
    align-items: center;
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
  }

  .code-block {
    padding: var(--space-md);
    background: var(--bg-dark);
    border-radius: var(--radius-sm);
  }

  .code-block code {
    font-size: var(--text-sm);
    font-family: var(--font-family);
    color: var(--text-light);
    line-height: var(--leading-relaxed);
  }

  /* Quick Reference */
  .quick-ref {
    display: flex;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .quick-ref-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .quick-ref-label {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
    margin-bottom: var(--space-xs);
  }

  .quick-ref-item {
    font-size: var(--text-sm);
    font-family: var(--font-family);
    color: var(--accent-primary);
    text-decoration: none;
    padding: var(--space-xs) var(--space-sm);
    background: var(--gradient-primary-subtle);
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast);
  }

  .quick-ref-item:hover {
    background: var(--accent-primary);
    color: var(--text-light);
  }

  /* Type Cards */
  .type-card {
    margin-bottom: var(--space-xl);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--radius-md);
    overflow: hidden;
    scroll-margin-top: var(--space-xl);
  }

  .type-card-header {
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-dark);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .type-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .type-class {
    font-size: var(--text-base);
    font-family: var(--font-family);
    font-weight: var(--font-bold);
    color: var(--accent-tertiary);
  }

  .type-name {
    font-size: var(--text-sm);
    color: var(--text-light);
    opacity: 0.8;
  }

  .type-use {
    font-size: var(--text-xs);
    color: var(--text-light);
    opacity: 0.6;
  }

  .type-card-preview {
    padding: var(--space-xl) var(--space-lg);
    background: var(--bg-secondary);
    min-height: 80px;
    display: flex;
    align-items: center;
  }

  .body-preview {
    max-width: 600px;
  }

  .type-card-specs {
    padding: var(--space-md) var(--space-lg);
    background: var(--gradient-primary-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
  }

  .spec {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .spec-label {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    min-width: 70px;
  }

  .spec code {
    font-size: var(--text-xs);
    font-family: var(--font-family);
    color: var(--accent-primary);
    background: var(--bg-secondary);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  /* Usage Examples */
  .usage-examples {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .usage-example h3 {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin: 0 0 var(--space-sm);
  }

  /* Color Modifiers */
  .color-modifiers {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .modifier {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--gradient-primary-subtle);
    border-radius: var(--radius-md);
  }

  .modifier.dark-bg {
    background: var(--bg-dark);
  }

  .modifier code {
    font-size: var(--text-sm);
    font-family: var(--font-family);
    color: var(--text-secondary);
    min-width: 140px;
  }

  /* Font Stacks */
  .font-stacks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .font-stack-card {
    padding: var(--space-lg);
    background: var(--bg-secondary);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--radius-md);
  }

  .font-stack-card h3 {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-sm);
  }

  .font-stack-card code {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    display: block;
    margin-bottom: var(--space-md);
    word-break: break-word;
  }

  .stack-sample {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0 0 var(--space-sm);
    padding: var(--space-md);
    background: var(--gradient-primary-subtle);
    border-radius: var(--radius-sm);
  }

  .stack-sample.mono {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
  }

  .stack-sample.sans {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .problem-solution {
      flex-direction: column;
    }

    .arrow {
      transform: rotate(90deg);
      justify-content: center;
    }

    .quick-ref {
      flex-direction: column;
    }

    .usage-examples,
    .font-stacks {
      grid-template-columns: 1fr;
    }

    .type-card-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
