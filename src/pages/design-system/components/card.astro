---
import DocLayout from '@layouts/DocLayout.astro';
import DocNav from '@components/docs/DocNav.astro';
import ComponentShowcase from '@components/docs/ComponentShowcase.astro';
import TokenTable from '@components/docs/TokenTable.astro';
import Card from '@components/primitives/Card.astro';

const pageTitle = 'Card';
const pageDescription = 'Container component with multiple visual variants and padding options.';

const cardTokens = [
  { component: '--card-padding', semantic: '--space-xl', primitive: '--p-space-32', value: '32px' },
  { component: '--card-padding-sm', semantic: '--space-md', primitive: '--p-space-16', value: '16px' },
  { component: '--card-padding-lg', semantic: '--space-2xl', primitive: '--p-space-48', value: '48px' },
  { component: '--card-radius', semantic: '--radius-lg', primitive: '--p-radius-12', value: '12px' },
  { component: '--card-gap', semantic: '--space-lg', primitive: '--p-space-24', value: '24px' },
  { component: '--card-border-width', semantic: '--border-width', primitive: '--p-border-2', value: '2px' },
  { component: '--card-shadow', semantic: '--shadow-lg', primitive: '--p-shadow-6', value: '6px 6px 0px' },
  { component: '--card-shadow-hover', semantic: '--shadow-xl', primitive: '--p-shadow-8', value: '8px 8px 0px' },
];
---

<DocLayout title={pageTitle} description={pageDescription} section="components" currentPage="card">
  <header class="doc-header">
    <h1 class="page-title">Card</h1>
    <p class="page-lead">
      Container for grouping content. Six variants for different contexts.
    </p>
  </header>

  <!-- Variants -->
  <section class="doc-section">
    <h2 class="section-title">Variants</h2>

    <div class="variants-grid">
      <div class="variant-demo">
        <Card variant="default" padding="md">
          <strong>Default</strong>
          <p>Subtle border, clean background</p>
        </Card>
        <code>variant="default"</code>
      </div>

      <div class="variant-demo">
        <Card variant="outlined" padding="md">
          <strong>Outlined</strong>
          <p>Transparent with emphasis border</p>
        </Card>
        <code>variant="outlined"</code>
      </div>

      <div class="variant-demo">
        <Card variant="elevated" padding="md">
          <strong>Elevated</strong>
          <p>Shadow for depth</p>
        </Card>
        <code>variant="elevated"</code>
      </div>

      <div class="variant-demo">
        <Card variant="flat" padding="md">
          <strong>Flat</strong>
          <p>No border, just background</p>
        </Card>
        <code>variant="flat"</code>
      </div>

      <div class="variant-demo">
        <Card variant="interactive" padding="md">
          <strong>Interactive</strong>
          <p>Hover me for lift effect</p>
        </Card>
        <code>variant="interactive"</code>
      </div>

      <div class="variant-demo alternating-bg">
        <Card variant="alternating" padding="md" index={0}>
          <strong>Alternating</strong>
          <p>Color cycles based on index</p>
        </Card>
        <code>variant="alternating"</code>
      </div>
    </div>
  </section>

  <!-- Padding Options -->
  <section class="doc-section">
    <h2 class="section-title">Padding</h2>

    <ComponentShowcase description="Cards support multiple padding sizes.">
      <Card variant="outlined" padding="none">
        <div class="padding-label">none</div>
      </Card>
      <Card variant="outlined" padding="sm">
        <div class="padding-label">sm</div>
      </Card>
      <Card variant="outlined" padding="md">
        <div class="padding-label">md</div>
      </Card>
      <Card variant="outlined" padding="lg">
        <div class="padding-label">lg</div>
      </Card>
      <Card variant="outlined" padding="xl">
        <div class="padding-label">xl</div>
      </Card>
    </ComponentShowcase>
  </section>

  <!-- Radius Options -->
  <section class="doc-section">
    <h2 class="section-title">Border Radius</h2>

    <ComponentShowcase description="Customize the corner rounding.">
      <Card variant="elevated" padding="md" radius="none">
        <span>none</span>
      </Card>
      <Card variant="elevated" padding="md" radius="sm">
        <span>sm</span>
      </Card>
      <Card variant="elevated" padding="md" radius="md">
        <span>md</span>
      </Card>
      <Card variant="elevated" padding="md" radius="lg">
        <span>lg</span>
      </Card>
      <Card variant="elevated" padding="md" radius="xl">
        <span>xl</span>
      </Card>
    </ComponentShowcase>
  </section>

  <!-- As Link -->
  <section class="doc-section">
    <h2 class="section-title">As Link</h2>
    <p class="section-description">
      Cards can be links when given an <code>href</code> prop. They become interactive automatically.
    </p>

    <ComponentShowcase>
      <Card variant="interactive" padding="md" href="/design-system">
        <strong>Clickable Card</strong>
        <p>Click me to navigate</p>
      </Card>
    </ComponentShowcase>
  </section>

  <!-- Alternating Colors -->
  <section class="doc-section">
    <h2 class="section-title">Alternating Colors</h2>
    <p class="section-description">
      The alternating variant cycles through accent colors based on the <code>index</code> prop.
    </p>

    <div class="alternating-demo">
      <Card variant="alternating" padding="md" index={0}>
        <strong>Index 0</strong>
        <p>Primary (Red)</p>
      </Card>
      <Card variant="alternating" padding="md" index={1}>
        <strong>Index 1</strong>
        <p>Secondary (Teal)</p>
      </Card>
      <Card variant="alternating" padding="md" index={2}>
        <strong>Index 2</strong>
        <p>Tertiary (Yellow)</p>
      </Card>
      <Card variant="alternating" padding="md" index={3}>
        <strong>Index 3</strong>
        <p>Default (cycles)</p>
      </Card>
    </div>
  </section>

  <!-- Token Tree -->
  <section class="doc-section">
    <h2 class="section-title">Token Tree</h2>
    <TokenTable tokens={cardTokens} />
  </section>

  <!-- Props API -->
  <section class="doc-section">
    <h2 class="section-title">Props</h2>

    <div class="props-table">
      <div class="props-row header">
        <span>Prop</span>
        <span>Type</span>
        <span>Default</span>
        <span>Description</span>
      </div>
      <div class="props-row">
        <code>variant</code>
        <span>'default' | 'outlined' | 'elevated' | 'flat' | 'interactive' | 'alternating'</span>
        <span>'default'</span>
        <span>Visual style</span>
      </div>
      <div class="props-row">
        <code>padding</code>
        <span>'none' | 'sm' | 'md' | 'lg' | 'xl'</span>
        <span>'md'</span>
        <span>Internal padding</span>
      </div>
      <div class="props-row">
        <code>radius</code>
        <span>'none' | 'sm' | 'md' | 'lg' | 'xl'</span>
        <span>'lg'</span>
        <span>Corner rounding</span>
      </div>
      <div class="props-row">
        <code>href</code>
        <span>string</span>
        <span>-</span>
        <span>Makes card a link</span>
      </div>
      <div class="props-row">
        <code>index</code>
        <span>number</span>
        <span>0</span>
        <span>Color index for alternating</span>
      </div>
    </div>
  </section>

  <DocNav
    prevPage={{ title: 'Button', href: '/design-system/components/button' }}
    nextPage={{ title: 'Badge', href: '/design-system/components/badge' }}
  />
</DocLayout>

<style>
  @import '../../../styles/tokens.css';
  @import '../../../styles/themes.css';

  .doc-header {
    margin-bottom: var(--docs-section-gap);
    padding-bottom: var(--space-xl);
    border-bottom: var(--border-width-thick) solid var(--accent-primary);
  }

  .page-title {
    font-size: var(--heading-2xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-md);
  }

  .page-lead {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    margin: 0;
  }

  .doc-section {
    margin-bottom: var(--docs-section-gap);
  }

  .section-title {
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: var(--border-width) solid var(--accent-secondary);
  }

  .section-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin: 0 0 var(--space-lg);
    line-height: var(--leading-relaxed);
  }

  .section-description code {
    background: var(--gradient-primary-subtle);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  /* Variants Grid */
  .variants-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .variant-demo {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .variant-demo code {
    font-size: var(--text-xs);
    font-family: var(--font-family);
    color: var(--text-secondary);
  }

  .alternating-bg {
    padding: var(--space-md);
    background: var(--bg-dark);
    border-radius: var(--radius-md);
  }

  .variants-grid strong {
    display: block;
    margin-bottom: var(--space-xs);
  }

  .variants-grid p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Padding Label */
  .padding-label {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
  }

  /* Alternating Demo */
  .alternating-demo {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--bg-dark);
    border-radius: var(--radius-md);
  }

  .alternating-demo strong {
    display: block;
    margin-bottom: var(--space-xs);
  }

  .alternating-demo p {
    margin: 0;
    font-size: var(--text-sm);
  }

  /* Props Table */
  .props-table {
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--radius-md);
    overflow: hidden;
    overflow-x: auto;
  }

  .props-row {
    display: grid;
    grid-template-columns: 80px 1fr 80px 1fr;
    padding: var(--space-md);
    border-bottom: 1px solid var(--gradient-primary-subtle);
    font-size: var(--text-sm);
  }

  .props-row:last-child {
    border-bottom: none;
  }

  .props-row.header {
    background: var(--bg-dark);
    color: var(--text-light);
    font-weight: var(--font-bold);
  }

  .props-row code {
    font-family: var(--font-family);
    color: var(--accent-primary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .variants-grid {
      grid-template-columns: 1fr;
    }

    .alternating-demo {
      grid-template-columns: repeat(2, 1fr);
    }

    .props-row {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
  }
</style>
