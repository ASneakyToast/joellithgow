---
import BaseLayout from '@components/common/BaseLayout.astro';
import Projects from '@components/sections/Projects.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import GeometricGridBackground from '@components/backgrounds/GeometricGridBackground.astro';
import '../../styles/log.css';

const pageTitle = 'Work - Joel Lithgow';
const pageDescription = 'Selected work — case studies in UX design, product development, and creative technology.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="blog-container">
    <GeometricGridBackground animationType="drift" intensity={0.35} gridSize={90} speed={0.5} />
    <div class="blog-wrapper blog-wrapper--full">
      <div class="main-content">
        <header class="section-head">
          <h1 class="section-title">Portfolio</h1>
          <p class="section-desc">{pageDescription}</p>
        </header>

        <Projects featuredOnly={false} />
      </div>
    </div>
  </main>

  <ThemeModal />
</BaseLayout>
