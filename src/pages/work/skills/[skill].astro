---
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import ProjectRow from '@components/work/ProjectRow.astro';
import { fetchProjects } from '@lib/astraeus';
import type { GetStaticPaths } from 'astro';
import '../../../styles/log.css';

export const getStaticPaths = (async () => {
  // Skills listed in the About section that should have pages even without projects
  const aboutSkills = [
    'figma', 'sketch', 'adobe cc', 'prototyping', 'user research', 'design systems',
    'javascript', 'typescript', 'react', 'node.js', 'python', 'docker',
    'claude code', 'mcp servers', 'webgl', 'anime.js', 'p5.js'
  ];

  const allProjects = await fetchProjects();

  // Get all unique tags/skills from projects AND the about section
  const allSkills = new Set<string>(aboutSkills);
  allProjects.forEach((project) => {
    project.tags?.forEach((tag) => allSkills.add(tag));
  });

  // Create a path for each skill
  return Array.from(allSkills).map((skill) => {
    const projectsWithSkill = allProjects
      .filter((project) => project.tags?.includes(skill))
      .sort((a, b) => (a.number ?? 0) - (b.number ?? 0)); // Sort by project number

    return {
      params: { skill },
      props: { projects: projectsWithSkill, skill },
    };
  });
}) satisfies GetStaticPaths;

const { projects, skill } = Astro.props;

const pageTitle = `${skill} - Skills`;
const pageDescription = `Projects featuring ${skill}`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="blog-container">
    <div class="blog-wrapper blog-wrapper--full">
      <div class="main-content">
        <header class="section-head">
          <a href="/work/skills" class="back-link">← all skills</a>
          <h1 class="section-title">#{skill}</h1>
          <p class="section-desc">
            {projects.length} {projects.length === 1 ? 'project' : 'projects'} featuring this skill
          </p>
        </header>

        {projects.length > 0 ? (
          <div class="project-list">
            {projects.map((project) => (
              <ProjectRow
                project={project}
                number={project.number}
                tags={project.tags ?? []}
                activeTag={skill}
              />
            ))}
          </div>
        ) : (
          <p class="section-empty">
            No documented case studies for this skill yet. <a href="/work">View all projects →</a>
          </p>
        )}
      </div>
    </div>
  </main>

  <ThemeModal />
</BaseLayout>

<style>
  @import '../../../styles/tokens.css';
  @import '../../../styles/themes.css';

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: var(--space-sm);
  }
  .back-link:hover { color: var(--accent-primary); }
  .section-empty a { color: var(--accent-primary); }
</style>
