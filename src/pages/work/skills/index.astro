---
import BaseLayout from '@components/common/BaseLayout.astro';
import Card from '@components/primitives/Card.astro';
import Button from '@components/primitives/Button.astro';
import { getCollection } from 'astro:content';

const pageTitle = 'Skills - Joel Lithgow';
const pageDescription = 'Browse projects by skill and technology';

// Get all projects (exclude drafts)
const allProjects = await getCollection('projects', ({ data }) => !data.draft);

// Extract and count all tags/skills
const skillCounts = new Map<string, number>();
allProjects.forEach((project) => {
  project.data.tags?.forEach((tag) => {
    skillCounts.set(tag, (skillCounts.get(tag) || 0) + 1);
  });
});

// Sort skills by count (descending) then alphabetically
const sortedSkills = Array.from(skillCounts.entries()).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1]; // Sort by count first
  return a[0].localeCompare(b[0]); // Then alphabetically
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="skills-page">
    <div class="skills-header">
      <Button
        variant="ghost"
        size="sm"
        href="/work"
        class="back-button"
      >
        ← back to work
      </Button>

      <h1 class="page-title">skills</h1>
      <p class="page-description">Browse projects by skill and technology</p>

      <div class="skills-count">
        {sortedSkills.length} {sortedSkills.length === 1 ? 'skill' : 'skills'} · {allProjects.length} {allProjects.length === 1 ? 'project' : 'projects'}
      </div>
    </div>

    <div class="skills-grid">
      {sortedSkills.map(([skill, count]) => (
        <Card variant="interactive" href={`/work/skills/${skill}`} class="skill-card">
          <span class="skill-name">#{skill}</span>
          <span class="skill-count">{count} {count === 1 ? 'project' : 'projects'}</span>
        </Card>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  @import '../../../styles/tokens.css';
  @import '../../../styles/themes.css';

  .skills-page {
    min-height: 100vh;
    background: var(--bg-secondary);
    padding: var(--space-4xl) var(--page-gutter);
  }

  .skills-header {
    max-width: var(--content-normal);
    margin: 0 auto var(--space-4xl);
    text-align: center;
  }

  .back-button {
    margin-bottom: var(--space-xl);
  }

  .page-title {
    font-size: var(--heading-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-md);
    text-decoration: underline;
    text-decoration-color: var(--accent-primary);
    text-decoration-thickness: 4px;
    transform: skew(-2deg);
  }

  .page-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }

  .skills-count {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .skills-grid {
    max-width: var(--content-wide);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--space-lg);
  }

  .skill-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    text-align: center;
    padding: var(--space-xl);
  }

  .skill-name {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .skill-count {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  @media (max-width: 768px) {
    .skills-page {
      padding: var(--space-3xl) var(--page-gutter);
    }

    .page-title {
      font-size: var(--heading-xl);
    }

    .skills-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-md);
    }

    .skill-card {
      padding: var(--space-lg);
    }

    .skill-name {
      font-size: var(--text-lg);
    }
  }
</style>
