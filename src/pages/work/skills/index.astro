---
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import { fetchProjects } from '@lib/astraeus';
import '../../../styles/log.css';

const pageTitle = 'Skills - Joel Lithgow';
const pageDescription = 'Browse projects by skill and technology.';

// fetchProjects already filters drafts and sorts by number.
const allProjects = await fetchProjects();

// Count all tags/skills across projects.
const skillCounts = new Map<string, number>();
allProjects.forEach((project) => {
  project.tags?.forEach((tag) => {
    skillCounts.set(tag, (skillCounts.get(tag) || 0) + 1);
  });
});

// Sort by count (descending) then alphabetically.
const sortedSkills = Array.from(skillCounts.entries()).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1];
  return a[0].localeCompare(b[0]);
});

const tones = ['primary', 'secondary', 'tertiary'];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="blog-container">
    <div class="blog-wrapper blog-wrapper--full">
      <div class="main-content">
        <header class="section-head">
          <h1 class="section-title">Skills</h1>
          <p class="section-desc">
            {sortedSkills.length} {sortedSkills.length === 1 ? 'skill' : 'skills'} · {allProjects.length} {allProjects.length === 1 ? 'project' : 'projects'}
          </p>
        </header>

        <nav class="type-nav type-nav--grid" aria-label="Browse by skill">
          {sortedSkills.map(([skill, count], i) => (
            <a href={`/work/skills/${skill}`} class:list={['type-card', `type-card--${tones[i % 3]}`]}>
              <span class="tc-label">#{skill}</span>
              <span class="tc-count">{count} {count === 1 ? 'project' : 'projects'}</span>
              <span class="tc-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </main>

  <ThemeModal />
</BaseLayout>

<style>
  @import '../../../styles/tokens.css';
  @import '../../../styles/themes.css';

  /* Dense grid of tone cards for the skills index (base .type-nav is a column). */
  .type-nav--grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
</style>
