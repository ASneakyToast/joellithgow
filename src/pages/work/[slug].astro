---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import Button from '@components/primitives/Button.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);

  return projects.map(project => ({
    params: { slug: project.data.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const data = project.data;

// Render the MDX content
const { Content } = await render(project);

// Build metadata items
const metadataItems = data.metadata || [data.role, data.tools].filter(Boolean);

// JSON-LD structured data for case study
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.overview || data.description,
  author: {
    '@type': 'Person',
    name: 'Joel Lithgow',
    url: 'https://joellithgow.com',
  },
  keywords: data.tags?.join(', '),
  url: `https://joellithgow.com/work/${data.id}`,
  genre: data.type,
};

// Breadcrumb structured data for search results
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://joellithgow.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Portfolio',
      item: 'https://joellithgow.com/work',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.title,
    },
  ],
};
---

<BaseLayout
  title={`${data.title} - Joel Lithgow`}
  description={data.overview || data.description}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="case-study">
    {/* Two-column layout: Fixed sidebar + Scrolling content */}
    <div class="case-study-wrapper">
      {/* Fixed Sidebar */}
      <aside class="case-study-sidebar">
        {data.dateRange && (
          <time class="sidebar-date">{data.dateRange}</time>
        )}
        <h1 class="sidebar-title">{data.title}</h1>

        {metadataItems.length > 0 && (
          <div class="sidebar-meta">
            {metadataItems.map((item, i) => (
              <>
                <span class="sidebar-meta-item">{item}</span>
                {i < metadataItems.length - 1 && <span class="sidebar-meta-divider">/</span>}
              </>
            ))}
          </div>
        )}

        {data.liveLink && (
          <a href={data.liveLink.url} target="_blank" rel="noopener noreferrer" class="sidebar-cta">
            {data.liveLink.title}
          </a>
        )}

        <a href="/work" class="sidebar-back">
          <span class="back-arrow">←</span> All projects
        </a>
      </aside>

      {/* Scrolling Main Content */}
      <article class="case-study-main animated-bg">
        <div class="case-study-content">
          <Content />
        </div>
      </article>
    </div>
  </main>

  <ThemeModal />
</BaseLayout>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';
  @import '../../styles/backgrounds.css';

  /* Page Layout */
  .case-study {
    background: var(--bg-secondary);
    min-height: 100vh;
  }

  /* Two-column wrapper */
  .case-study-wrapper {
    display: grid;
    grid-template-columns: 3fr 7fr;
  }

  /* Fixed Sidebar */
  .case-study-sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: var(--space-2xl) var(--space-2xl) var(--space-2xl) var(--page-gutter);
    border-right: 1px solid var(--bg-dark);
    text-wrap: pretty;
  }

  .sidebar-date {
    display: block;
    font-family: var(--font-family);
    font-size: var(--text-sm);
    color: var(--accent-primary);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin-bottom: var(--space-lg);
  }

  .sidebar-title {
    font-family: var(--font-family);
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-lg);
  }

  .sidebar-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-family: var(--font-family);
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-xl);
    list-style: disc;
    padding-left: var(--space-md);
  }

  .sidebar-meta-item {
    display: list-item;
  }

  .sidebar-meta-divider {
    display: none;
  }

  .sidebar-cta {
    width: fit-content;
    font-family: var(--font-family);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-primary);
    text-underline-offset: 3px;
    transition: color var(--duration-base) var(--ease-out);
    margin-bottom: var(--space-md);
  }

  .sidebar-cta:hover {
    color: var(--accent-primary);
  }

  .sidebar-back {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: fit-content;
    margin-top: auto;
    font-family: var(--font-family);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .sidebar-back:hover {
    color: var(--text-primary);
  }

  .back-arrow {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .sidebar-back:hover .back-arrow {
    transform: translateX(-2px);
  }

  /* Main Content */
  .case-study-main {
    position: relative;
    overflow: hidden;
    min-width: 0;
    padding: var(--space-2xl) var(--page-gutter) var(--space-2xl) var(--space-xl);
    background: var(--bg-secondary);
  }

  /* Override z-index so grid appears above background */
  .case-study-main::before {
    z-index: 1;
  }

  .case-study-main::after {
    z-index: 2;
  }

  .case-study-content {
    container-type: inline-size;
    container-name: case-study;
    position: relative;
    z-index: 10;
  }

  /* Mobile: Stack vertically */
  @media (max-width: 1024px) {
    .case-study-wrapper {
      grid-template-columns: 1fr;
    }

    .case-study-sidebar {
      position: static;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--bg-dark);
      padding: var(--space-xl) var(--page-gutter);
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-md);
    }

    .case-study-main {
      padding: var(--space-xl) var(--page-gutter);
    }

    .sidebar-date {
      margin-bottom: 0;
    }

    .sidebar-title {
      flex: 1 1 100%;
      margin-bottom: var(--space-sm);
    }

    .sidebar-meta {
      flex-direction: row;
      flex-wrap: wrap;
      margin-bottom: 0;
      list-style: none;
      padding-left: 0;
    }

    .sidebar-meta-item {
      display: inline;
    }

    .sidebar-meta-divider {
      display: inline;
      margin: 0 var(--space-xs);
      color: var(--accent-primary);
    }

    .sidebar-cta {
      margin-bottom: 0;
    }

    .sidebar-back {
      margin-top: 0;
      margin-left: auto;
    }
  }

  @media (max-width: 768px) {
    .case-study-sidebar {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .sidebar-title {
      font-size: var(--heading-md);
    }

    .sidebar-back {
      margin-left: 0;
      margin-top: var(--space-md);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .sidebar-cta,
    .sidebar-back,
    .back-arrow {
      transition: none;
    }

    .sidebar-back:hover .back-arrow {
      transform: none;
    }
  }

  /* Focus states */
  .sidebar-cta:focus,
  .sidebar-back:focus {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
</style>

<!-- Global styles for MDX content -->
<style is:global>
  /* Legacy styles for MDX blocks */
  .case-section {
    margin: var(--space-2xl) 0;
    border-bottom: 2px solid var(--bg-primary);
  }

  .case-section:last-of-type {
    border-bottom: none;
  }

  .case-section .section-title {
    font-size: var(--heading-md);
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
    text-transform: lowercase;
    border-left: 4px solid var(--accent-primary);
    padding-left: var(--space-md);
  }

  .section-content {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
    max-width: var(--content-normal);
  }

  .section-content p {
    margin-bottom: var(--space-lg);
  }

  .case-image-gallery,
  .image-grid {
    margin: var(--space-xl) 0;
  }

  .hero-image {
    margin: var(--space-2xl) 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .case-image {
    width: 100%;
    height: auto;
    border: 2px solid var(--bg-dark);
    border-radius: var(--radius-md);
  }

  .image-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .image-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .live-link-container,
  .live-links-container {
    margin: var(--space-lg) 0;
  }

  /* Prose styles for MDX body content */
  .case-study-content > p {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
    max-width: var(--content-normal);
    margin-bottom: var(--space-lg);
  }

  /* First paragraph gets intro styling */
  .case-study-content > p:first-of-type {
    font-size: var(--text-lg);
  }

  @media (max-width: 768px) {
    .case-study-content > p:first-of-type {
      font-size: var(--text-base);
    }
  }
</style>
