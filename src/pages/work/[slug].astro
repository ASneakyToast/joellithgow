---
import { fetchProjects } from '@lib/astraeus';
import type { AstraeusDocument, ProjectPage } from '@lib/astraeus-types';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import CaseStudyHero from '@components/blocks/CaseStudyHero.astro';
import CaseStudyMeta from '@components/blocks/CaseStudyMeta.astro';
import ChallengeSection from '@components/blocks/ChallengeSection.astro';
import ApproachSection from '@components/blocks/ApproachSection.astro';
import ProcessSteps from '@components/blocks/ProcessSteps.astro';
import ImageGrid from '@components/blocks/ImageGrid.astro';
import FullWidthMedia from '@components/blocks/FullWidthMedia.astro';
import InsightsSection from '@components/blocks/InsightsSection.astro';
import MetricsGrid from '@components/blocks/MetricsGrid.astro';
import LiveLinkCTA from '@components/blocks/LiveLinkCTA.astro';
import VideoGallery from '@components/blocks/VideoGallery.astro';

export async function getStaticPaths() {
  const projects = await fetchProjects();

  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: AstraeusDocument<ProjectPage>;
}

const { project } = Astro.props;

// JSON-LD structured data for case study
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.overview || project.description,
  author: {
    '@type': 'Person',
    name: 'Joel Lithgow',
    url: 'https://joellithgow.com',
  },
  keywords: project.tags?.join(', '),
  url: `https://joellithgow.com/work/${project.slug}`,
  genre: project.project_type,
};

// Breadcrumb structured data for search results
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://joellithgow.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Portfolio',
      item: 'https://joellithgow.com/work',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: project.title,
    },
  ],
};
---

<BaseLayout
  title={`${project.title} - Joel Lithgow`}
  description={project.overview || project.description}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="case-study">
    {/* Breadcrumb Header */}
    <header class="breadcrumb-header">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Joel Lithgow</a>
          </li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li class="breadcrumb-item">
            <a href="/work" class="breadcrumb-link">Portfolio</a>
          </li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li class="breadcrumb-item breadcrumb-current" aria-current="page" data-cms-field="title">
            {project.title}
          </li>
        </ol>
      </nav>
    </header>

    {/* Body Blocks Content */}
    <article
      class="article"
      data-cms-id={project._id}
      data-cms-type="project_page"
    >
      <div class="case-study-content" data-cms-field="body_blocks">
        {project.body_blocks?.map((block) => (
          <>
            {block.block_type === 'case_study_hero' && (
              <CaseStudyHero
                title={block.title as string}
                subtitle={block.subtitle as string}
                overview={block.overview as string}
                media={block.media as any}
              />
            )}
            {block.block_type === 'case_study_meta' && (
              <CaseStudyMeta
                duration={block.duration as string}
                team={block.team as string}
                role={block.role as string}
                tools={block.tools as string}
              />
            )}
            {block.block_type === 'challenge_section' && (
              <ChallengeSection insight={block.insight as string}>
                <Fragment set:html={block.children as string} />
              </ChallengeSection>
            )}
            {block.block_type === 'approach_section' && (
              <ApproachSection>
                <Fragment set:html={block.children as string} />
              </ApproachSection>
            )}
            {block.block_type === 'process_steps' && (
              <ProcessSteps steps={block.steps as any[]} />
            )}
            {block.block_type === 'image_grid' && (
              <ImageGrid images={block.images as any[]} />
            )}
            {block.block_type === 'full_width_media' && (
              <FullWidthMedia
                src={block.src as string}
                fallbackSrc={block.fallback_src as string}
                alt={block.alt as string}
                caption={block.caption as string}
                type={block.type as 'image' | 'video'}
              />
            )}
            {block.block_type === 'insights_section' && (
              <InsightsSection insights={block.insights as string[]} />
            )}
            {block.block_type === 'metrics_grid' && (
              <MetricsGrid
                title={block.title as string}
                metrics={block.metrics as any[]}
              />
            )}
            {block.block_type === 'live_link_cta' && (
              <LiveLinkCTA
                title={block.title as string}
                url={block.url as string}
                description={block.description as string}
              />
            )}
            {block.block_type === 'live_links_cta' && (
              <div class="case-section live-links-cta">
                <h2 class="section-title">{block.title as string}</h2>
                {block.description && (
                  <p class="live-links-description">{block.description as string}</p>
                )}
                <div class="live-links-grid">
                  {(block.links as any[])?.map((link) => (
                    <a href={link.url} target="_blank" rel="noopener noreferrer" class="live-link-button">
                      {link.title}
                      <span class="link-arrow">&rarr;</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
            {block.block_type === 'video_gallery' && (
              <VideoGallery videos={block.videos as any[]} />
            )}
          </>
        ))}
      </div>

      {/* Footer Navigation */}
      <footer class="article-footer">
        <a href="/work" class="back-to-work">
          <span aria-hidden="true">&larr;</span> Back to all projects
        </a>
      </footer>
    </article>
  </main>

  <ThemeModal />
</BaseLayout>

<style is:global>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  /* Page Layout */
  .case-study {
    background: var(--bg-secondary);
    min-height: 100vh;
    font-family: var(--font-body);
    color: var(--text-primary);
  }

  /* Breadcrumb Header — mono rail + hairline */
  .breadcrumb-header {
    padding: var(--space-md) var(--page-gutter);
    border-bottom: 1px solid var(--gradient-primary-subtle);
  }

  .breadcrumb-nav {
    max-width: var(--content-container);
    margin: 0 auto;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .breadcrumb-item {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .breadcrumb-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .breadcrumb-link:hover {
    color: var(--accent-primary);
  }

  .breadcrumb-separator {
    color: var(--text-secondary);
    opacity: 0.5;
    font-size: var(--text-xs);
  }

  .breadcrumb-current {
    color: var(--text-primary);
    font-weight: var(--font-bold);
  }

  /* Article Container */
  .article {
    max-width: var(--content-container);
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  /* Case Study Content - styles for body blocks */
  .case-study-content {
    container-type: inline-size;
    container-name: case-study;
  }

  .case-hero {
    padding: var(--space-3xl) 0;
    background: var(--bg-secondary);
  }

  .case-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-tight);
    font-size: var(--heading-2xl);
    margin-bottom: var(--space-md);
    color: var(--text-primary);
    line-height: var(--leading-tight);
  }

  .case-subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--accent-secondary);
    margin-bottom: var(--space-lg);
  }

  .case-overview {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin-bottom: var(--space-2xl);
    max-width: var(--content-normal);
  }

  .case-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  .meta-item {
    padding: var(--space-lg);
    border: 1px solid var(--gradient-primary-subtle);
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-xs);
    color: var(--text-secondary);
    display: block;
  }

  .meta-value {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
  }

  .case-section {
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--gradient-primary-subtle);
  }

  .case-section:last-of-type {
    border-bottom: none;
  }

  /* Kept as a descendant selector so it never collides with a global
     .section-title — block headings stay at --heading-md, not --heading-xl. */
  .case-section .section-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-tight);
    font-size: var(--heading-md);
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
  }

  .section-content {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
    max-width: var(--content-normal);
  }

  .section-content p {
    margin-bottom: var(--space-lg);
  }

  /* Callout — subtle panel with an accent rule instead of a filled block */
  .insight-box {
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: var(--space-lg);
    margin: var(--space-xl) 0;
    border: 1px solid var(--gradient-primary-subtle);
    border-left: 3px solid var(--accent-secondary);
    position: relative;
    max-width: var(--content-normal);
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .metric-card {
    padding: var(--space-lg);
    text-align: center;
    border: 1px solid var(--gradient-primary-subtle);
  }

  .metric-number {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--heading-md);
    font-weight: var(--font-semibold);
    color: var(--accent-primary);
    margin-bottom: var(--space-xs);
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
  }

  .process-step-detailed {
    padding: var(--space-xl);
    margin-bottom: var(--space-lg);
    border: 1px solid var(--gradient-primary-subtle);
  }

  .step-number-detailed {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin-bottom: var(--space-sm);
  }

  .step-title-detailed {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-sm);
    color: var(--text-primary);
  }

  .step-description-detailed {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .case-image-gallery,
  .image-grid {
    margin: var(--space-xl) 0;
  }

  .hero-image {
    margin: var(--space-2xl) 0;
    overflow: hidden;
    border: 1px solid var(--gradient-primary-subtle);
  }

  .case-image {
    width: 100%;
    height: auto;
    border: 1px solid var(--gradient-primary-subtle);
  }

  .primary-image {
    max-height: 600px;
    object-fit: cover;
  }

  .image-caption {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-top: var(--space-sm);
    text-align: center;
  }

  .image-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .image-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .quote-block {
    background: var(--bg-primary);
    border-left: 3px solid var(--accent-primary);
    padding: var(--space-lg);
    margin: var(--space-lg) 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--text-primary);
    max-width: var(--content-normal);
  }

  .live-link-container,
  .live-links-container {
    margin: var(--space-lg) 0;
  }

  .live-link-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: transparent;
    color: var(--accent-primary);
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--accent-primary);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    transition: transform var(--duration-base) var(--ease-out),
                background var(--duration-base) var(--ease-out),
                color var(--duration-base) var(--ease-out);
  }

  .live-link-button:hover {
    background: var(--accent-primary);
    color: var(--card-alt-text-1);
    transform: translate(-2px, -2px);
  }

  .link-arrow {
    font-size: var(--text-base);
  }

  .live-link-description,
  .live-links-description {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin: var(--space-md) 0;
  }

  .live-links-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  /* Article Footer */
  .article-footer {
    padding: var(--space-4xl) 0;
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--gradient-primary-subtle);
    text-align: center;
  }

  .back-to-work {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--accent-primary);
    text-decoration: none;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .back-to-work:hover { transform: translateX(-4px); }

  /* Responsive */
  @media (max-width: 768px) {
    .case-title {
      font-size: var(--heading-xl);
    }

    .case-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Focus states */
  .breadcrumb-link:focus {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .live-link-button,
    .back-to-work {
      transition: none;
    }
    .live-link-button:hover,
    .back-to-work:hover {
      transform: none;
    }
  }
</style>
