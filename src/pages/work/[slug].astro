---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@components/common/BaseLayout.astro';
import ThemeModal from '@components/modals/ThemeModal.astro';
import Button from '@components/primitives/Button.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);

  return projects.map(project => ({
    params: { slug: project.data.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const data = project.data;

// Render the MDX content
const { Content } = await render(project);

// JSON-LD structured data for case study
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.overview || data.description,
  author: {
    '@type': 'Person',
    name: 'Joel Lithgow',
    url: 'https://joellithgow.com',
  },
  keywords: data.tags?.join(', '),
  url: `https://joellithgow.com/work/${data.id}`,
  genre: data.type,
};
---

<BaseLayout
  title={`${data.title} - Joel Lithgow`}
  description={data.overview || data.description}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="case-study">
    {/* Breadcrumb Header */}
    <header class="breadcrumb-header">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/" class="breadcrumb-link">Joel Lithgow</a>
          </li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li class="breadcrumb-item">
            <a href="/work" class="breadcrumb-link">Portfolio</a>
          </li>
          <li class="breadcrumb-separator" aria-hidden="true">/</li>
          <li class="breadcrumb-item breadcrumb-current" aria-current="page">
            {data.title}
          </li>
        </ol>
      </nav>
    </header>

    {/* MDX Content */}
    <article class="article">
      <div class="case-study-content">
        <Content />
      </div>

      {/* Footer Navigation */}
      <footer class="article-footer">
        <Button href="/work" variant="primary" size="lg">
          <span aria-hidden="true">&larr;</span> Back to all projects
        </Button>
      </footer>
    </article>
  </main>

  <ThemeModal />
</BaseLayout>

<style is:global>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  /* Page Layout */
  .case-study {
    background: var(--bg-secondary);
    min-height: 100vh;
  }

  /* Breadcrumb Header */
  .breadcrumb-header {
    background: var(--bg-primary);
    padding: var(--space-md) var(--page-gutter);
    border-bottom: 2px solid var(--bg-dark);
  }

  .breadcrumb-nav {
    max-width: var(--content-container);
    margin: 0 auto;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .breadcrumb-item {
    font-family: var(--font-family);
    font-size: var(--text-sm);
  }

  .breadcrumb-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .breadcrumb-link:hover {
    color: var(--accent-primary);
  }

  .breadcrumb-separator {
    color: var(--text-secondary);
    opacity: 0.5;
    font-size: var(--text-sm);
  }

  .breadcrumb-current {
    color: var(--text-primary);
    font-weight: var(--font-bold);
  }

  /* Article Container */
  .article {
    max-width: var(--content-container);
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  /* Case Study Content - styles for MDX blocks */
  .case-study-content {
    container-type: inline-size;
    container-name: case-study;
  }

  .case-hero {
    padding: var(--space-3xl) 0;
    background: var(--bg-secondary);
  }

  .case-title {
    font-size: var(--heading-2xl);
    margin-bottom: var(--space-md);
    color: var(--text-primary);
    line-height: var(--leading-tight);
  }

  .case-subtitle {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--accent-secondary);
    margin-bottom: var(--space-lg);
  }

  .case-overview {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin-bottom: var(--space-2xl);
    max-width: var(--content-normal);
  }

  .case-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  .meta-item {
    background: var(--bg-primary);
    border: 2px solid var(--bg-dark);
    padding: var(--space-lg);
  }

  .meta-item:nth-child(even) {
    background: var(--accent-tertiary);
  }

  .meta-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-xs);
    color: var(--text-secondary);
    display: block;
  }

  .meta-value {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .case-section {
    padding: var(--space-3xl) 0;
    border-bottom: 2px solid var(--bg-primary);
  }

  .case-section:last-of-type {
    border-bottom: none;
  }

  .case-section .section-title {
    font-size: var(--heading-md);
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
    text-transform: lowercase;
    border-left: 4px solid var(--accent-primary);
    padding-left: var(--space-md);
  }

  .section-content {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
    max-width: var(--content-normal);
  }

  .section-content p {
    margin-bottom: var(--space-lg);
  }

  .insight-box {
    background: var(--accent-secondary);
    color: var(--text-light);
    padding: var(--space-lg);
    margin: var(--space-xl) 0;
    border: 2px solid var(--bg-dark);
    position: relative;
    max-width: var(--content-normal);
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .metric-card {
    background: var(--bg-dark);
    color: var(--text-light);
    padding: var(--space-lg);
    text-align: center;
    border: 2px solid var(--bg-dark);
  }

  .metric-card:nth-child(even) {
    background: var(--accent-primary);
  }

  .metric-number {
    font-size: var(--heading-md);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-xs);
  }

  .metric-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .process-step-detailed {
    background: var(--bg-primary);
    border: 2px solid var(--bg-dark);
    padding: var(--space-xl);
    margin-bottom: var(--space-lg);
  }

  .step-number-detailed {
    font-size: var(--heading-sm);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin-bottom: var(--space-sm);
  }

  .step-title-detailed {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-sm);
    color: var(--text-primary);
  }

  .step-description-detailed {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .case-image-gallery,
  .image-grid {
    margin: var(--space-xl) 0;
  }

  .hero-image {
    margin: var(--space-2xl) 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .case-image {
    width: 100%;
    height: auto;
    border: 2px solid var(--bg-dark);
    border-radius: var(--radius-md);
  }

  .primary-image {
    max-height: 600px;
    object-fit: cover;
  }

  .image-caption {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-top: var(--space-sm);
    text-align: center;
  }

  .image-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .image-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .quote-block {
    background: var(--bg-primary);
    border-left: 4px solid var(--accent-primary);
    padding: var(--space-lg);
    margin: var(--space-lg) 0;
    font-style: italic;
    font-size: var(--text-lg);
    max-width: var(--content-normal);
  }

  .live-link-container,
  .live-links-container {
    margin: var(--space-lg) 0;
  }

  .live-link-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--accent-primary);
    color: var(--text-light);
    padding: var(--space-md) var(--space-xl);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: var(--font-bold);
    transition: all var(--duration-base) var(--ease-out);
  }

  .live-link-button:hover {
    background: var(--accent-secondary);
    transform: translateY(-2px);
  }

  .link-arrow {
    font-size: var(--text-xl);
  }

  .live-link-description,
  .live-links-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin: var(--space-md) 0;
  }

  .live-links-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  /* Article Footer */
  .article-footer {
    padding: var(--space-4xl) 0;
    margin-top: var(--space-2xl);
    border-top: 3px solid var(--bg-dark);
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .case-title {
      font-size: var(--heading-xl);
    }

    .case-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Focus states */
  .breadcrumb-link:focus {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
</style>
