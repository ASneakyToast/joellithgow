---
/**
 * SpacingScale - Visual spacing scale demonstration
 * Shows spacing tokens as visual bars with labels
 */

export interface SpacingItem {
  token: string;
  value: string;
  description?: string;
}

export interface Props {
  items: SpacingItem[];
}

const { items } = Astro.props;
---

<div class="spacing-scale">
  {items.map((item) => (
    <div class="spacing-item">
      <div class="spacing-bar" style={`width: var(${item.token});`}></div>
      <div class="spacing-info">
        <code class="spacing-token">{item.token}</code>
        <span class="spacing-value">{item.value}</span>
        {item.description && (
          <span class="spacing-description">{item.description}</span>
        )}
      </div>
    </div>
  ))}
</div>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  .spacing-scale {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .spacing-item {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .spacing-bar {
    height: 28px;
    min-width: 4px;
    background: var(--accent-primary);
    border: var(--border-width) solid var(--bg-dark);
    flex-shrink: 0;
    transition: transform var(--duration-fast);
  }

  .spacing-item:hover .spacing-bar {
    transform: scaleY(1.2);
  }

  .spacing-info {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .spacing-token {
    font-size: var(--text-xs);
    font-family: var(--font-family);
    color: var(--text-primary);
    background: var(--gradient-primary-subtle);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    min-width: 100px;
  }

  .spacing-value {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-family: var(--font-family);
    min-width: 60px;
  }

  .spacing-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .spacing-item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .spacing-info {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }
  }
</style>
