---
/**
 * ColorSwatch - Individual color display with token information
 * Shows a color swatch with its token name, value, and description
 */

export interface Props {
  token: string;
  value?: string;
  label?: string;
  description?: string;
  textColor?: 'light' | 'dark';
}

const {
  token,
  value,
  label,
  description,
  textColor = 'light'
} = Astro.props;
---

<div class="color-swatch-card">
  <div
    class="swatch"
    style={`background: var(${token});`}
    data-text-color={textColor}
  >
    <span class="swatch-token">{token}</span>
    {value && <span class="swatch-value">{value}</span>}
  </div>
  <div class="swatch-info">
    {label && <strong class="swatch-label">{label}</strong>}
    <code class="swatch-code">{token}</code>
    {description && <p class="swatch-description">{description}</p>}
  </div>
</div>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  .color-swatch-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .swatch {
    height: 100px;
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-sm);
    transition: transform var(--duration-fast), box-shadow var(--duration-fast);
  }

  .swatch:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-md) var(--accent-secondary);
  }

  .swatch[data-text-color="light"] {
    color: var(--text-light);
  }

  .swatch[data-text-color="dark"] {
    color: var(--text-primary);
  }

  .swatch-token {
    font-size: var(--text-xs);
    font-family: var(--font-family);
    font-weight: var(--font-bold);
  }

  .swatch-value {
    font-size: var(--text-xs);
    font-family: var(--font-family);
    opacity: 0.8;
  }

  .swatch-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .swatch-label {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .swatch-code {
    font-size: var(--text-xs);
    font-family: var(--font-family);
    color: var(--text-secondary);
  }

  .swatch-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
  }
</style>
