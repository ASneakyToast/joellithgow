---
/**
 * ComponentShowcase - Live component preview wrapper
 * Displays components in a consistent showcase format with optional title and code tokens
 */

export interface Props {
  title?: string;
  tokens?: string[];
  description?: string;
}

const { title, tokens, description } = Astro.props;
---

<div class="component-showcase">
  {title && <h4 class="showcase-title">{title}</h4>}
  {description && <p class="showcase-description">{description}</p>}

  <div class="showcase-preview">
    <slot />
  </div>

  {tokens && tokens.length > 0 && (
    <div class="showcase-tokens">
      {tokens.map((token) => (
        <code class="token">{token}</code>
      ))}
    </div>
  )}
</div>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  .component-showcase {
    margin: var(--space-xl) 0;
  }

  .showcase-title {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-sm);
  }

  .showcase-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0 0 var(--space-md);
  }

  .showcase-preview {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--bg-secondary);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--radius-md);
  }

  .showcase-tokens {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .token {
    font-size: var(--text-xs);
    font-family: var(--font-family);
    background: var(--gradient-primary-subtle);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--gradient-primary-dim);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
  }
</style>
