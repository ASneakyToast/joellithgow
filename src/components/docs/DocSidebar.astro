---
import Button from '@components/primitives/Button.astro';

export interface Props {
  section?: string;
  currentPage?: string;
}

const { section = 'overview', currentPage = '' } = Astro.props;

// Navigation structure
const navigation = [
  {
    title: 'Overview',
    href: '/design-system',
    key: 'overview'
  },
  {
    title: 'Foundations',
    key: 'foundations',
    items: [
      { title: 'Colors', href: '/design-system/foundations/colors', key: 'colors' },
      { title: 'Typography', href: '/design-system/foundations/typography', key: 'typography' },
      { title: 'Spacing', href: '/design-system/foundations/spacing', key: 'spacing' },
      { title: 'Elevation', href: '/design-system/foundations/elevation', key: 'elevation' }
    ]
  },
  {
    title: 'Components',
    key: 'components',
    items: [
      { title: 'Button', href: '/design-system/components/button', key: 'button' },
      { title: 'Card', href: '/design-system/components/card', key: 'card' },
      { title: 'Badge', href: '/design-system/components/badge', key: 'badge' }
    ]
  },
  {
    title: 'Patterns',
    href: '/design-system/patterns',
    key: 'patterns'
  }
];

function isActive(navSection: string, navPage?: string): boolean {
  if (navPage) {
    return currentPage === navPage;
  }
  return section === navSection && !currentPage;
}

function isSectionExpanded(navSection: string): boolean {
  return section === navSection;
}
---

<aside class="doc-sidebar" id="doc-sidebar">
  <!-- Mobile toggle button (only visible on mobile) -->
  <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Toggle navigation">
    <span class="toggle-icon"></span>
  </button>

  <div class="sidebar-content">
    <!-- Header -->
    <header class="sidebar-header">
      <a href="/design-system" class="sidebar-title">Design System</a>
      <span class="sidebar-version">v1.0</span>
    </header>

    <!-- Navigation -->
    <nav class="sidebar-nav" aria-label="Documentation navigation">
      {navigation.map((item) => (
        <div class="nav-group">
          {item.items ? (
            <>
              <span class={`nav-section-title ${isSectionExpanded(item.key) ? 'expanded' : ''}`}>
                {item.title}
              </span>
              <ul class={`nav-items ${isSectionExpanded(item.key) ? 'expanded' : ''}`}>
                {item.items.map((subItem) => (
                  <li>
                    <a
                      href={subItem.href}
                      class={`nav-link ${isActive(item.key, subItem.key) ? 'active' : ''}`}
                      aria-current={isActive(item.key, subItem.key) ? 'page' : undefined}
                    >
                      {subItem.title}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <a
              href={item.href}
              class={`nav-link nav-link-top ${isActive(item.key) ? 'active' : ''}`}
              aria-current={isActive(item.key) ? 'page' : undefined}
            >
              {item.title}
            </a>
          )}
        </div>
      ))}
    </nav>

    <!-- Footer with theme toggle -->
    <footer class="sidebar-footer">
      <Button
        variant="ghost"
        size="sm"
        onclick="window.openThemeModal && window.openThemeModal()"
        class="theme-toggle-btn"
      >
        Switch Theme
      </Button>
      <a href="/" class="back-link">
        &larr; Back to Portfolio
      </a>
    </footer>
  </div>

  <!-- Mobile overlay -->
  <div class="sidebar-overlay" id="sidebar-overlay"></div>
</aside>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  .doc-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--docs-sidebar-width);
    height: 100vh;
    background: var(--bg-secondary);
    border-right: var(--border-width-thick) solid var(--bg-dark);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
    z-index: var(--z-sticky);
    display: flex;
    flex-direction: column;
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
    padding: var(--docs-sidebar-padding);
  }

  /* Header */
  .sidebar-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-md);
    border-bottom: var(--border-width) solid var(--accent-primary);
  }

  .sidebar-title {
    font-size: var(--heading-md);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .sidebar-title:hover {
    color: var(--accent-secondary);
  }

  .sidebar-version {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  /* Navigation */
  .sidebar-nav {
    flex: 1;
  }

  .nav-group {
    margin-bottom: var(--space-lg);
  }

  .nav-section-title {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
    margin-bottom: var(--space-sm);
    padding: var(--space-xs) 0;
  }

  .nav-items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-items li {
    margin: 0;
  }

  .nav-link {
    display: block;
    padding: var(--docs-nav-link-padding-y) var(--docs-nav-link-padding-x);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-primary);
    text-decoration: none;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover {
    background: var(--gradient-primary-subtle);
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .nav-link.active {
    background: var(--accent-primary);
    color: var(--text-light);
    border-color: var(--bg-dark);
    box-shadow: var(--shadow-sm) var(--bg-dark);
    font-weight: var(--font-bold);
  }

  .nav-link-top {
    font-weight: var(--font-bold);
    margin-bottom: var(--space-xs);
  }

  /* Footer */
  .sidebar-footer {
    margin-top: auto;
    padding-top: var(--space-lg);
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .back-link {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-xs) 0;
    transition: color var(--duration-fast);
  }

  .back-link:hover {
    color: var(--accent-primary);
  }

  /* Mobile toggle button (hidden on desktop) */
  .sidebar-toggle {
    display: none;
  }

  .sidebar-overlay {
    display: none;
  }

  /* Mobile responsive */
  @media (max-width: 1024px) {
    .doc-sidebar {
      transform: translateX(-100%);
      transition: transform var(--duration-slow) var(--ease-out);
      z-index: var(--z-overlay);
    }

    .doc-sidebar.open {
      transform: translateX(0);
    }

    .sidebar-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      top: var(--space-md);
      left: var(--space-md);
      width: 48px;
      height: 48px;
      background: var(--bg-secondary);
      border: var(--border-width-thick) solid var(--bg-dark);
      box-shadow: var(--shadow-md) var(--accent-secondary);
      border-radius: var(--radius-md);
      cursor: pointer;
      z-index: calc(var(--z-overlay) + 1);
      transition: transform var(--duration-fast), box-shadow var(--duration-fast);
    }

    .sidebar-toggle:hover {
      transform: translate(-2px, -2px);
      box-shadow: var(--shadow-lg) var(--accent-secondary);
    }

    .toggle-icon {
      width: 20px;
      height: 2px;
      background: var(--text-primary);
      position: relative;
    }

    .toggle-icon::before,
    .toggle-icon::after {
      content: '';
      position: absolute;
      width: 20px;
      height: 2px;
      background: var(--text-primary);
      left: 0;
    }

    .toggle-icon::before {
      top: -6px;
    }

    .toggle-icon::after {
      bottom: -6px;
    }

    .sidebar-overlay {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--duration-slow), visibility var(--duration-slow);
      z-index: calc(var(--z-overlay) - 1);
    }

    .doc-sidebar.open + .sidebar-overlay,
    .doc-sidebar.open ~ .sidebar-overlay {
      opacity: 1;
      visibility: visible;
    }
  }
</style>

<script>
  // Mobile sidebar toggle
  const sidebar = document.getElementById('doc-sidebar');
  const toggle = document.getElementById('sidebar-toggle');
  const overlay = document.getElementById('sidebar-overlay');

  function toggleSidebar() {
    sidebar?.classList.toggle('open');
  }

  function closeSidebar() {
    sidebar?.classList.remove('open');
  }

  toggle?.addEventListener('click', toggleSidebar);
  overlay?.addEventListener('click', closeSidebar);

  // Close sidebar on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeSidebar();
    }
  });

  // Close sidebar on navigation (for client-side routing)
  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 1024) {
        closeSidebar();
      }
    });
  });
</script>
