---
/**
 * PresentationToggle - Fullscreen/recording mode toggle
 * Hides all UI panels for clean screenshots and recordings.
 * Triggered by clicking the button or pressing F.
 */
---

<button
  class="presentation-toggle"
  id="presentation-toggle"
  title="Presentation mode (F)"
  aria-label="Toggle presentation mode"
  aria-pressed="false"
>
  <!-- Expand icon (enter presentation) -->
  <svg class="icon-enter" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="15 3 21 3 21 9"/>
    <polyline points="9 21 3 21 3 15"/>
    <line x1="21" y1="3" x2="14" y2="10"/>
    <line x1="3" y1="21" x2="10" y2="14"/>
  </svg>
  <!-- Collapse icon (exit presentation) -->
  <svg class="icon-exit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="4 14 10 14 10 20"/>
    <polyline points="20 10 14 10 14 4"/>
    <line x1="14" y1="10" x2="21" y2="3"/>
    <line x1="3" y1="21" x2="10" y2="14"/>
  </svg>
</button>

<!-- Toast hint shown on first use -->
<div class="presentation-toast" id="presentation-toast" hidden>
  Press <kbd>F</kbd> to exit
</div>

<style>
  .presentation-toggle {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 1001;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: none;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    color: rgba(0, 0, 0, 0.6);
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
  }

  .presentation-toggle:hover {
    background: rgba(255, 255, 255, 1);
    color: rgba(0, 0, 0, 0.9);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .presentation-toggle:active {
    transform: translateY(0);
  }

  .presentation-toggle svg {
    width: 18px;
    height: 18px;
  }

  .presentation-toggle .icon-exit {
    display: none;
  }

  /* Dark theme */
  :global([data-theme="dark"]) .presentation-toggle,
  :global([data-theme="neon"]) .presentation-toggle {
    background: rgba(30, 30, 35, 0.9);
    color: rgba(255, 255, 255, 0.6);
  }

  :global([data-theme="dark"]) .presentation-toggle:hover,
  :global([data-theme="neon"]) .presentation-toggle:hover {
    background: rgba(40, 40, 45, 1);
    color: rgba(255, 255, 255, 0.95);
  }

  /* Presentation mode active - swap icons */
  :global(body.presentation-mode) .presentation-toggle .icon-enter {
    display: none;
  }

  :global(body.presentation-mode) .presentation-toggle .icon-exit {
    display: block;
  }

  /* In presentation mode: hidden by default, visible on hover */
  :global(body.presentation-mode) .presentation-toggle {
    opacity: 0;
    pointer-events: auto;
    transition: opacity 0.3s ease, transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  :global(body.presentation-mode) .presentation-toggle:hover,
  :global(body.presentation-mode) .presentation-toggle:focus-visible {
    opacity: 0.8;
  }

  /* Toast hint */
  .presentation-toast {
    position: fixed;
    bottom: 72px;
    left: 24px;
    z-index: 1002;
    padding: 8px 14px;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    font-weight: 500;
    border-radius: 8px;
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .presentation-toast.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .presentation-toast kbd {
    display: inline-block;
    padding: 1px 6px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    font-family: inherit;
    font-size: 12px;
  }

  /* Responsive */
  @media (max-width: 480px) {
    .presentation-toggle {
      bottom: 16px;
      left: 16px;
    }

    .presentation-toast {
      bottom: 64px;
      left: 16px;
    }
  }
</style>

<script>
  const toggle = document.getElementById('presentation-toggle') as HTMLButtonElement;
  const toast = document.getElementById('presentation-toast') as HTMLDivElement;

  if (toggle) {
    const TOAST_KEY = 'presentation-toast-shown';

    function isPresentationMode(): boolean {
      return document.body.classList.contains('presentation-mode');
    }

    function showToast() {
      // Only show toast the first time
      if (sessionStorage.getItem(TOAST_KEY)) return;
      sessionStorage.setItem(TOAST_KEY, '1');

      toast.hidden = false;
      requestAnimationFrame(() => {
        toast.classList.add('visible');
      });

      setTimeout(() => {
        toast.classList.remove('visible');
        setTimeout(() => { toast.hidden = true; }, 300);
      }, 2500);
    }

    function togglePresentationMode() {
      const entering = !isPresentationMode();
      document.body.classList.toggle('presentation-mode');
      toggle.setAttribute('aria-pressed', String(entering));

      if (entering) {
        sessionStorage.setItem('presentation-mode', '1');
        showToast();
      } else {
        sessionStorage.removeItem('presentation-mode');
      }
    }

    // Button click
    toggle.addEventListener('click', togglePresentationMode);

    // Keyboard shortcut: F key
    document.addEventListener('keydown', (e) => {
      // Skip if typing in an input
      const tag = (e.target as HTMLElement).tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      if ((e.target as HTMLElement).isContentEditable) return;

      if (e.key === 'f' || e.key === 'F') {
        // Don't interfere with Cmd+F / Ctrl+F (browser find)
        if (e.metaKey || e.ctrlKey) return;
        e.preventDefault();
        togglePresentationMode();
      }
    });

    // Restore state from sessionStorage on load
    if (sessionStorage.getItem('presentation-mode') === '1') {
      document.body.classList.add('presentation-mode');
      toggle.setAttribute('aria-pressed', 'true');
    }
  }
</script>
