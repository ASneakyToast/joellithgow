---
/**
 * VoronoiEdgeBackground - Cell boundary patterns
 * Creates crack or tile-like patterns using Voronoi F2-F1 distance
 */
import type { VoronoiEdgeBackgroundProps } from './types';

export interface Props extends VoronoiEdgeBackgroundProps {}

const {
  speed = 0.4,
  intensity = 0.6,
  noiseScale = 2.0,
  animated = true,
  animationAngle = 315,
  colors,
  maxPixelRatio = 2,
  pauseOffscreen = true,
  class: className = '',
  id = `voronoi-edge-bg-${Math.random().toString(36).substr(2, 9)}`,
  // Voronoi Edge-specific
  cellScale = 2.0,
  edgeThickness = 0.15,
  cellAnimSpeed = 0.2
} = Astro.props;
---

<div
  class:list={['webgl-background-container', 'noise-texture', 'voronoi-edge-bg', className]}
  id={id}
  data-effect-type="voronoiEdge"
  data-speed={speed}
  data-intensity={intensity}
  data-noise-scale={noiseScale}
  data-animated={animated}
  data-animation-angle={animationAngle}
  data-colors={JSON.stringify(colors || {})}
  data-max-pixel-ratio={maxPixelRatio}
  data-pause-offscreen={pauseOffscreen}
  data-cell-scale={cellScale}
  data-edge-thickness={edgeThickness}
  data-cell-anim-speed={cellAnimSpeed}
  aria-hidden="true"
>
  <canvas class="webgl-canvas"></canvas>
</div>

<style>
  .webgl-background-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .webgl-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global([data-theme="minimal"]) .noise-texture {
    opacity: 0.15;
  }

  @media (prefers-reduced-motion: reduce) {
    .webgl-background-container {
      display: none;
    }
  }
</style>

<script>
  import * as THREE from 'three';
  import { PatternBackgroundManager } from './PatternBackgroundManager';
  import { voronoiEdgeFragmentShader } from './shaders/fragments/noise/voronoi-edge.glsl';

  interface VoronoiEdgeConfig {
    speed: number;
    intensity: number;
    noiseScale: number;
    animated: boolean;
    animationAngle: number;
    maxPixelRatio: number;
    pauseOffscreen: boolean;
    colors: Record<string, string>;
    cellScale: number;
    edgeThickness: number;
    cellAnimSpeed: number;
  }

  class VoronoiEdgeBackgroundManager extends PatternBackgroundManager<VoronoiEdgeConfig> {
    protected getFragmentShader(): string {
      return voronoiEdgeFragmentShader;
    }

    protected parsePatternConfig(container: HTMLElement): Partial<VoronoiEdgeConfig> {
      return {
        cellScale: parseFloat(container.dataset.cellScale || '2.0'),
        edgeThickness: parseFloat(container.dataset.edgeThickness || '0.15'),
        cellAnimSpeed: parseFloat(container.dataset.cellAnimSpeed || '0.2')
      };
    }

    protected createPatternUniforms() {
      return {
        uCellScale: { value: this.config.cellScale },
        uEdgeThickness: { value: this.config.edgeThickness },
        uCellAnimSpeed: { value: this.config.cellAnimSpeed }
      };
    }

    protected updatePatternUniforms(props: Partial<VoronoiEdgeConfig>): void {
      if (!this.material) return;

      if (props.cellScale !== undefined) {
        this.config.cellScale = props.cellScale;
        this.material.uniforms.uCellScale.value = props.cellScale;
      }
      if (props.edgeThickness !== undefined) {
        this.config.edgeThickness = props.edgeThickness;
        this.material.uniforms.uEdgeThickness.value = props.edgeThickness;
      }
      if (props.cellAnimSpeed !== undefined) {
        this.config.cellAnimSpeed = props.cellAnimSpeed;
        this.material.uniforms.uCellAnimSpeed.value = props.cellAnimSpeed;
      }
    }
  }

  // Auto-initialize
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.voronoi-edge-bg').forEach(container => {
      const manager = new VoronoiEdgeBackgroundManager(container as HTMLElement);
      manager.init();
      (container as any)._webglManager = manager;
    });
  });
</script>
