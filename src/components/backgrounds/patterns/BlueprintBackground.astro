---
/**
 * BlueprintBackground - Technical drawing style pattern
 * Creates dimension lines, corner brackets, and measurement markers
 * Uses p5.js for efficient canvas-based rendering
 */
import type { BlueprintBackgroundProps } from './types';

export interface Props extends BlueprintBackgroundProps {}

const {
  speed = 0.2,
  intensity = 0.5,
  noiseScale = 1.0,
  animated = true,
  animationAngle = 315,
  colors,
  maxPixelRatio = 2,
  pauseOffscreen = true,
  class: className = '',
  id = `blueprint-bg-${Math.random().toString(36).substr(2, 9)}`,
  // Blueprint-specific
  elementDensity = 1.0,
  dimensionLength = 0.12,
  lineThickness = 0.001,
  markerSize = 0.006,
  bracketSize = 0.04,
  bracketRatio = 0.3,
  tickDensity = 2
} = Astro.props;
---

<div
  class:list={['p5-background-container', 'blueprint-bg', className]}
  id={id}
  data-effect-type="blueprint"
  data-speed={speed}
  data-intensity={intensity}
  data-noise-scale={noiseScale}
  data-animated={animated}
  data-animation-angle={animationAngle}
  data-colors={JSON.stringify(colors || {})}
  data-max-pixel-ratio={maxPixelRatio}
  data-pause-offscreen={pauseOffscreen}
  data-element-density={elementDensity}
  data-dimension-length={dimensionLength}
  data-line-thickness={lineThickness}
  data-marker-size={markerSize}
  data-bracket-size={bracketSize}
  data-bracket-ratio={bracketRatio}
  data-tick-density={tickDensity}
  aria-hidden="true"
>
  <!-- p5.js will create its own canvas -->
</div>

<style>
  .p5-background-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .p5-background-container :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global([data-theme="minimal"]) .p5-background-container {
    opacity: 0.15;
  }

  @media (prefers-reduced-motion: reduce) {
    .p5-background-container {
      display: none;
    }
  }
</style>

<script>
  import { BlueprintP5Manager } from './p5/patterns/blueprint.p5';

  // Auto-initialize
  function initBlueprintBackgrounds() {
    document.querySelectorAll('.blueprint-bg').forEach(container => {
      if ((container as any)._p5Manager) return;
      const manager = new BlueprintP5Manager(container as HTMLElement);
      manager.init();
      (container as any)._p5Manager = manager;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlueprintBackgrounds);
  } else {
    initBlueprintBackgrounds();
  }
</script>
