---
/**
 * MinimalLinesBackground - Sparse diagonal lines pattern
 * Creates scattered dashes, diagonal lines, and crosshatch fragments
 * Uses p5.js for efficient canvas-based rendering
 */
import type { MinimalLinesBackgroundProps } from './types';

export interface Props extends MinimalLinesBackgroundProps {}

const {
  speed = 0.3,
  intensity = 0.5,
  noiseScale = 1.0,
  animated = true,
  animationAngle = 315,
  colors,
  maxPixelRatio = 2,
  pauseOffscreen = true,
  class: className = '',
  id = `minimal-lines-bg-${Math.random().toString(36).substr(2, 9)}`,
  // MinimalLines-specific
  lineDensity = 8.0,
  lineLength = 0.15,
  lengthVariation = 0.6,
  lineThickness = 0.003,
  angleVariation = 45,
  baseAngle = 45,
  crosshatchChance = 0.2,
  fillRatio = 0.5
} = Astro.props;
---

<div
  class:list={['p5-background-container', 'minimal-lines-bg', className]}
  id={id}
  data-effect-type="minimal-lines"
  data-speed={speed}
  data-intensity={intensity}
  data-noise-scale={noiseScale}
  data-animated={animated}
  data-animation-angle={animationAngle}
  data-colors={JSON.stringify(colors || {})}
  data-max-pixel-ratio={maxPixelRatio}
  data-pause-offscreen={pauseOffscreen}
  data-line-density={lineDensity}
  data-line-length={lineLength}
  data-length-variation={lengthVariation}
  data-line-thickness={lineThickness}
  data-angle-variation={angleVariation}
  data-base-angle={baseAngle}
  data-crosshatch-chance={crosshatchChance}
  data-fill-ratio={fillRatio}
  aria-hidden="true"
>
  <!-- p5.js will create its own canvas -->
</div>

<style>
  .p5-background-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .p5-background-container :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global([data-theme="minimal"]) .p5-background-container {
    opacity: 0.15;
  }

  @media (prefers-reduced-motion: reduce) {
    .p5-background-container {
      display: none;
    }
  }
</style>

<script>
  import { MinimalLinesP5Manager } from './p5/patterns/minimal-lines.p5';

  // Auto-initialize
  function initMinimalLinesBackgrounds() {
    document.querySelectorAll('.minimal-lines-bg').forEach(container => {
      if ((container as any)._p5Manager) return;
      const manager = new MinimalLinesP5Manager(container as HTMLElement);
      manager.init();
      (container as any)._p5Manager = manager;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMinimalLinesBackgrounds);
  } else {
    initMinimalLinesBackgrounds();
  }
</script>
