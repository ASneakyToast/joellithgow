---
/**
 * FloatingShapesBackground - Sparse drifting geometric shapes
 * Creates scattered triangles, hexagons, and circles that float slowly
 * Uses p5.js for efficient canvas-based rendering
 */
import type { FloatingShapesBackgroundProps } from './types';

export interface Props extends FloatingShapesBackgroundProps {}

const {
  speed = 0.3,
  intensity = 0.5,
  noiseScale = 1.0,
  animated = true,
  animationAngle = 315,
  colors,
  maxPixelRatio = 2,
  pauseOffscreen = true,
  class: className = '',
  id = `floating-shapes-bg-${Math.random().toString(36).substr(2, 9)}`,
  // FloatingShapes-specific
  shapeDensity = 1.5,
  shapeSize = 0.05,
  sizeVariation = 0.5,
  shapeMix = 0.5,
  edgeSoftness = 0.005,
  rotationSpeed = 0.2
} = Astro.props;
---

<div
  class:list={['p5-background-container', 'floating-shapes-bg', className]}
  id={id}
  data-effect-type="floating-shapes"
  data-speed={speed}
  data-intensity={intensity}
  data-noise-scale={noiseScale}
  data-animated={animated}
  data-animation-angle={animationAngle}
  data-colors={JSON.stringify(colors || {})}
  data-max-pixel-ratio={maxPixelRatio}
  data-pause-offscreen={pauseOffscreen}
  data-shape-density={shapeDensity}
  data-shape-size={shapeSize}
  data-size-variation={sizeVariation}
  data-shape-mix={shapeMix}
  data-edge-softness={edgeSoftness}
  data-rotation-speed={rotationSpeed}
  aria-hidden="true"
>
  <!-- p5.js will create its own canvas -->
</div>

<style>
  .p5-background-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .p5-background-container :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global([data-theme="minimal"]) .p5-background-container {
    opacity: 0.15;
  }

  @media (prefers-reduced-motion: reduce) {
    .p5-background-container {
      display: none;
    }
  }
</style>

<script>
  import { FloatingShapesP5Manager } from './p5/patterns/floating-shapes.p5';

  // Auto-initialize
  function initFloatingShapesBackgrounds() {
    document.querySelectorAll('.floating-shapes-bg').forEach(container => {
      if ((container as any)._p5Manager) return;
      const manager = new FloatingShapesP5Manager(container as HTMLElement);
      manager.init();
      (container as any)._p5Manager = manager;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFloatingShapesBackgrounds);
  } else {
    initFloatingShapesBackgrounds();
  }
</script>
