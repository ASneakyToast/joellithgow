---
/**
 * PerlinBackground - Classic gradient noise patterns
 * Uses Perlin noise with FBM layering for smooth, organic variations
 */
import type { PerlinBackgroundProps } from './types';

export interface Props extends PerlinBackgroundProps {}

const {
  speed = 0.5,
  intensity = 0.6,
  noiseScale = 2.0,
  animated = true,
  animationAngle = 315,
  colors,
  maxPixelRatio = 2,
  pauseOffscreen = true,
  class: className = '',
  id = `perlin-bg-${Math.random().toString(36).substr(2, 9)}`,
  // FBM params
  octaves = 4,
  lacunarity = 2.0,
  gain = 0.5,
  // Perlin-specific
  timeScaleX = 1.0,
  timeScaleY = 0.7
} = Astro.props;
---

<div
  class:list={['webgl-background-container', 'noise-texture', 'perlin-bg', className]}
  id={id}
  data-effect-type="perlin"
  data-speed={speed}
  data-intensity={intensity}
  data-noise-scale={noiseScale}
  data-animated={animated}
  data-animation-angle={animationAngle}
  data-colors={JSON.stringify(colors || {})}
  data-max-pixel-ratio={maxPixelRatio}
  data-pause-offscreen={pauseOffscreen}
  data-octaves={octaves}
  data-lacunarity={lacunarity}
  data-gain={gain}
  data-time-scale-x={timeScaleX}
  data-time-scale-y={timeScaleY}
  aria-hidden="true"
>
  <canvas class="webgl-canvas"></canvas>
</div>

<style>
  .webgl-background-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .webgl-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global([data-theme="minimal"]) .noise-texture {
    opacity: 0.15;
  }

  @media (prefers-reduced-motion: reduce) {
    .webgl-background-container {
      display: none;
    }
  }
</style>

<script>
  import * as THREE from 'three';
  import { NoiseBackgroundManager } from './NoiseBackgroundManager';
  import { perlinFragmentShader } from './shaders/fragments/perlin.glsl';
  import { createFBMUniforms } from './shaders/uniforms';

  interface PerlinConfig {
    speed: number;
    intensity: number;
    noiseScale: number;
    animated: boolean;
    animationAngle: number;
    maxPixelRatio: number;
    pauseOffscreen: boolean;
    colors: Record<string, string>;
    octaves: number;
    lacunarity: number;
    gain: number;
    timeScaleX: number;
    timeScaleY: number;
  }

  class PerlinBackgroundManager extends NoiseBackgroundManager<PerlinConfig> {
    protected getFragmentShader(): string {
      return perlinFragmentShader;
    }

    protected parsePatternConfig(container: HTMLElement): Partial<PerlinConfig> {
      return {
        octaves: parseInt(container.dataset.octaves || '4'),
        lacunarity: parseFloat(container.dataset.lacunarity || '2.0'),
        gain: parseFloat(container.dataset.gain || '0.5'),
        timeScaleX: parseFloat(container.dataset.timeScaleX || '1.0'),
        timeScaleY: parseFloat(container.dataset.timeScaleY || '0.7')
      };
    }

    protected createPatternUniforms() {
      return {
        ...createFBMUniforms({
          octaves: this.config.octaves,
          lacunarity: this.config.lacunarity,
          gain: this.config.gain
        }),
        uTimeScaleX: { value: this.config.timeScaleX },
        uTimeScaleY: { value: this.config.timeScaleY }
      };
    }

    protected updatePatternUniforms(props: Partial<PerlinConfig>): void {
      if (!this.material) return;

      if (props.octaves !== undefined) {
        this.config.octaves = props.octaves;
        this.material.uniforms.uOctaves.value = props.octaves;
      }
      if (props.lacunarity !== undefined) {
        this.config.lacunarity = props.lacunarity;
        this.material.uniforms.uLacunarity.value = props.lacunarity;
      }
      if (props.gain !== undefined) {
        this.config.gain = props.gain;
        this.material.uniforms.uGain.value = props.gain;
      }
      if (props.timeScaleX !== undefined) {
        this.config.timeScaleX = props.timeScaleX;
        this.material.uniforms.uTimeScaleX.value = props.timeScaleX;
      }
      if (props.timeScaleY !== undefined) {
        this.config.timeScaleY = props.timeScaleY;
        this.material.uniforms.uTimeScaleY.value = props.timeScaleY;
      }
    }
  }

  // Auto-initialize
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.perlin-bg').forEach(container => {
      const manager = new PerlinBackgroundManager(container as HTMLElement);
      manager.init();
      (container as any)._webglManager = manager;
    });
  });
</script>
