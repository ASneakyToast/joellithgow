---
/**
 * DomainWarpBackground - Fluid distortion patterns
 * Creates swirling effects by warping coordinate space with noise
 */
import type { DomainWarpBackgroundProps } from './types';

export interface Props extends DomainWarpBackgroundProps {}

const {
  speed = 0.3,
  intensity = 0.5,
  noiseScale = 1.5,
  animated = true,
  animationAngle = 315,
  colors,
  maxPixelRatio = 2,
  pauseOffscreen = true,
  class: className = '',
  id = `domain-warp-bg-${Math.random().toString(36).substr(2, 9)}`,
  // Domain Warp-specific
  warpStrength = 4.0,
  warpLayers = 2
} = Astro.props;
---

<div
  class:list={['webgl-background-container', 'noise-texture', 'domain-warp-bg', className]}
  id={id}
  data-effect-type="domainWarp"
  data-speed={speed}
  data-intensity={intensity}
  data-noise-scale={noiseScale}
  data-animated={animated}
  data-animation-angle={animationAngle}
  data-colors={JSON.stringify(colors || {})}
  data-max-pixel-ratio={maxPixelRatio}
  data-pause-offscreen={pauseOffscreen}
  data-warp-strength={warpStrength}
  data-warp-layers={warpLayers}
  aria-hidden="true"
>
  <canvas class="webgl-canvas"></canvas>
</div>

<style>
  .webgl-background-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .webgl-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global([data-theme="minimal"]) .noise-texture {
    opacity: 0.15;
  }

  @media (prefers-reduced-motion: reduce) {
    .webgl-background-container {
      display: none;
    }
  }
</style>

<script>
  import * as THREE from 'three';
  import { NoiseBackgroundManager } from './NoiseBackgroundManager';
  import { domainWarpFragmentShader } from './shaders/fragments/domain-warp.glsl';

  interface DomainWarpConfig {
    speed: number;
    intensity: number;
    noiseScale: number;
    animated: boolean;
    animationAngle: number;
    maxPixelRatio: number;
    pauseOffscreen: boolean;
    colors: Record<string, string>;
    warpStrength: number;
    warpLayers: number;
  }

  class DomainWarpBackgroundManager extends NoiseBackgroundManager<DomainWarpConfig> {
    protected getFragmentShader(): string {
      return domainWarpFragmentShader;
    }

    protected parsePatternConfig(container: HTMLElement): Partial<DomainWarpConfig> {
      return {
        warpStrength: parseFloat(container.dataset.warpStrength || '4.0'),
        warpLayers: parseInt(container.dataset.warpLayers || '2')
      };
    }

    protected createPatternUniforms() {
      return {
        uWarpStrength: { value: this.config.warpStrength },
        uWarpLayers: { value: this.config.warpLayers }
      };
    }

    protected updatePatternUniforms(props: Partial<DomainWarpConfig>): void {
      if (!this.material) return;

      if (props.warpStrength !== undefined) {
        this.config.warpStrength = props.warpStrength;
        this.material.uniforms.uWarpStrength.value = props.warpStrength;
      }
      if (props.warpLayers !== undefined) {
        this.config.warpLayers = props.warpLayers;
        this.material.uniforms.uWarpLayers.value = props.warpLayers;
      }
    }
  }

  // Auto-initialize
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.domain-warp-bg').forEach(container => {
      const manager = new DomainWarpBackgroundManager(container as HTMLElement);
      manager.init();
      (container as any)._webglManager = manager;
    });
  });
</script>
