---
/**
 * LayersPanel - Layer management panel for Background Studio
 * Displays layer list with selection, drag-to-reorder, and pattern picker
 */
import { PATTERNS } from './patterns/registry';
---

<aside class="layers-panel" id="layers-panel">
  <header class="panel-header">
    <h2>Layers</h2>
    <button class="add-layer-btn" id="add-layer-btn" title="Add Layer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
    </button>
  </header>

  <div class="layers-list" id="layers-list">
    <!-- Layer items rendered by JavaScript -->
    <div class="empty-state" id="empty-state">
      <p>No layers yet</p>
      <button class="add-first-layer-btn" id="add-first-layer-btn">
        Add your first layer
      </button>
    </div>
  </div>

  <!-- Pattern Picker Dropdown -->
  <div class="pattern-picker" id="pattern-picker" hidden>
    <div class="pattern-picker-header">
      <span>Choose Pattern</span>
      <button class="close-picker-btn" id="close-picker-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="pattern-grid">
      {PATTERNS.map(p => (
        <button class="pattern-option" data-pattern={p.internalId}>
          <span class={`pattern-icon ${p.id}`}></span>
          <span class="pattern-name">{p.name}</span>
          {p.isNew && <span class="new-badge">New</span>}
        </button>
      ))}
    </div>
  </div>
</aside>

<style>
  .layers-panel {
    position: fixed;
    top: 24px;
    left: 24px;
    width: 220px;
    max-height: calc(100vh - 48px);
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 12px;
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.12),
      0 0 0 1px rgba(0, 0, 0, 0.05);
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 13px;
    z-index: 1000;
    overflow: hidden;
  }

  :global([data-theme="dark"]) .layers-panel,
  :global([data-theme="neon"]) .layers-panel {
    background: rgba(30, 30, 35, 0.92);
    color: #fff;
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  :global([data-theme="dark"]) .panel-header,
  :global([data-theme="neon"]) .panel-header {
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .panel-header h2 {
    font-size: 14px;
    font-weight: 600;
    margin: 0;
    color: inherit;
  }

  .add-layer-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.05);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .add-layer-btn:hover {
    background: rgba(0, 0, 0, 0.1);
  }

  .add-layer-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  :global([data-theme="dark"]) .add-layer-btn,
  :global([data-theme="neon"]) .add-layer-btn {
    background: rgba(255, 255, 255, 0.1);
  }

  :global([data-theme="dark"]) .add-layer-btn:hover,
  :global([data-theme="neon"]) .add-layer-btn:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .add-layer-btn svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
  }

  /* Layers List */
  .layers-list {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
    min-height: 100px;
    max-height: 400px;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    text-align: center;
    color: rgba(0, 0, 0, 0.4);
  }

  :global([data-theme="dark"]) .empty-state,
  :global([data-theme="neon"]) .empty-state {
    color: rgba(255, 255, 255, 0.4);
  }

  .empty-state p {
    margin: 0 0 12px;
    font-size: 13px;
  }

  .add-first-layer-btn {
    padding: 8px 16px;
    border: 1px dashed rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    background: transparent;
    color: inherit;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .add-first-layer-btn:hover {
    border-color: rgba(0, 0, 0, 0.4);
    background: rgba(0, 0, 0, 0.02);
  }

  :global([data-theme="dark"]) .add-first-layer-btn,
  :global([data-theme="neon"]) .add-first-layer-btn {
    border-color: rgba(255, 255, 255, 0.2);
  }

  :global([data-theme="dark"]) .add-first-layer-btn:hover,
  :global([data-theme="neon"]) .add-first-layer-btn:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.02);
  }

  /* Layer Item (dynamically created) */
  :global(.layer-item) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    margin-bottom: 4px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.03);
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }

  :global(.layer-item:hover) {
    background: rgba(0, 0, 0, 0.06);
  }

  :global(.layer-item.selected) {
    background: rgba(59, 130, 246, 0.12);
    box-shadow: inset 0 0 0 1px rgba(59, 130, 246, 0.3);
  }

  :global(.layer-item.dragging) {
    opacity: 0.5;
    transform: scale(0.98);
  }

  :global(.layer-item.drag-over) {
    transform: translateY(4px);
  }

  :global([data-theme="dark"] .layer-item),
  :global([data-theme="neon"] .layer-item) {
    background: rgba(255, 255, 255, 0.05);
  }

  :global([data-theme="dark"] .layer-item:hover),
  :global([data-theme="neon"] .layer-item:hover) {
    background: rgba(255, 255, 255, 0.08);
  }

  :global([data-theme="dark"] .layer-item.selected),
  :global([data-theme="neon"] .layer-item.selected) {
    background: rgba(59, 130, 246, 0.2);
    box-shadow: inset 0 0 0 1px rgba(59, 130, 246, 0.4);
  }

  :global(.layer-drag-handle) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 24px;
    color: rgba(0, 0, 0, 0.3);
    cursor: grab;
    flex-shrink: 0;
  }

  :global(.layer-drag-handle:active) {
    cursor: grabbing;
  }

  :global([data-theme="dark"] .layer-drag-handle),
  :global([data-theme="neon"] .layer-drag-handle) {
    color: rgba(255, 255, 255, 0.3);
  }

  :global(.layer-preview) {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    flex-shrink: 0;
    background: linear-gradient(135deg, #FF6B6B, #4ECDC4, #FFE66D);
    background-size: 200% 200%;
  }

  :global(.layer-info) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  :global(.layer-name) {
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.layer-type) {
    font-size: 10px;
    color: rgba(0, 0, 0, 0.4);
    text-transform: capitalize;
  }

  :global([data-theme="dark"] .layer-type),
  :global([data-theme="neon"] .layer-type) {
    color: rgba(255, 255, 255, 0.4);
  }

  :global(.layer-delete-btn) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: rgba(0, 0, 0, 0.3);
    cursor: pointer;
    opacity: 0;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  :global(.layer-item:hover .layer-delete-btn) {
    opacity: 1;
  }

  :global(.layer-delete-btn:hover) {
    background: rgba(239, 68, 68, 0.1);
    color: rgb(239, 68, 68);
  }

  :global([data-theme="dark"] .layer-delete-btn),
  :global([data-theme="neon"] .layer-delete-btn) {
    color: rgba(255, 255, 255, 0.3);
  }

  :global([data-theme="dark"] .layer-delete-btn:hover),
  :global([data-theme="neon"] .layer-delete-btn:hover) {
    background: rgba(239, 68, 68, 0.2);
    color: rgb(239, 68, 68);
  }

  :global(.layer-delete-btn svg) {
    width: 14px;
    height: 14px;
  }

  /* Pattern Picker */
  .pattern-picker {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(20px);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    z-index: 10;
  }

  .pattern-picker[hidden] {
    display: none;
  }

  :global([data-theme="dark"]) .pattern-picker,
  :global([data-theme="neon"]) .pattern-picker {
    background: rgba(30, 30, 35, 0.98);
  }

  .pattern-picker-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    font-weight: 600;
    font-size: 14px;
  }

  :global([data-theme="dark"]) .pattern-picker-header,
  :global([data-theme="neon"]) .pattern-picker-header {
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .close-picker-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border: none;
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
    color: inherit;
    opacity: 0.5;
    transition: all 0.15s ease;
  }

  .close-picker-btn:hover {
    opacity: 1;
    background: rgba(0, 0, 0, 0.05);
  }

  :global([data-theme="dark"]) .close-picker-btn:hover,
  :global([data-theme="neon"]) .close-picker-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .close-picker-btn svg {
    width: 16px;
    height: 16px;
  }

  .pattern-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 12px;
    overflow-y: auto;
  }

  .pattern-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 12px 8px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .pattern-option:hover {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.15);
  }

  :global([data-theme="dark"]) .pattern-option,
  :global([data-theme="neon"]) .pattern-option {
    border-color: rgba(255, 255, 255, 0.1);
  }

  :global([data-theme="dark"]) .pattern-option:hover,
  :global([data-theme="neon"]) .pattern-option:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .pattern-icon {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: linear-gradient(135deg, #FF6B6B, #4ECDC4);
  }

  /* Different gradient for each pattern type */
  .pattern-icon.perlin { background: linear-gradient(135deg, #FF6B6B 0%, #4ECDC4 100%); }
  .pattern-icon.simplex { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
  .pattern-icon.worley { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
  .pattern-icon.voronoi-edge { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
  .pattern-icon.turbulence { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); }
  .pattern-icon.ridged { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); }
  .pattern-icon.domain-warp { background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); }
  .pattern-icon.caustics { background: linear-gradient(135deg, #5ee7df 0%, #b490ca 100%); }
  .pattern-icon.marble { background: linear-gradient(135deg, #d299c2 0%, #fef9d7 100%); }

  .pattern-name {
    font-size: 10px;
    font-weight: 500;
    color: inherit;
  }

  /* Responsive */
  @media (max-width: 480px) {
    .layers-panel {
      top: auto;
      bottom: 60px;
      left: 12px;
      right: 12px;
      width: auto;
      max-height: 300px;
    }
  }
</style>

<script>
  import type { LayerConfig } from './studio/types';
  import { PATTERN_NAMES } from './studio/types';
  import type { LayerManager } from './studio/LayerManager';
  import type { NoiseType } from './types';

  class LayersPanelController {
    private layerManager: LayerManager | null = null;
    private layersList: HTMLElement;
    private emptyState: HTMLElement;
    private patternPicker: HTMLElement;
    private addLayerBtn: HTMLElement;
    private addFirstLayerBtn: HTMLElement;
    private closePickerBtn: HTMLElement;
    private patternOptions: NodeListOf<HTMLElement>;
    private draggedItem: HTMLElement | null = null;
    private draggedId: string | null = null;

    constructor() {
      this.layersList = document.getElementById('layers-list')!;
      this.emptyState = document.getElementById('empty-state')!;
      this.patternPicker = document.getElementById('pattern-picker')!;
      this.addLayerBtn = document.getElementById('add-layer-btn')!;
      this.addFirstLayerBtn = document.getElementById('add-first-layer-btn')!;
      this.closePickerBtn = document.getElementById('close-picker-btn')!;
      this.patternOptions = document.querySelectorAll('.pattern-option');

      this.setupEventListeners();
    }

    setLayerManager(manager: LayerManager) {
      this.layerManager = manager;
      this.setupManagerListeners();
    }

    private setupEventListeners() {
      // Add layer buttons
      this.addLayerBtn.addEventListener('click', () => this.showPatternPicker());
      this.addFirstLayerBtn.addEventListener('click', () => this.showPatternPicker());

      // Close picker
      this.closePickerBtn.addEventListener('click', () => this.hidePatternPicker());

      // Pattern selection
      this.patternOptions.forEach(option => {
        option.addEventListener('click', () => {
          const pattern = option.dataset.pattern as NoiseType;
          if (pattern) {
            this.addLayer(pattern);
            this.hidePatternPicker();
          }
        });
      });

      // Click outside to close picker
      this.patternPicker.addEventListener('click', (e) => {
        if (e.target === this.patternPicker) {
          this.hidePatternPicker();
        }
      });

      // Keyboard support
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !this.patternPicker.hidden) {
          this.hidePatternPicker();
        }
        if (e.key === 'Delete' || e.key === 'Backspace') {
          const selected = this.layerManager?.getSelectedLayer();
          if (selected && document.activeElement?.closest('.layers-panel')) {
            e.preventDefault();
            this.deleteLayer(selected.id);
          }
        }
      });
    }

    private setupManagerListeners() {
      if (!this.layerManager) return;

      this.layerManager.addEventListener('layers-changed', ((e: CustomEvent<LayerConfig[]>) => {
        this.renderLayers(e.detail);
      }) as EventListener);

      this.layerManager.addEventListener('layer-selected', ((e: CustomEvent<{ id: string | null; layer: LayerConfig | null }>) => {
        this.updateSelection(e.detail.id);
      }) as EventListener);

      this.layerManager.addEventListener('max-layers-reached', (() => {
        this.addLayerBtn.setAttribute('disabled', 'true');
        this.addLayerBtn.setAttribute('title', 'Maximum layers reached');
      }) as EventListener);
    }

    private showPatternPicker() {
      if (this.layerManager?.isAtMaxLayers()) {
        return;
      }
      this.patternPicker.hidden = false;
    }

    private hidePatternPicker() {
      this.patternPicker.hidden = true;
    }

    private async addLayer(patternType: NoiseType) {
      await this.layerManager?.addLayer(patternType);
    }

    private deleteLayer(id: string) {
      this.layerManager?.removeLayer(id);
    }

    private selectLayer(id: string) {
      this.layerManager?.selectLayer(id);
    }

    private renderLayers(layers: LayerConfig[]) {
      // Show/hide empty state
      if (layers.length === 0) {
        this.emptyState.style.display = 'flex';
        // Remove any existing layer items
        const items = this.layersList.querySelectorAll('.layer-item');
        items.forEach(item => item.remove());
        return;
      }

      this.emptyState.style.display = 'none';

      // Update add button state
      if (this.layerManager?.isAtMaxLayers()) {
        this.addLayerBtn.setAttribute('disabled', 'true');
      } else {
        this.addLayerBtn.removeAttribute('disabled');
      }

      // Clear existing items (except empty state)
      const existingItems = this.layersList.querySelectorAll('.layer-item');
      existingItems.forEach(item => item.remove());

      // Render layers in reverse order (top layer first in UI)
      const reversedLayers = [...layers].reverse();
      reversedLayers.forEach(layer => {
        const item = this.createLayerItem(layer);
        this.layersList.appendChild(item);
      });
    }

    private createLayerItem(layer: LayerConfig): HTMLElement {
      const item = document.createElement('div');
      item.className = 'layer-item';
      item.dataset.layerId = layer.id;
      item.draggable = true;

      // Check if selected
      if (this.layerManager?.getSelectedLayer()?.id === layer.id) {
        item.classList.add('selected');
      }

      // Get gradient colors for preview
      const colors = layer.config.colors;
      const gradient = `linear-gradient(135deg, ${colors.primary}, ${colors.secondary}, ${colors.tertiary})`;

      item.innerHTML = `
        <span class="layer-drag-handle" title="Drag to reorder">⋮⋮</span>
        <span class="layer-preview" style="background: ${gradient}"></span>
        <div class="layer-info">
          <span class="layer-name">${layer.name}</span>
          <span class="layer-type">${PATTERN_NAMES[layer.patternType]}</span>
        </div>
        <button class="layer-delete-btn" title="Delete layer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
          </svg>
        </button>
      `;

      // Click to select
      item.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target.closest('.layer-delete-btn') && !target.closest('.layer-drag-handle')) {
          this.selectLayer(layer.id);
        }
      });

      // Delete button
      const deleteBtn = item.querySelector('.layer-delete-btn');
      deleteBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.deleteLayer(layer.id);
      });

      // Drag and drop
      this.setupDragEvents(item, layer.id);

      return item;
    }

    private setupDragEvents(item: HTMLElement, layerId: string) {
      item.addEventListener('dragstart', (e) => {
        this.draggedItem = item;
        this.draggedId = layerId;
        item.classList.add('dragging');
        e.dataTransfer!.effectAllowed = 'move';
        e.dataTransfer!.setData('text/plain', layerId);
      });

      item.addEventListener('dragend', () => {
        if (this.draggedItem) {
          this.draggedItem.classList.remove('dragging');
        }
        this.draggedItem = null;
        this.draggedId = null;
        // Remove drag-over class from all items
        this.layersList.querySelectorAll('.layer-item').forEach(el => {
          el.classList.remove('drag-over');
        });
      });

      item.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (this.draggedId && this.draggedId !== layerId) {
          item.classList.add('drag-over');
        }
      });

      item.addEventListener('dragleave', () => {
        item.classList.remove('drag-over');
      });

      item.addEventListener('drop', (e) => {
        e.preventDefault();
        item.classList.remove('drag-over');

        if (!this.draggedId || this.draggedId === layerId) return;

        // Get the index of the target item
        const items = Array.from(this.layersList.querySelectorAll('.layer-item'));
        const targetIndex = items.indexOf(item);

        // Layers are rendered in reverse order, so we need to convert
        const layers = this.layerManager?.getAllLayers() || [];
        const newIndex = layers.length - 1 - targetIndex;

        this.layerManager?.reorderLayer(this.draggedId, newIndex);
      });
    }

    private updateSelection(selectedId: string | null) {
      const items = this.layersList.querySelectorAll('.layer-item');
      items.forEach(item => {
        const el = item as HTMLElement;
        if (el.dataset.layerId === selectedId) {
          el.classList.add('selected');
        } else {
          el.classList.remove('selected');
        }
      });
    }
  }

  // Initialize controller
  const controller = new LayersPanelController();

  // Listen for LayerManager to be ready
  document.addEventListener('layer-manager-ready', ((e: CustomEvent<LayerManager>) => {
    controller.setLayerManager(e.detail);
  }) as EventListener);

  // Also check if already available (window global)
  if (window.__studioLayerManager) {
    controller.setLayerManager(window.__studioLayerManager);
  }
</script>
