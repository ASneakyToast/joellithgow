---
/**
 * NoiseTextureBackground - DEPRECATED
 *
 * This component is maintained for backward compatibility.
 * For new code, use the pattern-specific components instead:
 *
 * @example
 * ```astro
 * import { SimplexBackground, CausticsBackground } from '@components/backgrounds/noise';
 *
 * <SimplexBackground speed={0.5} intensity={0.6} />
 * ```
 *
 * Available components:
 * - PerlinBackground
 * - SimplexBackground
 * - WorleyBackground
 * - VoronoiEdgeBackground
 * - TurbulenceBackground
 * - RidgedBackground
 * - DomainWarpBackground
 * - CausticsBackground
 * - MarbleBackground
 */
import type { NoiseTextureProps, NoiseType } from './types';

// Import all pattern components
import PerlinBackground from './patterns/PerlinBackground.astro';
import SimplexBackground from './patterns/SimplexBackground.astro';
import WorleyBackground from './patterns/WorleyBackground.astro';
import VoronoiEdgeBackground from './patterns/VoronoiEdgeBackground.astro';
import TurbulenceBackground from './patterns/TurbulenceBackground.astro';
import RidgedBackground from './patterns/RidgedBackground.astro';
import DomainWarpBackground from './patterns/DomainWarpBackground.astro';
import CausticsBackground from './patterns/CausticsBackground.astro';
import MarbleBackground from './patterns/MarbleBackground.astro';

export interface Props extends NoiseTextureProps {}

const {
  noiseType = 'simplex',
  speed,
  intensity,
  colors,
  noiseScale,
  animated,
  animationAngle,
  maxPixelRatio,
  pauseOffscreen,
  class: className,
  id,
  // FBM parameters
  octaves,
  lacunarity,
  gain,
  // Perlin/Simplex parameters
  timeScaleX,
  timeScaleY,
  // Worley/Voronoi parameters
  cellScale,
  cellAnimSpeed,
  invert,
  edgeThickness,
  // Turbulence parameters
  sharpness,
  // Ridged parameters
  ridgeSharpness,
  ridgeTimeScale,
  // Domain Warp parameters
  warpStrength,
  warpLayers,
  // Caustics parameters
  waveCount,
  waveFrequency,
  waveSharpness,
  detailAmount,
  // Marble parameters
  lineFrequency,
  noiseInfluence,
  detailBlend
} = Astro.props;

// Common props passed to all patterns
const baseProps = {
  speed,
  intensity,
  colors,
  noiseScale,
  animated,
  animationAngle,
  maxPixelRatio,
  pauseOffscreen,
  class: className,
  id
};
---

{noiseType === 'perlin' && (
  <PerlinBackground
    {...baseProps}
    octaves={octaves}
    lacunarity={lacunarity}
    gain={gain}
    timeScaleX={timeScaleX}
    timeScaleY={timeScaleY}
  />
)}

{noiseType === 'simplex' && (
  <SimplexBackground
    {...baseProps}
    octaves={octaves}
    lacunarity={lacunarity}
    gain={gain}
    timeScaleX={timeScaleX}
    timeScaleY={timeScaleY}
  />
)}

{noiseType === 'worley' && (
  <WorleyBackground
    {...baseProps}
    cellScale={cellScale}
    cellAnimSpeed={cellAnimSpeed}
    invert={invert}
  />
)}

{noiseType === 'voronoiEdge' && (
  <VoronoiEdgeBackground
    {...baseProps}
    cellScale={cellScale}
    edgeThickness={edgeThickness}
    cellAnimSpeed={cellAnimSpeed}
  />
)}

{noiseType === 'turbulence' && (
  <TurbulenceBackground
    {...baseProps}
    octaves={octaves}
    lacunarity={lacunarity}
    gain={gain}
    sharpness={sharpness}
  />
)}

{noiseType === 'ridged' && (
  <RidgedBackground
    {...baseProps}
    octaves={octaves}
    lacunarity={lacunarity}
    gain={gain}
    ridgeSharpness={ridgeSharpness}
    ridgeTimeScale={ridgeTimeScale}
  />
)}

{noiseType === 'domainWarp' && (
  <DomainWarpBackground
    {...baseProps}
    warpStrength={warpStrength}
    warpLayers={warpLayers}
  />
)}

{noiseType === 'caustics' && (
  <CausticsBackground
    {...baseProps}
    waveCount={waveCount}
    waveFrequency={waveFrequency}
    waveSharpness={waveSharpness}
    detailAmount={detailAmount}
  />
)}

{noiseType === 'marble' && (
  <MarbleBackground
    {...baseProps}
    octaves={octaves}
    lacunarity={lacunarity}
    gain={gain}
    lineFrequency={lineFrequency}
    noiseInfluence={noiseInfluence}
    detailBlend={detailBlend}
  />
)}

<script>
  // Deprecation warning (only in development)
  if (import.meta.env.DEV) {
    console.warn(
      '[NoiseTextureBackground] This component is deprecated. ' +
      'Use pattern-specific components instead:\n' +
      '  import { SimplexBackground } from "@components/backgrounds/noise";\n' +
      '  <SimplexBackground speed={0.5} />'
    );
  }
</script>
