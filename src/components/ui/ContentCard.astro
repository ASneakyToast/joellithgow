---
// Reusable content card for both projects and blog posts
export interface Props {
  type: 'project' | 'blog';
  title: string;
  description: string;
  tags?: string[];
  image?: string;
  imageType?: 'image' | 'video';
  url: string;
  featured?: boolean;
  date?: Date;
  readingTime?: number;
}

const {
  type,
  title,
  description,
  tags = [],
  image,
  imageType = 'image',
  url,
  featured = false,
  date,
  readingTime
} = Astro.props;

// Determine badge color and label based on type
const badgeConfig = {
  project: {
    label: 'Project',
    color: 'var(--accent-primary)',
    borderColor: 'var(--bg-dark)'
  },
  blog: {
    label: 'Blog Post',
    color: 'var(--accent-secondary)',
    borderColor: 'var(--bg-dark)'
  }
};

const config = badgeConfig[type];
---

<article class={`content-card ${featured ? 'featured' : ''} ${!image ? 'no-image' : ''}`}>
  <a href={url} class="card-link">
    <div class="card-header">
      <span class="type-badge" style={`background: ${config.color}; border-color: ${config.borderColor};`}>
        {config.label}
      </span>
      {date && (
        <time datetime={date.toISOString()} class="card-date">
          {date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
        </time>
      )}
    </div>

    {image && (
      <div class="card-image">
        {imageType === 'video' ? (
          <video autoplay muted loop playsinline>
            <source src={image} type="video/webm" />
          </video>
        ) : (
          <img src={image} alt={title} loading="lazy" />
        )}
      </div>
    )}

    <div class="card-content">
      <h3 class="card-title">{title}</h3>

      {/* Only show description if there's no image */}
      {!image && (
        <p class="card-description">{description}</p>
      )}

      {tags && tags.length > 0 && (
        <div class="card-tags">
          {tags.slice(0, 3).map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}

      {readingTime && (
        <div class="reading-time">
          {readingTime} min read
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .content-card {
    background: var(--bg-secondary);
    border: var(--border-width) solid var(--bg-dark);
    border-radius: var(--border-radius);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .content-card:nth-child(odd) {
    transform: var(--rotation-sm);
  }

  .content-card:nth-child(even) {
    transform: rotate(0.5deg);
  }

  .content-card:hover {
    transform: scale(1.03);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
    z-index: 2;
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
    background: var(--bg-dark);
    color: var(--text-light);
  }

  .type-badge {
    font-size: 11px;
    padding: 5px 10px;
    border: 2px solid;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-light);
  }

  .card-date {
    font-size: 11px;
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .card-image {
    width: 100%;
    height: 140px;
    overflow: hidden;
    background: var(--bg-primary);
    border-bottom: 3px solid var(--bg-dark);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-image img,
  .card-image video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .content-card:hover .card-image img,
  .content-card:hover .card-image video {
    transform: scale(1.05);
  }

  .card-content {
    padding: 20px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 10px;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .card-description {
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-bottom: 15px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 15px;
  }

  /* When there IS a description (no-image cards), push tags to bottom */
  .content-card.no-image .card-tags {
    margin-top: auto;
  }

  .tag {
    background: var(--accent-tertiary);
    color: var(--bg-dark);
    padding: 4px 8px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: 1px solid var(--bg-dark);
    font-weight: bold;
  }

  .reading-time {
    font-size: 11px;
    color: var(--text-secondary);
    margin-top: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: bold;
  }

  /* No image variant - more compact */
  .content-card.no-image .card-content {
    padding: 25px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .card-image {
      height: 120px;
    }
  }

  /* Focus styles for accessibility */
  .card-link:focus {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .content-card:hover {
      transform: scale(1.01);
    }

    .content-card:hover .card-image img,
    .content-card:hover .card-image video {
      transform: scale(1);
    }
  }
</style>
