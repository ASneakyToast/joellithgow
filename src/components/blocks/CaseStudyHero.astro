---
import Video from '@components/ui/Video.astro';

export interface Props {
  title: string;
  subtitle: string;
  overview: string;
  media?: {
    src: string;
    fallbackSrc?: string;
    poster?: string;
    alt: string;
    type?: 'image' | 'video';
  };
}

const { title, subtitle, overview, media } = Astro.props;
---

<div class="case-hero">
  <div class="case-subtitle">{subtitle}</div>
  <h1 class="case-title">{title}</h1>
  <p class="case-overview">{overview}</p>

  {media && (
    <div class="case-image-gallery hero-image">
      {media.type === 'video' ? (
        <Video
          src={media.src}
          fallbackSrc={media.fallbackSrc}
          poster={media.poster}
          class="case-image primary-image"
        />
      ) : (
        <img src={media.src} alt={media.alt} class="case-image primary-image" loading="eager" />
      )}
    </div>
  )}
</div>
