---
export interface Props {
  images: Array<{
    src: string;
    alt: string;
    caption?: string;
    type?: 'image' | 'video';
  }>;
  title?: string;
}

const { images, title = 'visual documentation' } = Astro.props;
---

<div class="case-section">
  <h2 class="section-title">{title}</h2>
  <div class="image-grid">
    {images.map((image) => (
      <div class="image-item">
        {image.type === 'video' ? (
          <video class="case-image gallery-image" autoplay muted loop playsinline controls>
            <source src={image.src} type="video/webm" />
            Your browser does not support the video tag.
          </video>
        ) : (
          <img src={image.src} alt={image.alt} class="case-image gallery-image" loading="lazy" />
        )}
        {image.caption && <div class="image-caption">{image.caption}</div>}
      </div>
    ))}
  </div>
</div>
