---
import Video from '@components/ui/Video.astro';

export interface Props {
  src: string;
  fallbackSrc?: string;
  poster?: string;
  alt: string;
  type?: 'image' | 'video';
  framed?: boolean; // Add border, shadow, and border-radius for screenshots
}

const { src, fallbackSrc, poster, alt, type = 'image', framed = false } = Astro.props;
---

<div class="case-section full-width-media">
  <div class="full-width-container">
    {type === 'video' ? (
      <Video
        src={src}
        fallbackSrc={fallbackSrc}
        poster={poster}
        class={framed ? "full-width-asset media-frame" : "full-width-asset"}
      />
    ) : (
      <img
        src={src}
        alt={alt}
        class:list={["full-width-asset", { "media-frame": framed }]}
        loading="lazy"
      />
    )}
  </div>
</div>

<style>
  .full-width-media {
    padding: 0 !important;
    margin: var(--space-2xl) 0;
  }

  .full-width-container {
    width: 100%;
  }

  .full-width-asset {
    width: 100%;
    height: auto;
    display: block;
  }

</style>
