---
import Video from '@components/ui/Video.astro';

export interface Props {
  src: string;
  fallbackSrc?: string;
  poster?: string;
  alt: string;
  caption?: string;
  type?: 'image' | 'video';
}

const { src, fallbackSrc, poster, alt, caption, type = 'image' } = Astro.props;
---

<div class="case-section full-width-media">
  <div class="full-width-container">
    {type === 'video' ? (
      <Video
        src={src}
        fallbackSrc={fallbackSrc}
        poster={poster}
        class="full-width-asset"
      />
    ) : (
      <img src={src} alt={alt} class="full-width-asset" loading="lazy" />
    )}
    {caption && <div class="image-caption">{caption}</div>}
  </div>
</div>

<style>
  .full-width-media {
    padding: 0 !important;
    margin: var(--space-2xl) 0;
  }

  .full-width-container {
    width: 100%;
  }

  .full-width-asset {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--gradient-primary-subtle);
  }

  .full-width-media .image-caption {
    padding: var(--space-md) var(--space-xl);
  }
</style>
