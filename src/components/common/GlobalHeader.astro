---
/**
 * GlobalHeader - Context-aware breadcrumb header with scroll trigger
 * Shows breadcrumb navigation based on current section
 */

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Detect current page to show appropriate breadcrumb
const currentPath = Astro.url.pathname;
const isWorkPage = currentPath.startsWith('/work');
const isBlogPage = currentPath.startsWith('/blog');
const isArtworksPage = currentPath.startsWith('/artworks');
const isAboutPage = currentPath.startsWith('/about');

// Build breadcrumb links based on section
const breadcrumbs = [];
if (isWorkPage) {
  breadcrumbs.push(
    { href: '/', label: 'joel lithgow' },
    { href: '/work', label: 'portfolio' }
  );
} else if (isBlogPage) {
  breadcrumbs.push(
    { href: '/', label: 'joel lithgow' },
    { href: '/blog', label: 'blog' }
  );
} else if (isArtworksPage) {
  breadcrumbs.push(
    { href: '/', label: 'joel lithgow' },
    { href: '/artworks', label: 'artwork' }
  );
} else if (isAboutPage) {
  breadcrumbs.push(
    { href: '/', label: 'joel lithgow' },
    { href: '/about', label: 'about' }
  );
} else {
  // Default: just home link
  breadcrumbs.push({ href: '/', label: 'joel lithgow' });
}
---

<header class={`global-header ${className || ''}`}>
  <nav class="breadcrumb-nav">
    {breadcrumbs.map((item, index) => (
      <span class="breadcrumb-item">
        <a href={item.href} class="logo-link" aria-label={`Go to ${item.label}`}>
          {item.label}
        </a>
        {index < breadcrumbs.length - 1 && <span class="breadcrumb-separator">›</span>}
      </span>
    ))}
  </nav>
</header>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  .global-header {
    position: fixed;
    top: var(--space-lg);
    left: 50%;
    transform: translateX(-50%) translateY(-80px) var(--rotation-sm);
    z-index: var(--z-sticky);

    /* Pill styling matching Navigation component */
    background: var(--bg-secondary);
    border: var(--border-width) solid var(--accent-primary);
    border-radius: var(--border-radius);
    padding: var(--space-sm) var(--space-lg);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
    backdrop-filter: blur(10px);

    /* Start hidden */
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out),
                transform var(--duration-slow) var(--ease-out);
    pointer-events: none;
  }

  /* Visible state triggered by scroll */
  .global-header.visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0) var(--rotation-sm);
    pointer-events: auto;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .breadcrumb-separator {
    color: var(--accent-primary);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    user-select: none;
  }

  .logo-link {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    text-decoration: none;
    text-transform: lowercase;
    transition: all var(--duration-base) var(--ease-out);
    padding: var(--space-2xs) var(--space-xs);
  }

  .logo-link:hover {
    color: var(--accent-primary);
    transform: scale(1.05);
  }

  .logo-link:focus-visible {
    outline: var(--border-width) solid var(--accent-primary);
    outline-offset: var(--space-xs);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .global-header {
      top: var(--space-md);
      padding: var(--space-xs) var(--space-md);
    }

    .logo-link {
      font-size: var(--text-xs);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .global-header {
      transition: opacity var(--duration-fast) ease;
    }

    .global-header.visible {
      transform: translateX(-50%) translateY(0);
    }

    .logo-link {
      transition: none;
    }

    .logo-link:hover {
      transform: none;
    }
  }
</style>

<script>
  // Show header after scrolling down
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.querySelector('.global-header');
    if (!header) return;

    const showHeader = () => {
      // Show after scrolling past 100vh or 800px (whichever is smaller)
      const triggerPoint = Math.min(window.innerHeight, 800);

      if (window.scrollY > triggerPoint) {
        header.classList.add('visible');
      } else {
        header.classList.remove('visible');
      }
    };

    // Check on scroll
    window.addEventListener('scroll', showHeader);

    // Check on load in case user refreshed mid-page
    showHeader();
  });
</script>
