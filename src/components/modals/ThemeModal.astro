---
// Theme selection modal using Modal primitive
import Modal from '@components/primitives/Modal.astro';
import Card from '@components/primitives/Card.astro';
---

<Modal id="themeModal" title="Choose Your Theme" size="md">
  <div class="theme-options-grid">
    <Card
      variant="interactive"
      interactive
      class="theme-option"
      data-theme="default"
    >
      <div class="theme-preview theme-preview-default"></div>
      <span class="theme-name">Default</span>
    </Card>
    <Card
      variant="interactive"
      interactive
      class="theme-option"
      data-theme="minimal"
    >
      <div class="theme-preview theme-preview-minimal"></div>
      <span class="theme-name">Minimal</span>
    </Card>
  </div>
</Modal>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  .theme-options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-lg);
    padding: var(--space-xl);
  }

  .theme-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
    cursor: pointer;
    border: 2px solid transparent;
    transition: all var(--duration-base) var(--ease-out);
  }

  .theme-option:hover {
    border-color: var(--accent-secondary);
    transform: translateY(-3px);
  }

  .theme-option.active {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
  }

  .theme-option.active .theme-name {
    color: var(--text-light);
  }

  .theme-preview {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-full);
    position: relative;
    overflow: hidden;
    border: var(--border-width) solid currentColor;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .theme-option:hover .theme-preview {
    transform: scale(1.1);
  }

  /* Theme preview colors */
  .theme-preview-default {
    background: linear-gradient(135deg, #ff6b6b, #4ecdc4, #ffe66d);
  }

  .theme-preview-minimal {
    background: linear-gradient(135deg, #000000, #333333, #666666);
  }

  .theme-name {
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    color: var(--text-primary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .theme-options-grid {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: var(--space-md);
      padding: var(--space-lg);
    }

    .theme-option {
      padding: var(--space-md);
    }

    .theme-preview {
      width: 60px;
      height: 60px;
    }

    .theme-name {
      font-size: var(--text-sm);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .theme-option,
    .theme-preview {
      transition: none;
    }
  }
</style>

<script>
  // Theme Management System
  class ThemeManager {
    private themes: string[] = ['default', 'minimal'];
    private currentTheme: string;

    constructor() {
      this.currentTheme = this.loadTheme();
      this.init();
    }

    init() {
      this.applyTheme(this.currentTheme);
      this.setupEventListeners();
    }

    setupEventListeners() {
      // Theme option clicks
      document.querySelectorAll('.theme-option').forEach((option) => {
        const htmlOption = option as HTMLElement;
        htmlOption.addEventListener('click', () => {
          const theme = htmlOption.dataset.theme;
          if (theme) {
            this.setTheme(theme);
            (window as any).closeModal?.('themeModal');
          }
        });

        // Preview on hover
        htmlOption.addEventListener('mouseenter', () => {
          if (!htmlOption.classList.contains('active')) {
            const theme = htmlOption.dataset.theme;
            if (theme) {
              this.previewTheme(theme);
            }
          }
        });

        htmlOption.addEventListener('mouseleave', () => {
          if (!htmlOption.classList.contains('active')) {
            this.applyTheme(this.currentTheme);
          }
        });
      });

      // Global keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 't') {
          e.preventDefault();
          this.cycleTheme();
        }
      });
    }

    setTheme(theme: string) {
      this.currentTheme = theme;
      this.applyTheme(theme);
      this.saveTheme(theme);
      this.updateActiveOption();
    }

    previewTheme(theme: string) {
      this.applyTheme(theme);
    }

    applyTheme(theme: string) {
      document.documentElement.setAttribute('data-theme', theme);
    }

    cycleTheme() {
      const currentIndex = this.themes.indexOf(this.currentTheme);
      const nextIndex = (currentIndex + 1) % this.themes.length;
      this.setTheme(this.themes[nextIndex]);
    }

    updateActiveOption() {
      document.querySelectorAll('.theme-option').forEach((option) => {
        const htmlOption = option as HTMLElement;
        htmlOption.classList.toggle(
          'active',
          htmlOption.dataset.theme === this.currentTheme
        );
      });
    }

    saveTheme(theme: string) {
      localStorage.setItem('portfolio-theme', theme);
    }

    loadTheme(): string {
      let savedTheme = localStorage.getItem('portfolio-theme') || 'default';

      // Validate theme
      const validThemes = ['default', 'minimal'];
      if (!validThemes.includes(savedTheme)) {
        savedTheme = 'default';
        localStorage.setItem('portfolio-theme', 'default');
      }

      return savedTheme;
    }
  }

  // Initialize theme manager
  const themeManager = new ThemeManager();

  // Export globally
  (window as any).themeManager = themeManager;
  (window as any).openThemeModal = () => (window as any).openModal?.('themeModal');
</script>
