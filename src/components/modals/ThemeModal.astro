---
// Modern theme selection modal with View Transitions API
import Modal from '@components/primitives/Modal.astro';
import ThemeSelector from '@components/theme/ThemeSelector.astro';
---

<Modal id="themeModal" title="Choose Your Theme" size="lg">
  <ThemeSelector columns={3} />
</Modal>

<style>
  /* Minimal custom styles - ThemeSelector handles most styling */
</style>

<script>
  import { themes } from '@features/themes';

  // Theme Management with View Transitions API
  class ModernThemeManager {
    private themes: string[];
    private currentTheme: string;

    constructor() {
      this.themes = themes.map(t => t.name);
      this.currentTheme = this.loadTheme();
      this.init();
    }

    init() {
      this.applyTheme(this.currentTheme, false); // No transition on initial load
      this.setupEventListeners();
      this.updateActiveButton();
    }

    setupEventListeners() {
      // Theme button clicks
      document.querySelectorAll('.theme-option').forEach((button) => {
        const htmlButton = button as HTMLElement;
        htmlButton.addEventListener('click', async () => {
          const theme = htmlButton.dataset.theme;
          if (theme && theme !== this.currentTheme) {
            await this.setTheme(theme);
            (window as any).closeModal?.('themeModal');
          }
        });

        // Preview on hover (instant, no transition)
        htmlButton.addEventListener('mouseenter', () => {
          if (!htmlButton.classList.contains('active')) {
            const theme = htmlButton.dataset.theme;
            if (theme) {
              this.previewTheme(theme);
            }
          }
        });

        htmlButton.addEventListener('mouseleave', () => {
          if (!htmlButton.classList.contains('active')) {
            this.applyTheme(this.currentTheme, false);
          }
        });
      });

      // Enhanced keyboard shortcuts
      document.addEventListener('keydown', async (e) => {
        // Ctrl/Cmd+T to cycle forward
        if ((e.ctrlKey || e.metaKey) && e.key === 't' && !e.shiftKey) {
          e.preventDefault();
          await this.cycleTheme(1);
        }
        // Ctrl/Cmd+Shift+T to cycle backward
        if ((e.ctrlKey || e.metaKey) && e.key === 'T' && e.shiftKey) {
          e.preventDefault();
          await this.cycleTheme(-1);
        }
      });
    }

    async setTheme(theme: string) {
      this.currentTheme = theme;
      await this.applyTheme(theme, true);
      this.saveTheme(theme);
      this.updateActiveButton();
      this.showToast(theme);
    }

    previewTheme(theme: string) {
      this.applyTheme(theme, false);
    }

    async applyTheme(theme: string, withTransition: boolean = true) {
      // Check for View Transitions API support
      if (!withTransition || !document.startViewTransition) {
        document.documentElement.setAttribute('data-theme', theme);
        return;
      }

      // Modern smooth transition
      await document.startViewTransition(() => {
        document.documentElement.setAttribute('data-theme', theme);
      }).finished;
    }

    async cycleTheme(direction: number = 1) {
      const currentIndex = this.themes.indexOf(this.currentTheme);
      let nextIndex = currentIndex + direction;

      // Wrap around
      if (nextIndex < 0) nextIndex = this.themes.length - 1;
      if (nextIndex >= this.themes.length) nextIndex = 0;

      await this.setTheme(this.themes[nextIndex]);
    }

    updateActiveButton() {
      document.querySelectorAll('.theme-option').forEach((button) => {
        const htmlButton = button as HTMLElement;
        htmlButton.classList.toggle(
          'active',
          htmlButton.dataset.theme === this.currentTheme
        );
      });
    }

    showToast(themeName: string) {
      const theme = themes.find(t => t.name === themeName);
      if (!theme) return;

      const toast = document.createElement('div');
      toast.className = 'theme-toast';
      toast.textContent = `${theme.displayName} theme`;
      toast.setAttribute('role', 'status');
      toast.setAttribute('aria-live', 'polite');

      document.body.appendChild(toast);

      // Trigger animation
      requestAnimationFrame(() => {
        toast.classList.add('show');
      });

      // Remove after animation
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 2000);
    }

    saveTheme(theme: string) {
      localStorage.setItem('portfolio-theme', theme);
    }

    loadTheme(): string {
      let savedTheme = localStorage.getItem('portfolio-theme') || 'default';

      // Validate theme
      if (!this.themes.includes(savedTheme)) {
        savedTheme = 'default';
        localStorage.setItem('portfolio-theme', 'default');
      }

      return savedTheme;
    }
  }

  // Initialize theme manager
  const themeManager = new ModernThemeManager();

  // Export globally
  (window as any).themeManager = themeManager;
  (window as any).openThemeModal = () => (window as any).openModal?.('themeModal');
</script>

<style is:global>
  /* Toast notification styles */
  .theme-toast {
    position: fixed;
    bottom: var(--space-3xl);
    right: var(--space-3xl);
    background: var(--bg-dark);
    color: var(--text-light);
    padding: var(--space-md) var(--space-xl);
    border-radius: var(--radius-lg);
    border: var(--border-width) solid var(--accent-primary);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-transform: lowercase;
    z-index: 10000;
    opacity: 0;
    transform: translateY(var(--space-2xl));
    transition: opacity var(--duration-base) var(--ease-out),
                transform var(--duration-base) var(--ease-out);
    pointer-events: none;
  }

  .theme-toast.show {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .theme-toast {
      bottom: var(--space-lg);
      right: var(--space-lg);
      left: var(--space-lg);
      text-align: center;
    }
  }

  /* View Transitions API pseudo-elements for custom animations */
  @supports (view-transition-name: auto) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 300ms;
    }

    ::view-transition-old(root) {
      animation-name: fade-out;
    }

    ::view-transition-new(root) {
      animation-name: fade-in;
    }

    @keyframes fade-out {
      to {
        opacity: 0;
      }
    }

    @keyframes fade-in {
      from {
        opacity: 0;
      }
    }
  }
</style>
