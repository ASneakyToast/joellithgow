---
// Case study modal for project details - Astraeus CMS fetch
import Modal from '@components/primitives/Modal.astro';
import { fetchProjects } from '@lib/astraeus';

// Pre-fetch all case studies at build time (no MDX rendering needed)
const projects = await fetchProjects();
---

<Modal id="caseStudyModal" title="case study" size="lg" closeButton={true}>
  <div class="case-study-content">
    <!-- Pre-rendered project summaries stored in hidden divs -->
    {projects.map((project) => (
      <div
        class="case-study-rendered"
        data-project-id={project.slug}
        style="display: none;"
      >
        <div class="modal-project-summary">
          <h2 class="modal-project-title">{project.title}</h2>
          {project.subtitle && <p class="modal-project-subtitle">{project.subtitle}</p>}
          <p class="modal-project-description">{project.overview || project.description}</p>
          {project.hero_media && project.hero_media.type !== 'video' && (
            <img
              src={project.hero_media.src}
              alt={project.hero_media.alt}
              class="modal-project-image"
              loading="lazy"
            />
          )}
          <a href={`/work/${project.slug}`} class="modal-view-full">
            View full case study &rarr;
          </a>
        </div>
      </div>
    ))}
    <!-- Active content container -->
    <div class="case-study-active"></div>
  </div>
</Modal>

<style is:global>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  /* Case Study Content Styles */
  .case-study-content {
    container-type: inline-size;
    container-name: case-study;
  }

  /* Modal project summary */
  .modal-project-summary {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .modal-project-title {
    font-size: var(--heading-md);
    color: var(--text-primary);
    text-shadow: 2px 2px 0px var(--accent-primary);
    margin: 0;
  }

  .modal-project-subtitle {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
    margin: 0;
  }

  .modal-project-description {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
    margin: 0;
  }

  .modal-project-image {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    border: 2px solid var(--bg-dark);
    border-radius: var(--radius-md);
  }

  .modal-view-full {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--accent-primary);
    color: var(--text-light);
    padding: var(--space-md) var(--space-xl);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: var(--font-bold);
    transition: all var(--duration-base) var(--ease-out);
    align-self: flex-start;
  }

  .modal-view-full:hover {
    background: var(--accent-secondary);
    transform: translateY(-2px);
  }

  .case-hero {
    padding: var(--space-xl);
    background: var(--bg-primary);
    border-bottom: 2px solid var(--bg-dark);
  }

  .case-title {
    font-size: var(--heading-md);
    margin-bottom: var(--space-md);
    color: var(--text-primary);
    text-shadow: 2px 2px 0px var(--accent-primary);
  }

  .case-subtitle {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }

  .case-overview {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
    margin-bottom: var(--space-2xl);
  }

  .case-meta {
    display: grid;
    grid-template-columns: 1fr !important;
    gap: var(--space-md);
  }

  .meta-item {
    background: var(--bg-secondary);
    border: 2px solid var(--bg-dark);
    padding: var(--space-md);
    transform: rotate(1deg);
  }

  .meta-item:nth-child(even) {
    transform: rotate(-1deg);
    background: var(--accent-tertiary);
  }

  .meta-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-xs);
    color: var(--text-secondary);
  }

  .meta-value {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .case-section {
    padding: var(--space-xl);
    border-bottom: 2px solid var(--bg-primary);
  }

  .case-section:nth-child(even) {
    background: var(--bg-primary);
  }

  .case-section .section-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
    text-transform: lowercase;
    border-left: 4px solid var(--accent-primary);
    padding-left: var(--space-md);
  }

  .section-content {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
    margin-bottom: var(--space-lg);
  }

  .insight-box {
    background: var(--accent-secondary);
    color: var(--text-light);
    padding: var(--space-lg);
    margin: var(--space-lg) 0;
    border: 2px solid var(--bg-dark);
    transform: rotate(-1deg);
    position: relative;
  }

  .insight-box::before {
    content: '';
    position: absolute;
    top: -10px;
    left: -10px;
    background: var(--accent-tertiary);
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--bg-dark);
    font-size: var(--text-sm);
  }

  .metric-grid {
    display: grid;
    grid-template-columns: 1fr !important;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .metric-card {
    background: var(--bg-dark);
    color: var(--text-light);
    padding: var(--space-lg);
    text-align: center;
    border: 2px solid var(--bg-dark);
    transform: rotate(1deg);
  }

  .metric-card:nth-child(even) {
    transform: rotate(-2deg);
    background: var(--accent-primary);
  }

  .metric-number {
    font-size: var(--heading-md);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-xs);
  }

  .metric-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .process-step-detailed {
    background: var(--bg-secondary);
    border: 2px solid var(--bg-dark);
    padding: var(--space-xl);
    margin-bottom: var(--space-lg);
    transform: rotate(0.5deg);
  }

  .process-step-detailed:nth-child(even) {
    transform: rotate(-0.5deg);
  }

  .step-number-detailed {
    font-size: var(--heading-sm);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin-bottom: var(--space-sm);
  }

  .step-title-detailed {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-sm);
  }

  .step-description-detailed {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .case-image-gallery,
  .image-grid {
    margin: var(--space-lg) 0;
  }

  .hero-image {
    margin: var(--space-2xl) 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .hero-image .primary-image {
    border-radius: var(--radius-lg);
  }

  .case-image {
    width: 100%;
    height: auto;
    border: 2px solid var(--bg-dark);
    border-radius: var(--radius-md);
  }

  .primary-image {
    max-height: 500px;
    object-fit: cover;
  }

  .image-caption {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-top: var(--space-sm);
    text-align: center;
  }

  .image-grid {
    display: grid;
    grid-template-columns: 1fr !important;
    gap: var(--space-lg);
  }

  .quote-block {
    background: var(--bg-secondary);
    border-left: 4px solid var(--accent-primary);
    padding: var(--space-lg);
    margin: var(--space-lg) 0;
    font-style: italic;
    font-size: var(--text-lg);
  }

  .live-link-container,
  .live-links-container {
    margin: var(--space-lg) 0;
  }

  .live-link-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--accent-primary);
    color: var(--text-light);
    padding: var(--space-md) var(--space-xl);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: var(--font-bold);
    transition: all var(--duration-base) var(--ease-out);
  }

  .live-link-button:hover {
    background: var(--accent-secondary);
    transform: translateY(-2px);
  }

  .link-arrow {
    font-size: var(--text-xl);
  }

  .live-link-description,
  .live-links-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin: var(--space-md) 0;
  }

  .live-links-grid {
    display: grid;
    grid-template-columns: 1fr !important;
    gap: var(--space-md);
  }

  /* Container-based responsive design (responds to modal width, not viewport) */
  @container case-study (min-width: 600px) {
    .case-hero,
    .case-section {
      padding: var(--space-2xl);
    }

    .case-meta {
      grid-template-columns: repeat(2, 1fr);
    }

    .metric-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .image-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .live-links-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @container case-study (min-width: 800px) {
    .case-hero,
    .case-section {
      padding: var(--space-3xl);
    }

    .case-title {
      font-size: var(--heading-lg);
    }

    .case-meta {
      grid-template-columns: repeat(4, 1fr);
    }

    .metric-grid {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    }

    .image-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }

    .live-links-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .meta-item,
    .metric-card,
    .process-step-detailed,
    .insight-box {
      transform: none !important;
    }
  }
</style>

<script>
  // Case Study Modal Management - Astraeus CMS Version
  class CaseStudyModal {
    private modal: HTMLElement | null;
    private content: HTMLElement | null;
    private activeContainer: HTMLElement | null;

    constructor() {
      this.modal = document.getElementById('caseStudyModal');
      this.content = this.modal?.querySelector('.case-study-content') || null;
      this.activeContainer = this.modal?.querySelector('.case-study-active') || null;
    }

    open(projectId: string) {
      if (!this.modal || !this.content || !this.activeContainer) return;

      // Find pre-rendered content by project slug
      const renderedContent = this.content.querySelector(
        `.case-study-rendered[data-project-id="${projectId}"]`
      );

      if (renderedContent) {
        // Clone the content to the active container
        this.activeContainer.innerHTML = renderedContent.innerHTML;
      } else {
        console.warn(`No pre-rendered content found for project: ${projectId}`);
        this.activeContainer.innerHTML = '<p>Case study content not found.</p>';
      }

      // Open modal using global modal manager
      (window as any).openModal?.('caseStudyModal');
    }
  }

  // Initialize case study modal
  const caseStudyModal = new CaseStudyModal();

  // Export globally
  (window as any).caseStudyModal = caseStudyModal;
  (window as any).openCaseStudy = (projectId: string) => caseStudyModal.open(projectId);
</script>
