---
// About section component - Editorial style matching Projects section
// Interactive stat cards reveal contextual content in the left panel
import { getCollection } from 'astro:content';
import Badge from '@components/primitives/Badge.astro';

export interface Props {
  sectionTitle?: string;
  bio?: string;
  emailAddress?: string;
  linkedinUrl?: string;
  githubUrl?: string;
  showContact?: boolean;
  showSkills?: boolean;
}

const {
  sectionTitle = 'about me',
  bio = "I'm passionate about creating digital experiences that feel both innovative and human. My journey spans from visual design to full-stack development, giving me a unique perspective on how to bridge the gap between what's possible and what's meaningful.",
  emailAddress = "joelnotlithgow@gmail.com",
  linkedinUrl = "https://www.linkedin.com/in/joel-lithgow-40a9341b4/",
  githubUrl = "https://github.com/ASneakyToast",
  showContact = true,
  showSkills = true
} = Astro.props;

// Flattened skills list - all skills in one array
const allSkills = [
  'figma', 'sketch', 'adobe cc', 'prototyping', 'user research', 'design systems',
  'javascript', 'typescript', 'react', 'node.js', 'python', 'docker',
  'claude code', 'mcp servers', 'webgl', 'anime.js', 'p5.js'
];

// Get employment history from content collection
const allExperience = await getCollection('experience');

// Helper to format date range
function formatDateRange(startDate: string, endDate?: string): string {
  return endDate ? `${startDate} – ${endDate}` : `${startDate} – Present`;
}

// Filter featured jobs and format for display
const employment = allExperience
  .filter(exp => exp.data.featured || exp.data.type === 'full-time')
  .sort((a, b) => {
    // Sort by start year descending (most recent first)
    const aYear = parseInt(a.data.startDate.split('-')[0]);
    const bYear = parseInt(b.data.startDate.split('-')[0]);
    return bYear - aYear;
  })
  .slice(0, 3) // Show top 3 most recent
  .map(exp => ({
    title: exp.data.title,
    company: exp.data.company,
    duration: formatDateRange(exp.data.startDate, exp.data.endDate)
  }));

// Published projects for the projects panel
const publishedProjects = [
  { title: 'CCA Homepage Redesign', url: '/work/homepage-redesign' },
  { title: 'Multimedia Digital Storytelling', url: '/work/editorial-process' },
  { title: 'After Intelligence Event Series', url: '/work/after-intelligence' },
  { title: 'Cloud Infrastructure Migration', url: '/work/infrastructure-migration' }
];

// Stats configuration with IDs for interactivity
const stats = [
  {
    id: 'experience',
    value: '7+',
    label: 'years experience'
  },
  {
    id: 'projects',
    value: '50+',
    label: 'projects completed'
  },
  {
    id: 'degree',
    value: '1',
    label: 'Art Degree'
  },
  {
    id: 'ideas',
    value: '∞',
    label: 'ideas per day'
  }
];

// Contact links configuration
const contactLinks = [
  {
    label: 'email',
    href: `mailto:${emailAddress}`,
    external: false
  },
  {
    label: 'linkedin',
    href: linkedinUrl,
    external: true
  },
  {
    label: 'github',
    href: githubUrl,
    external: true
  }
];
---

<section id="about" class="about" aria-labelledby="about-heading">
  <div class="about-content">
    <header class="section-header">
      <h2 id="about-heading" class="section-title">{sectionTitle}</h2>
    </header>

    <div class="about-intro">
      <div class="about-text-card" data-stat-panel>
        <!-- Default bio panel -->
        <div class="panel-content" data-panel="default" aria-hidden="false">
          <p class="about-text">{bio}</p>
        </div>

        <!-- Experience panel -->
        <div class="panel-content" data-panel="experience" aria-hidden="true">
          <button class="panel-close" aria-label="Return to bio" data-close-panel>&times;</button>
          <h3 class="panel-title">Professional Experience</h3>
          <ul class="resume-list">
            {employment.map((job) => (
              <li class="resume-item">
                <div class="resume-title">{job.title}</div>
                <div class="resume-company">{job.company}</div>
                <div class="resume-duration">{job.duration}</div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Projects panel -->
        <div class="panel-content" data-panel="projects" aria-hidden="true">
          <button class="panel-close" aria-label="Return to bio" data-close-panel>&times;</button>
          <h3 class="panel-title">Published Work</h3>
          <ul class="project-list">
            {publishedProjects.map((project) => (
              <li>
                <a href={project.url} class="project-link">{project.title}</a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Degree panel -->
        <div class="panel-content" data-panel="degree" aria-hidden="true">
          <button class="panel-close" aria-label="Return to bio" data-close-panel>&times;</button>
          <h3 class="panel-title">Education</h3>
          <img
            src="/assets/images/cca-campus.jpg"
            alt="California College of the Arts campus"
            class="campus-image"
            loading="lazy"
          />
          <p class="degree-info">BFA, Interdisciplinary Studies</p>
          <a
            href="https://cca.edu"
            target="_blank"
            rel="noopener noreferrer"
            class="cca-link"
          >
            California College of the Arts
          </a>
        </div>

        <!-- Ideas panel -->
        <div class="panel-content" data-panel="ideas" aria-hidden="true">
          <button class="panel-close" aria-label="Return to bio" data-close-panel>&times;</button>
          <h3 class="panel-title">Creative Playground</h3>
          <p class="ideas-text">Sometimes the best ideas come from play.</p>
          <a href="/snake" class="idea-cta">Play Snake</a>
        </div>
      </div>

      <div class="about-stats" role="group" aria-label="Professional statistics">
        {stats.map((stat) => (
          <button
            class="stat-item"
            data-stat-id={stat.id}
            aria-pressed="false"
            aria-controls="stat-panel"
            type="button"
          >
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </button>
        ))}
      </div>
    </div>

    {showSkills && (
      <div class="skills-container" role="group" aria-label="Technical skills">
        <div class="skills-list" role="list">
          {allSkills.map((skill) => (
            <Badge
              variant="secondary"
              size="sm"
              role="listitem"
              href={`/work/skills/${skill}`}
            >
              #{skill}
            </Badge>
          ))}
        </div>
      </div>
    )}

    {showContact && (
      <nav class="contact-links" aria-label="Contact links">
        {contactLinks.map((link, index) => (
          <>
            <a
              href={link.href}
              class="contact-link"
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >
              {link.label}
            </a>
            {index < contactLinks.length - 1 && <span class="contact-separator">/</span>}
          </>
        ))}
      </nav>
    )}
  </div>
</section>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  .about {
    padding: var(--space-5xl) var(--page-gutter);
    background: transparent;
    border-top: 5px solid var(--accent-primary);
    position: relative;
  }

  .about-content {
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  /* Section Header */
  .section-header {
    margin-bottom: var(--space-4xl);
    text-align: center;
  }

  .section-title {
    font-family: var(--font-family);
    font-size: var(--heading-xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-primary);
    text-decoration-thickness: 4px;
    transform: skew(-2deg);
  }

  /* About Intro Grid */
  .about-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    margin-bottom: var(--space-4xl);
    align-items: start;
  }

  /* Bio Text Card - Panel Container */
  .about-text-card {
    background: var(--bg-secondary);
    padding: 0;
    border: var(--border-width-thick) solid var(--bg-dark);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
    position: relative;
    overflow: hidden;
    min-height: 200px;
    transition: height var(--duration-slow) var(--ease-out);
  }

  /* Panel Content System */
  .panel-content {
    padding: var(--space-2xl);
    opacity: 1;
    transform: translateX(0);
    transition:
      transform var(--duration-slow) var(--ease-out),
      opacity var(--duration-slow) var(--ease-out);
  }

  .panel-content[aria-hidden="true"] {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-100%);
  }

  .panel-content.entering {
    transform: translateX(100%);
  }

  /* Close button */
  .panel-close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    background: var(--bg-dark);
    color: var(--text-primary);
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    font-size: var(--text-xl);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-fast) var(--ease-out);
    z-index: 10;
  }

  .panel-close:hover {
    background: var(--accent-primary);
    color: var(--bg-light);
    transform: scale(1.1);
  }

  /* Panel Title */
  .panel-title {
    font-family: var(--font-family);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-lg) 0;
  }

  /* Resume List (Experience Panel) */
  .resume-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .resume-item {
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--bg-dark);
  }

  .resume-item:last-child {
    border-bottom: none;
  }

  .resume-title {
    font-family: var(--font-family);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    font-size: var(--text-base);
  }

  .resume-company {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    margin-top: var(--space-xs);
  }

  .resume-duration {
    color: var(--accent-primary);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-top: var(--space-xs);
  }

  /* Project List (Projects Panel) */
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-link {
    display: block;
    padding: var(--space-sm) 0;
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-secondary);
    text-underline-offset: 3px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .project-link:hover {
    color: var(--accent-primary);
    text-decoration-color: var(--accent-primary);
  }

  /* Degree Panel */
  .campus-image {
    width: 100%;
    height: auto;
    border: var(--border-width) solid var(--bg-dark);
    margin-bottom: var(--space-md);
  }

  .degree-info {
    font-family: var(--font-family);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-sm) 0;
  }

  .cca-link {
    color: var(--accent-primary);
    font-weight: var(--font-bold);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .cca-link:hover {
    text-decoration: underline;
  }

  /* Ideas Panel */
  .ideas-text {
    font-family: var(--font-family);
    color: var(--text-secondary);
    font-size: var(--text-base);
    margin: 0 0 var(--space-lg) 0;
  }

  .idea-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-xl);
    background: var(--accent-primary);
    color: var(--bg-light);
    text-decoration: none;
    font-weight: var(--font-bold);
    border: var(--border-width-thick) solid var(--bg-dark);
    box-shadow: var(--shadow-md) var(--accent-secondary);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .idea-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-lg) var(--accent-secondary);
  }

  .about-text {
    font-family: var(--font-family);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-primary);
    margin: 0;
  }

  /* Stats Grid */
  .about-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  /* Stat Item Card (Button) */
  .stat-item {
    background: var(--bg-secondary);
    padding: var(--space-xl);
    border: var(--border-width-thick) solid var(--bg-dark);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
    transition:
      transform var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
    cursor: pointer;
    text-align: left;
    font-family: inherit;
  }

  .stat-item:hover {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-2xl) var(--accent-secondary);
  }

  .stat-item[aria-pressed="true"] {
    background: var(--accent-primary);
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-2xl) var(--accent-secondary);
  }

  .stat-item[aria-pressed="true"] .stat-value,
  .stat-item[aria-pressed="true"] .stat-label {
    color: var(--bg-light);
  }

  /* Stat Value */
  .stat-value {
    font-family: var(--font-family);
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: var(--space-sm);
  }

  /* Stat Label */
  .stat-label {
    font-family: var(--font-family);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-secondary);
  }

  /* Skills Section */
  .skills-container {
    padding-top: var(--space-4xl);
    border-top: 2px solid var(--bg-dark);
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
  }

  /* Contact Links */
  .contact-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    padding-top: var(--space-4xl);
    margin-top: var(--space-4xl);
    border-top: 2px solid var(--bg-dark);
  }

  .contact-link {
    font-family: var(--font-family);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out);
  }

  .contact-link:hover {
    color: var(--accent-primary);
  }

  .contact-separator {
    color: var(--text-secondary);
    font-weight: var(--font-normal);
  }

  /* Responsive - Tablet */
  @media (max-width: 1024px) {
    .about-intro {
      gap: var(--space-3xl);
    }
  }

  /* Responsive - Mobile */
  @media (max-width: 768px) {
    .about {
      padding: var(--space-4xl) var(--page-gutter);
    }

    .section-header {
      margin-bottom: var(--space-3xl);
    }

    .section-title {
      font-size: var(--heading-lg);
    }

    .about-intro {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
      margin-bottom: var(--space-3xl);
    }

    .about-text-card {
      min-height: 180px;
    }

    .panel-content {
      padding: var(--space-xl);
    }

    .panel-content[aria-hidden="true"] {
      transform: translateY(-20px);
    }

    .panel-content.entering {
      transform: translateY(20px);
    }

    .about-text {
      font-size: var(--text-base);
    }

    .about-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }

    .stat-item {
      padding: var(--space-lg);
    }

    .stat-value {
      font-size: var(--heading-md);
    }

    .skills-container {
      padding-top: var(--space-3xl);
    }

    .skills-list {
      justify-content: flex-start;
    }

    .contact-links {
      padding-top: var(--space-3xl);
      margin-top: var(--space-3xl);
    }

    .contact-link {
      font-size: var(--text-base);
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .about-text-card,
    .stat-item,
    .panel-content,
    .panel-close,
    .idea-cta {
      transition: none;
    }

    .stat-item:hover,
    .stat-item[aria-pressed="true"] {
      transform: none;
    }

    .panel-content[aria-hidden="true"] {
      transform: none;
    }

    .panel-content.entering {
      transform: none;
    }
  }

  /* High Contrast Mode */
  @media (prefers-contrast: high) {
    .about-text-card,
    .stat-item {
      border-width: 4px;
    }
  }
</style>

<script>
  class StatPanelManager {
    private container: HTMLElement | null;
    private statButtons: NodeListOf<HTMLElement>;
    private panels: NodeListOf<HTMLElement>;
    private activePanel: string = 'default';

    constructor() {
      this.container = document.querySelector('[data-stat-panel]');
      this.statButtons = document.querySelectorAll('.stat-item[data-stat-id]');
      this.panels = document.querySelectorAll('.panel-content[data-panel]');

      if (this.container) {
        this.init();
      }
    }

    init() {
      // Set initial height based on default panel
      const defaultPanel = document.querySelector('[data-panel="default"]') as HTMLElement;
      if (defaultPanel && this.container) {
        this.container.style.height = `${defaultPanel.offsetHeight}px`;
      }

      // Stat button click handlers
      this.statButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const statId = btn.dataset.statId;
          if (statId) {
            this.togglePanel(statId);
          }
        });
      });

      // Close button handlers
      document.querySelectorAll('[data-close-panel]').forEach(btn => {
        btn.addEventListener('click', () => this.showDefault());
      });

      // ESC key to close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.activePanel !== 'default') {
          this.showDefault();
        }
      });
    }

    togglePanel(statId: string) {
      if (this.activePanel === statId) {
        // Clicking same card returns to default
        this.showDefault();
      } else {
        this.showPanel(statId);
      }
    }

    showPanel(panelId: string) {
      const targetPanel = document.querySelector(`[data-panel="${panelId}"]`) as HTMLElement;
      const currentPanel = document.querySelector(`[data-panel="${this.activePanel}"]`) as HTMLElement;

      if (!targetPanel || !currentPanel || !this.container) return;

      // Measure target panel height for smooth transition
      // Temporarily make it visible to measure
      targetPanel.style.position = 'absolute';
      targetPanel.style.visibility = 'hidden';
      targetPanel.style.display = 'block';
      targetPanel.setAttribute('aria-hidden', 'false');
      const targetHeight = targetPanel.offsetHeight;
      targetPanel.style.position = '';
      targetPanel.style.visibility = '';
      targetPanel.style.display = '';
      targetPanel.setAttribute('aria-hidden', 'true');

      // Set container height for smooth transition
      this.container.style.height = `${targetHeight}px`;

      // Update stat button states
      this.statButtons.forEach(btn => {
        btn.setAttribute('aria-pressed', btn.dataset.statId === panelId ? 'true' : 'false');
      });

      // Animate out current panel
      currentPanel.setAttribute('aria-hidden', 'true');

      // Prepare and animate in new panel
      targetPanel.classList.add('entering');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          targetPanel.classList.remove('entering');
          targetPanel.setAttribute('aria-hidden', 'false');
        });
      });

      this.activePanel = panelId;

      // Focus management for accessibility
      const closeBtn = targetPanel.querySelector<HTMLElement>('[data-close-panel]');
      if (closeBtn && panelId !== 'default') {
        setTimeout(() => closeBtn.focus(), 350);
      }
    }

    showDefault() {
      this.showPanel('default');

      // Clear all button pressed states
      this.statButtons.forEach(btn => {
        btn.setAttribute('aria-pressed', 'false');
      });
    }
  }

  // Initialize on DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    new StatPanelManager();
  });
</script>
