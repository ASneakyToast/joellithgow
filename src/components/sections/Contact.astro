---
// Contact section component - Editorial style matching Projects section
export interface Props {
  title?: string;
  description?: string;
  emailAddress?: string;
  linkedinUrl?: string;
  githubUrl?: string;
}

const {
  title = "let's create",
  description = "Ready to bring your ideas to life? I'm always excited to collaborate on projects that push the boundaries of what's possible with design and technology.",
  emailAddress = "joelnotlithgow@gmail.com",
  linkedinUrl = "https://www.linkedin.com/in/joel-lithgow-40a9341b4/",
  githubUrl = "https://github.com/ASneakyToast"
} = Astro.props;

// Contact methods configuration
const contactMethods = [
  {
    id: 'email',
    number: '01',
    label: 'email',
    text: 'send an email',
    href: `mailto:${emailAddress}`,
    description: 'Send me an email to discuss your project',
    external: false
  },
  {
    id: 'linkedin',
    number: '02',
    label: 'linkedin',
    text: 'connect with me',
    href: linkedinUrl,
    description: 'Connect with me on LinkedIn',
    external: true
  },
  {
    id: 'github',
    number: '03',
    label: 'github',
    text: 'see my code',
    href: githubUrl,
    description: 'View my code repositories on GitHub',
    external: true
  }
];

---

<section id="contact" class="contact" aria-labelledby="contact-heading">
  <div class="contact-content">
    <header class="section-header">
      <h2 id="contact-heading" class="section-title">{title}</h2>
      <p class="section-subtitle">{description}</p>
    </header>

    <div class="contact-methods" role="group" aria-label="Contact methods">
      {contactMethods.map((method) => (
        <a
          href={method.href}
          class="contact-method"
          aria-describedby={`${method.id}-description`}
          target={method.external ? "_blank" : undefined}
          rel={method.external ? "noopener noreferrer" : undefined}
        >
          <div class="contact-meta">
            <span class="contact-number">{method.number}</span>
            <span class="contact-divider">-----</span>
            <span class="contact-label">{method.label}</span>
          </div>
          <div class="contact-text">{method.text}</div>
          <span class="contact-arrow" aria-hidden="true">-></span>
        </a>
      ))}
    </div>

    <!-- Hidden descriptions for screen readers -->
    <div class="sr-only">
      {contactMethods.map((method) => (
        <div id={`${method.id}-description`}>{method.description}</div>
      ))}
    </div>
  </div>
</section>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  .contact {
    padding: var(--space-5xl) var(--page-gutter);
    background: transparent;
    border-top: 5px solid var(--accent-primary);
    position: relative;
  }

  .contact-content {
    max-width: var(--content-wide);
    margin: 0 auto;
    text-align: center;
  }

  /* Section Header */
  .section-header {
    margin-bottom: var(--space-4xl);
  }

  .section-title {
    font-family: var(--font-family);
    font-size: var(--heading-xl);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-primary);
    text-decoration-thickness: 4px;
    transform: skew(-2deg);
  }

  .section-subtitle {
    font-family: var(--font-family);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-wide);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Contact Methods Grid */
  .contact-methods {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xl);
  }

  /* Contact Method Card */
  .contact-method {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    background: var(--bg-secondary);
    padding: var(--space-2xl);
    text-decoration: none;
    color: var(--text-primary);
    border: var(--border-width-thick) solid var(--bg-dark);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
    transition: transform var(--duration-slow) var(--ease-out),
                box-shadow var(--duration-slow) var(--ease-out);
  }

  .contact-method:hover {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-2xl) var(--accent-secondary);
  }

  /* Metadata Row */
  .contact-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    font-family: var(--font-family);
  }

  .contact-number {
    font-size: var(--heading-md);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
  }

  .contact-divider {
    color: var(--accent-primary);
  }

  .contact-label {
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Contact Text */
  .contact-text {
    font-family: var(--font-family);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    color: var(--text-primary);
    margin-bottom: var(--space-lg);
  }

  /* Arrow */
  .contact-arrow {
    font-family: var(--font-family);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
    margin-top: auto;
  }

  /* Focus States */
  .contact-method:focus-visible {
    outline: var(--border-width-thick) solid var(--accent-primary);
    outline-offset: var(--space-xs);
  }

  .contact-method:focus-visible {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-2xl) var(--accent-secondary);
  }

  /* Responsive - Tablet */
  @media (max-width: 1024px) {
    .contact-methods {
      grid-template-columns: repeat(2, 1fr);
    }

    .contact-method:last-child {
      grid-column: span 2;
      max-width: 50%;
      justify-self: center;
    }
  }

  /* Responsive - Mobile */
  @media (max-width: 768px) {
    .contact {
      padding: var(--space-4xl) var(--page-gutter);
    }

    .section-header {
      margin-bottom: var(--space-3xl);
    }

    .section-title {
      font-size: var(--heading-lg);
    }

    .contact-methods {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .contact-method:last-child {
      grid-column: span 1;
      max-width: 100%;
    }

    .contact-method {
      padding: var(--space-xl);
    }

    .contact-text {
      font-size: var(--text-lg);
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .contact-method {
      transition: none;
    }

    .contact-method:hover {
      transform: none;
    }
  }

  /* High Contrast Mode */
  @media (prefers-contrast: high) {
    .contact-method {
      border-width: 4px;
    }
  }
</style>
