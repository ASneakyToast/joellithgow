---
// Additional Work section - showcases non-featured projects in a lighter format
import { getCollection } from 'astro:content';
import Badge from '@components/primitives/Badge.astro';
import Button from '@components/primitives/Button.astro';
import Card from '@components/primitives/Card.astro';

export interface Props {
  sectionTitle?: string;
  sectionSubtitle?: string;
}

const {
  sectionTitle = 'also built',
  sectionSubtitle = 'technical projects and infrastructure work'
} = Astro.props;

// Get non-featured projects from content collection (exclude drafts)
const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects
  .filter(project => !project.data.featured)
  .sort((a, b) => a.data.number - b.data.number);
---

{projects.length > 0 && (
  <section id="additional-work" class="additional-work-wrapper">
    <div class="container">
      <!-- Section Header -->
      <header class="section-header">
        <h2 class="section-title">{sectionTitle}</h2>
        <p class="section-subtitle">{sectionSubtitle}</p>
      </header>

      <!-- Projects Grid -->
      <div class="projects-grid">
        {projects.map((project) => (
          <Card variant="interactive" padding="xl" href={`/work/${project.data.id}`}>
            <div class="project-header">
              <span class="project-number">{String(project.data.number).padStart(2, '0')}</span>
              <span class="project-type">{project.data.type}</span>
            </div>

            <h3 class="project-title">{project.data.title}</h3>
            <p class="project-description">{project.data.description}</p>

            {/* Impact metric if available */}
            {project.data.impact && (
              <div class="project-impact">
                <span class="impact-label">impact:</span>
                <span class="impact-value">{project.data.impact}</span>
              </div>
            )}
          </Card>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  /* Section Wrapper */
  .additional-work-wrapper {
    background: var(--bg-secondary);
    padding: var(--space-5xl) var(--space-xl);
    border-top: 5px solid var(--accent-primary);
    position: relative;
  }

  .container {
    max-width: var(--content-wide);
    margin: 0 auto;
  }

  /* Section Header */
  .section-header {
    text-align: center;
    margin-bottom: var(--space-4xl);
    position: relative;
    z-index: 10;
  }

  .section-title {
    font-size: var(--heading-xl);
    color: var(--text-primary);
    margin-bottom: var(--space-lg);
    text-decoration: underline;
    text-decoration-color: var(--accent-primary);
    text-decoration-thickness: 4px;
    transform: skew(-2deg);
  }

  .section-subtitle {
    font-size: var(--text-base);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-wider);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Project Content - styled to work within Card component */
  .project-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .project-number {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
  }

  .project-type {
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  /* Project Content */
  .project-title {
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--text-primary);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-md) 0;
  }

  .project-description {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
  }

  /* Impact */
  .project-impact {
    display: flex;
    gap: var(--space-xs);
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--border-secondary);
    border-bottom: 1px solid var(--border-secondary);
    margin-bottom: var(--space-md);
  }

  .impact-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--text-tertiary);
    font-weight: var(--font-bold);
  }

  .impact-value {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  /* Technologies */
  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  /* Actions */
  .project-actions {
    margin-top: auto;
  }

  /* Responsive adjustments */
  @media (max-width: 767px) {
    .additional-work-wrapper {
      padding: var(--space-4xl) var(--space-lg);
    }

    .section-title {
      font-size: var(--heading-md);
    }

    .projects-grid {
      gap: var(--space-xl);
    }
  }
</style>
