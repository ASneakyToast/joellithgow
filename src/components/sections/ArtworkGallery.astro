---
import type { Artwork } from '@content/config';

interface Props {
  artworks: Artwork[];
}

const { artworks } = Astro.props;

// Collect all images from all artworks
const allImages = artworks.flatMap(artwork => {
  if (!artwork.images || artwork.images.length === 0) return [];

  return artwork.images.map(image => ({
    ...image,
    artworkTitle: artwork.title,
    artworkId: artwork.id,
  }));
});

// If no images available, don't render the gallery
if (allImages.length === 0) {
  console.log('⚠️ No images available for gallery - component will not render');
}

// Split images into two rows for visual variety
const midpoint = Math.ceil(allImages.length / 2);
const topRowImages = allImages.slice(0, midpoint);
const bottomRowImages = allImages.slice(midpoint);
---

{allImages.length > 0 && (
  <section class="artwork-gallery animate-on-scroll">
    <div class="gallery-container">
      <h2 class="gallery-title">Gallery Overview</h2>
      <p class="gallery-description">
        A visual journey through all artworks in the collection
      </p>

      <div class="gallery-wrapper">
        <!-- Top Row - Taller Images -->
        <div class="gallery-row gallery-row-top">
          {topRowImages.map((image) => (
            <a href={`/artworks/${image.artworkId}`} class="gallery-item gallery-item-tall">
              <img
                src={image.srcThumbnail || image.src}
                alt={image.alt}
                width={image.width || 300}
                height={image.height || 350}
                loading="lazy"
                class="gallery-image"
              />
              <div class="image-overlay">
                <span class="artwork-title">{image.artworkTitle}</span>
                <span class="image-caption">{image.caption}</span>
              </div>
            </a>
          ))}
        </div>

        <!-- Bottom Row - Shorter Images -->
        <div class="gallery-row gallery-row-bottom">
          {bottomRowImages.map((image) => (
            <a href={`/artworks/${image.artworkId}`} class="gallery-item gallery-item-short">
              <img
                src={image.srcThumbnail || image.src}
                alt={image.alt}
                width={image.width || 280}
                height={image.height || 220}
                loading="lazy"
                class="gallery-image"
              />
              <div class="image-overlay">
                <span class="artwork-title">{image.artworkTitle}</span>
                <span class="image-caption">{image.caption}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  .artwork-gallery {
    padding: var(--space-4xl) 0;
    background: var(--bg-secondary);
    margin: var(--space-2xl) 0;
    border-top: var(--border-width) solid var(--gradient-primary-subtle);
    border-bottom: var(--border-width) solid var(--gradient-primary-subtle);
  }

  .gallery-container {
    max-width: var(--content-full);
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  .gallery-title {
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-md) 0;
    text-align: center;
    color: var(--text-primary);
    letter-spacing: var(--tracking-tight);
  }

  .gallery-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    text-align: center;
    margin: 0 auto var(--space-2xl) auto;
    max-width: var(--content-narrow);
    font-style: italic;
  }

  .gallery-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .gallery-row {
    display: flex;
    gap: var(--space-xl);
    overflow-x: auto;
    padding: var(--space-md) 0;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-primary) var(--bg-primary);
  }

  .gallery-row::-webkit-scrollbar {
    height: 8px;
  }

  .gallery-row::-webkit-scrollbar-track {
    background: var(--bg-primary);
    border-radius: var(--radius-full);
  }

  .gallery-row::-webkit-scrollbar-thumb {
    background: var(--accent-primary);
    border-radius: var(--radius-full);
  }

  .gallery-row::-webkit-scrollbar-thumb:hover {
    background: var(--accent-secondary);
  }

  .gallery-item {
    position: relative;
    flex-shrink: 0;
    border: var(--border-width) solid var(--gradient-primary-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md) var(--accent-secondary);
    transition: all var(--duration-base) var(--ease-out);
    cursor: pointer;
    text-decoration: none;
  }

  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg) var(--accent-primary);
    border-color: var(--accent-primary);
  }

  .gallery-item-tall {
    width: 300px;
    height: 350px;
  }

  .gallery-item-short {
    width: 280px;
    height: 220px;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .gallery-item:hover .gallery-image {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, var(--bg-dark));
    color: var(--text-light);
    padding: var(--space-xl) var(--space-lg) var(--space-lg);
    transform: translateY(100%);
    transition: transform var(--duration-base) var(--ease-out);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .gallery-item:hover .image-overlay {
    transform: translateY(0);
  }

  .artwork-title {
    font-weight: var(--font-bold);
    font-size: var(--text-base);
    color: var(--text-light);
  }

  .image-caption {
    font-size: var(--text-sm);
    color: var(--text-light);
    opacity: 0.9;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .artwork-gallery {
      padding: var(--space-3xl) 0;
    }

    .gallery-title {
      font-size: var(--heading-md);
    }

    .gallery-description {
      font-size: var(--text-base);
    }

    .gallery-wrapper {
      gap: var(--space-lg);
    }

    .gallery-row {
      gap: var(--space-lg);
    }

    .gallery-item-tall {
      width: 250px;
      height: 300px;
    }

    .gallery-item-short {
      width: 230px;
      height: 180px;
    }

    /* Show overlay by default on mobile for discoverability */
    .image-overlay {
      transform: translateY(0);
      background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    }
  }

  @media (max-width: 480px) {
    .artwork-gallery {
      padding: var(--space-2xl) 0;
    }

    .gallery-item-tall {
      width: 200px;
      height: 250px;
    }

    .gallery-item-short {
      width: 180px;
      height: 150px;
    }

    .gallery-row {
      gap: var(--space-md);
    }
  }
</style>
