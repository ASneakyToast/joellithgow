---
// Projects section component - Clean layout with brutalist styling
import { getCollection } from 'astro:content';

export interface Props {
  sectionTitle?: string;
  sectionSubtitle?: string;
  featuredOnly?: boolean;
  limit?: number;
  showHeader?: boolean;
}

const {
  sectionTitle = 'selected work',
  sectionSubtitle = 'solving complex problems through research-driven design',
  featuredOnly = true,
  limit,
  showHeader = true
} = Astro.props;

// Get projects from content collection (exclude drafts)
const allProjects = await getCollection('projects', ({ data }) => !data.draft);
let projects = featuredOnly ? allProjects.filter(project => project.data.featured) : allProjects;

// Sort by number (ascending)
projects = projects.sort((a, b) => a.data.number - b.data.number);

// Apply limit if specified
if (limit && limit > 0) {
  projects = projects.slice(0, limit);
}
---

<section id="work" class="projects-section" aria-labelledby={showHeader ? "projects-heading" : undefined}>
  {/* Section Header */}
  {showHeader && (
    <header class="section-header">
      <h2 id="projects-heading" class="section-title">{sectionTitle}</h2>
      <p class="section-subtitle">{sectionSubtitle}</p>
    </header>
  )}

  {/* Projects Grid */}
  <div class="projects-grid">
    {projects.map((project, index) => {
      const hasImage = project.data.images && project.data.images.length > 0;
      const heroImage = hasImage ? project.data.images[0] : null;
      const isEven = index % 2 === 1;

      return (
        <article class={`project-card ${isEven ? 'project-card--reversed' : ''}`}>
          {/* Image - clickable link */}
          {heroImage && (
            <a href={`/work/${project.data.id}`} class="project-image-link">
              <figure class="project-image">
                {heroImage.type === 'video' ? (
                  <video autoplay muted loop playsinline>
                    <source src={heroImage.src} type="video/webm" />
                  </video>
                ) : (
                  <img
                    src={heroImage.src}
                    alt={heroImage.alt}
                    loading={index === 0 ? "eager" : "lazy"}
                  />
                )}
              </figure>
            </a>
          )}

          {/* Content */}
          <div class="project-content">
            <div class="project-meta">
              <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="project-divider">─────</span>
              <span class="project-type">{project.data.type}</span>
            </div>
            <h3 class="project-title">{project.data.title}</h3>
            <p class="project-excerpt">{project.data.description}</p>
            <div class="project-actions">
              <a href={`/work/${project.data.id}`} class="project-cta">view case study →</a>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  {projects.length === 0 && (
    <div class="no-projects">
      <p>No projects found.</p>
    </div>
  )}
</section>

<style>
  @import '../../styles/tokens.css';
  @import '../../styles/themes.css';

  /* Section Container */
  .projects-section {
    background: transparent;
    padding: var(--space-5xl) var(--page-gutter);
    border-top: 5px solid var(--accent-primary);
  }

  /* Section Header */
  .section-header {
    max-width: var(--content-wide);
    margin: 0 auto var(--space-5xl);
    text-align: center;
  }

  .section-title {
    font-family: var(--font-family);
    font-size: var(--heading-xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-lg);
    text-decoration: underline;
    text-decoration-color: var(--accent-primary);
    text-decoration-thickness: 4px;
    transform: skew(-2deg);
  }

  .section-subtitle {
    font-family: var(--font-family);
    font-size: var(--text-base);
    color: var(--text-secondary);
    letter-spacing: var(--tracking-wide);
    margin: 0;
  }

  /* Projects Grid */
  .projects-grid {
    max-width: var(--content-full);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-5xl);
  }

  /* Project Card */
  .project-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  /* Project Image Link */
  .project-image-link {
    display: block;
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .project-card {
      grid-template-columns: 1.5fr 1fr;
      gap: var(--space-4xl);
    }

    .project-card.project-card--reversed {
      grid-template-columns: 1fr 1.5fr;
    }

    .project-card.project-card--reversed .project-image-link {
      order: 2;
    }

    .project-card.project-card--reversed .project-content {
      order: 1;
      text-align: right;
    }

    .project-card.project-card--reversed .project-meta {
      justify-content: flex-end;
    }

    .project-card.project-card--reversed .project-actions {
      justify-content: flex-end;
    }
  }

  /* Project Image */
  .project-image {
    margin: 0;
    overflow: hidden;
    border: var(--border-width-thick) solid var(--bg-dark);
    box-shadow: var(--shadow-xl) var(--accent-secondary);
    transition: transform var(--duration-slow) var(--ease-out),
                box-shadow var(--duration-slow) var(--ease-out);
  }

  .project-image-link:hover .project-image {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-2xl) var(--accent-secondary);
  }

  .project-image img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .project-image video {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: auto;
    object-fit: contain;
  }

  /* Project Content */
  .project-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-family: var(--font-family);
  }

  .project-number {
    font-size: var(--heading-md);
    font-weight: var(--font-bold);
    color: var(--accent-primary);
  }

  .project-divider {
    color: var(--accent-primary);
  }

  .project-type {
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .project-title {
    font-family: var(--font-family);
    font-size: var(--heading-lg);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    color: var(--text-primary);
    margin: 0;
  }

  .project-excerpt {
    font-family: var(--font-family);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin: 0;
  }

  .project-actions {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  /* No Projects */
  .no-projects {
    text-align: center;
    padding: var(--space-5xl) var(--space-lg);
    color: var(--text-secondary);
    font-size: var(--text-lg);
  }

  /* Responsive */
  @media (max-width: 767px) {
    .section-title {
      font-size: var(--heading-lg);
    }

    .project-title {
      font-size: var(--heading-md);
    }

    .projects-grid {
      gap: var(--space-4xl);
    }
  }

  /* CTA styling */
  .project-cta {
    display: inline-block;
    font-family: var(--font-family);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--text-light);
    text-decoration: none;
    padding: var(--button-padding-y) var(--button-padding-x);
    background: var(--accent-primary);
    border: var(--border-width-thick) solid var(--bg-dark);
    box-shadow: var(--shadow-md) var(--bg-dark);
    transition: transform var(--duration-slow) var(--ease-out),
                box-shadow var(--duration-slow) var(--ease-out);
  }

  .project-cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-lg) var(--bg-dark);
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .project-image,
    .project-cta {
      transition: none;
    }

    .project-image-link:hover .project-image,
    .project-cta:hover {
      transform: none;
    }
  }

  /* Focus States */
  .project-image-link:focus {
    outline: var(--border-width-thick) solid var(--accent-primary);
    outline-offset: var(--space-xs);
  }

  .project-image-link:focus .project-image {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-2xl) var(--accent-secondary);
  }

  .project-cta:focus {
    outline: var(--border-width-thick) solid var(--accent-primary);
    outline-offset: var(--space-xs);
  }
</style>
