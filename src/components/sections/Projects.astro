---
// Projects section — catalog list of project rows (Log design language).
import { fetchProjects } from '@lib/astraeus';
import ProjectRow from '@components/work/ProjectRow.astro';

export interface Props {
  featuredOnly?: boolean;
  limit?: number;
}

const { featuredOnly = true, limit } = Astro.props;

// fetchProjects returns published projects sorted by number.
const allProjects = await fetchProjects();
let projects = featuredOnly ? allProjects.filter((project) => project.featured) : allProjects;

if (limit && limit > 0) {
  projects = projects.slice(0, limit);
}
---

{projects.length > 0 ? (
  <div class="project-list">
    {projects.map((project, index) => (
      <ProjectRow project={project} number={index + 1} eager={index === 0} />
    ))}
  </div>
) : (
  <p class="section-empty">No projects found.</p>
)}
