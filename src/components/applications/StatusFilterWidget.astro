---
/**
 * StatusFilterWidget - Sidebar widget for status filtering
 *
 * Displays status quicklinks with counts for filtering applications.
 * Shows all statuses (even empty ones) and highlights the current status.
 */

import Card from '@components/primitives/Card.astro';
import { APPLICATION_STATUSES, STATUS_LABELS } from '@utils/applicationStatus';

export interface Props {
  statusCounts: Map<string, number>;
  totalCount: number;
  currentStatus?: string;
  class?: string;
}

const {
  statusCounts,
  totalCount,
  currentStatus,
  class: className = '',
} = Astro.props;
---

<Card variant="outlined" padding="lg" class={`status-filter-widget ${className}`}>
  <h3 class="widget-title">Filter by Status</h3>

  <ul class="status-list">
    <li class="status-item">
      <a
        href="/applications"
        class:list={['status-link', { 'is-active': !currentStatus }]}
        aria-current={!currentStatus ? 'page' : undefined}
      >
        <span class="status-label">All Applications</span>
        <span class="status-count">{totalCount}</span>
      </a>
    </li>

    {APPLICATION_STATUSES.map((key) => {
      const count = statusCounts.get(key) || 0;
      const isActive = currentStatus === key;
      const label = STATUS_LABELS[key];

      return (
        <li class="status-item">
          <a
            href={`/applications/status/${key}`}
            class:list={['status-link', `status-${key}`, { 'is-active': isActive, 'is-empty': count === 0 }]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class="status-label">{label}</span>
            <span class="status-count">{count}</span>
          </a>
        </li>
      );
    })}
  </ul>
</Card>

<style>
  .widget-title {
    margin: 0 0 var(--space-md) 0;
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    line-height: var(--leading-tight);
  }

  .status-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .status-item {
    margin: 0;
  }

  .status-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-primary);
    background: transparent;
    border: var(--border-width) solid transparent;
    transition: all var(--duration-base) var(--ease-out);
  }

  .status-link:hover {
    background: var(--bg-secondary);
    border-color: var(--accent-primary);
  }

  .status-link.is-active {
    background: var(--accent-primary);
    color: var(--text-light);
    border-color: var(--accent-primary);
  }

  .status-link.is-active:hover {
    background: var(--accent-primary);
  }

  /* Empty status styling - more subtle */
  .status-link.is-empty {
    opacity: 0.5;
  }

  .status-link.is-empty:hover {
    opacity: 1;
  }

  .status-label {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .status-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 var(--space-xs);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border: var(--border-width) solid var(--gradient-primary-subtle);
    transition: all var(--duration-base) var(--ease-out);
  }

  .status-link:hover .status-count {
    background: var(--accent-secondary);
    color: var(--bg-dark);
    border-color: var(--accent-primary);
  }

  .status-link.is-active .status-count {
    background: var(--text-light);
    color: var(--accent-primary);
    border-color: transparent;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .status-filter-widget {
      /* Full width when sidebar stacks */
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .status-link,
    .status-count {
      transition: none;
    }
  }
</style>
